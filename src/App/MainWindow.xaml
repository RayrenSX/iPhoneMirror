                            <Grid>
                                <TextBlock Text="{DynamicResource CurrentDevice}" Style="{StaticResource ControlSectionTitle}"/>
                                <TextBlock Text="{Binding SelectedConnection}" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource MutedTextBrush}" FontSize="10"/>
                            </Grid>
                            <TextBlock Text="{Binding SelectedName}" FontSize="15" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Margin="0,9,0,0"/>
                            <TextBlock Text="{Binding SelectedModel}" Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="11" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding SelectedOs}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding SelectedUdid}" FontFamily="Consolas" FontSize="9"
                                       AutomationProperties.AutomationId="SelectedDeviceUdidText"
                                       Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"
                                       Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="3" Height="1" Background="{DynamicResource BorderSoftBrush}"
                            VerticalAlignment="Center" Margin="2,0"/>
                    <ListBox x:Name="DeviceListBox" Grid.Row="4" ItemsSource="{Binding Devices}"
                             AutomationProperties.AutomationId="DeviceListBox"
                             SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="OnDeviceListLeftButtonDown"
                             PreviewMouseMove="OnDeviceListMouseMove"
                             PreviewMouseLeftButtonUp="OnDeviceListLeftButtonUp"
                             PreviewMouseRightButtonDown="OnDeviceListRightButtonDown"
                             DragOver="OnDeviceListDragOver"
                             Drop="OnDeviceListDrop">
                        <ListBox.Resources>
                            <Style TargetType="ContextMenu">
                                <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Padding" Value="5"/>
                                <Setter Property="HasDropShadow" Value="True"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ContextMenu">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style TargetType="MenuItem">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="FontFamily" Value="Segoe UI"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Padding" Value="14,9"/>
                                <Setter Property="MinWidth" Value="150"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Border x:Name="MenuRoot" Background="{TemplateBinding Background}"
                                                    CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter ContentSource="Header"
                                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Setter TargetName="MenuRoot" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <ContextMenu x:Key="DeviceContextMenu" Placement="MousePoint">
                                <MenuItem Header="{DynamicResource MirrorSimultaneously}"
                                          Click="OnMirrorSimultaneouslyClick"/>
                            </ContextMenu>
                        </ListBox.Resources>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem"
