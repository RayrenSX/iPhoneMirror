                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Screenshot20" FontSize="15"/>
                                <TextBlock Text="{DynamicResource Screenshot}" Margin="9,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OnRefreshPreviewClick" IsEnabled="{Binding CanUseVisualPreviewTools}"
                                Style="{StaticResource ToolButton}"
                                Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="ArrowClockwise20" FontSize="15"/>
                                <TextBlock Text="{DynamicResource RefreshFrame}" Margin="9,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OnFullScreenClick" IsEnabled="{Binding CanUseVisualPreviewTools}"
                                Style="{StaticResource ToolButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="FullScreenMaximize20" FontSize="15"/>
                                <TextBlock Text="{DynamicResource FullScreenPreview}" Margin="9,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
