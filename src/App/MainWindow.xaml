                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDevice}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Width="84" Height="126" CornerRadius="12" BorderThickness="2"
                                        BorderBrush="{DynamicResource PreviewBorderBrush}" HorizontalAlignment="Center">
                                    <Grid>
                                        <Border Width="30" Height="4" CornerRadius="2"
                                                Background="{DynamicResource PreviewBorderBrush}"
                                                VerticalAlignment="Top" Margin="0,8,0,0"/>
                                        <TextBlock Text="{Binding SelectedConnection}"
                                                   Foreground="{DynamicResource PreviewMutedTextBrush}"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding SelectedName}" Foreground="{DynamicResource PreviewTextBrush}"
                                           FontSize="20" FontWeight="SemiBold"
                                           TextAlignment="Center" Margin="0,20,0,0"/>
                                <TextBlock Text="{Binding CaptureStatus}" Foreground="{DynamicResource PreviewMutedTextBrush}"
                                           FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                        <controls:NativePreviewHost x:Name="MainPreviewHost">
                            <controls:NativePreviewHost.Style>
                                <Style TargetType="{x:Type controls:NativePreviewHost}">
                                    <!-- HwndHost airspace cannot be painted over by WPF. Remove it
                                         from idle layout entirely instead of shrinking it through an
                                         intermediate native surface that DWM can expose for a frame. -->
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsCapturing}" Value="True"/>
                                                <Condition Binding="{Binding IsAudioOnlyAirPlay}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:NativePreviewHost.Style>
                        </controls:NativePreviewHost>
                        <Grid x:Name="AirPlayMusicSurface"
                              AutomationProperties.AutomationId="AirPlayMusicSurface"
                              Background="{DynamicResource PreviewChromeBrush}"
                              Panel.ZIndex="1" IsHitTestVisible="False">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAudioOnlyAirPlay}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        MaxWidth="460">
                                <Border Width="96" Height="96" CornerRadius="48"
                                        Background="{DynamicResource PreviewPanelAltBrush}"
                                        BorderBrush="{DynamicResource PreviewBorderBrush}"
                                        BorderThickness="1" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="MusicNote220"
                                                   Foreground="{DynamicResource PreviewTextBrush}"
                                                   FontSize="38" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource WirelessMusicTitle}"
                                           Foreground="{DynamicResource PreviewTextBrush}"
                                           FontSize="21" FontWeight="SemiBold" TextAlignment="Center"
                                           Margin="0,20,0,0"/>
                                <TextBlock Text="{Binding SelectedName}"
                                           Foreground="{DynamicResource PreviewTextBrush}"
                                           FontSize="14" TextAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding CaptureStatus}"
                                           Foreground="{DynamicResource PreviewMutedTextBrush}"
                                           FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="MediaCastSurface" Visibility="Collapsed"
                              AutomationProperties.AutomationId="MediaCastSurface"
                              Background="{DynamicResource PreviewChromeBrush}" Panel.ZIndex="2">
                            <Grid x:Name="MediaCastPlayerHost"
                                  Background="{DynamicResource PreviewChromeBrush}"
                                  ClipToBounds="True"
                                  MouseEnter="OnMediaCastPlayerMouseEnter"
                                  MouseMove="OnMediaCastPlayerMouseMove"
                                  MouseLeave="OnMediaCastPlayerMouseLeave"
                                  SizeChanged="OnMediaCastPlayerSizeChanged">
                                <Grid x:Name="MediaCastVideoHost"
                                      Background="{DynamicResource PreviewChromeBrush}">
                                    <MediaElement x:Name="MediaCastMediaElement"
                                                  LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                                  Stretch="Uniform" ScrubbingEnabled="True"/>
                                </Grid>

                                <Border x:Name="MediaCastStatusPanel"
                                        Visibility="Collapsed" Panel.ZIndex="3"
                                        AutomationProperties.AutomationId="MediaCastStatusPanel"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="{DynamicResource MediaOverlayBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="12" Padding="22,15" Margin="20,20,20,76">
                                    <StackPanel>
                                        <ProgressBar IsIndeterminate="True" Height="3" MinWidth="180"
                                                     Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock x:Name="MediaCastStatusText"
                                                   Text="{DynamicResource MediaCastWaitingVideo}"
                                                   Foreground="{DynamicResource MediaOverlayTextBrush}"
                                                   FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                                                   MaxWidth="560" Margin="0,11,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="MediaCastControlsPanel" Panel.ZIndex="4"
                                        VerticalAlignment="Bottom"
                                        Background="{DynamicResource MediaPlayerScrimBrush}"
                                        Padding="18,32,18,14" Opacity="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="48"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="MediaCastCurrentTimeText" Text="00:00"
                                                       Style="{StaticResource MediaPlayerTimeTextStyle}"
                                                       HorizontalAlignment="Left"/>
                                            <Slider x:Name="MediaCastSeekSlider" Grid.Column="1"
                                                    Style="{StaticResource MediaPlayerSliderStyle}"
                                                    Margin="8,0"
                                                    Minimum="0" Maximum="1" Value="0"
                                                    IsEnabled="False" IsMoveToPointEnabled="False"
                                                    ValueChanged="OnMediaCastSeekValueChanged"
                                                    AutomationProperties.AutomationId="MediaCastSeekSlider"
                                                    ToolTip="{DynamicResource MediaCastSeek}"/>
                                            <TextBlock x:Name="MediaCastDurationText" Grid.Column="2" Text="--:--"
                                                       Style="{StaticResource MediaPlayerTimeTextStyle}"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button x:Name="MediaCastSeekBackwardButton"
                                                        Style="{StaticResource MediaPlayerIconButtonStyle}"
                                                        Click="OnMediaCastSeekBackwardClick"
                                                        ToolTip="{DynamicResource MediaCastSeekBackward}"
                                                        AutomationProperties.AutomationId="MediaCastSeekBackwardButton">
                                                    <TextBlock Text="−10" FontFamily="Segoe UI Variable Text, Segoe UI"
                                                               FontSize="11" FontWeight="SemiBold"/>
                                                </Button>
                                                <Button x:Name="MediaCastPlayPauseButton"
                                                        Style="{StaticResource MediaPlayerPrimaryButtonStyle}"
                                                        Click="OnMediaCastPlayPauseClick"
                                                        ToolTip="{DynamicResource MediaCastPause}"
                                                        AutomationProperties.AutomationId="MediaCastPlayPauseButton">
                                                    <ui:SymbolIcon x:Name="MediaCastPlayPauseIcon"
                                                                   Symbol="Pause20"
                                                                   Foreground="{DynamicResource MediaPlayerPrimaryIconBrush}"
                                                                   FontSize="18"
                                                                   RenderTransformOrigin="0.5,0.5">
                                                        <ui:SymbolIcon.RenderTransform><ScaleTransform/></ui:SymbolIcon.RenderTransform>
                                                    </ui:SymbolIcon>
                                                </Button>
                                                <Button x:Name="MediaCastSeekForwardButton"
                                                        Style="{StaticResource MediaPlayerIconButtonStyle}"
                                                        Click="OnMediaCastSeekForwardClick"
                                                        ToolTip="{DynamicResource MediaCastSeekForward}"
                                                        AutomationProperties.AutomationId="MediaCastSeekForwardButton">
                                                    <TextBlock Text="+10" FontFamily="Segoe UI Variable Text, Segoe UI"
                                                               FontSize="11" FontWeight="SemiBold"/>
                                                </Button>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <ComboBox x:Name="MediaCastSpeedComboBox"
                                                          Width="66" Height="30" Margin="0,0,6,0"
                                                          Padding="6,0"
                                                          VerticalContentAlignment="Center"
                                                          SelectedIndex="2"
                                                          SelectionChanged="OnMediaCastSpeedSelectionChanged"
                                                          ToolTip="{DynamicResource PlaybackSpeed}"
                                                          AutomationProperties.AutomationId="MediaCastSpeedComboBox">
                                                    <ComboBoxItem Tag="0.5" Content="0.5x"/>
                                                    <ComboBoxItem Tag="0.75" Content="0.75x"/>
                                                    <ComboBoxItem Tag="1" Content="1x"/>
                                                    <ComboBoxItem Tag="1.25" Content="1.25x"/>
                                                    <ComboBoxItem Tag="1.5" Content="1.5x"/>
                                                    <ComboBoxItem Tag="2" Content="2x"/>
                                                </ComboBox>
                                                <Button x:Name="MediaCastMuteButton"
                                                        Style="{StaticResource MediaPlayerIconButtonStyle}"
                                                        Click="OnMediaCastMuteClick"
                                                        ToolTip="{DynamicResource MediaCastMute}"
                                                        AutomationProperties.AutomationId="MediaCastMuteButton">
                                                    <ui:SymbolIcon x:Name="MediaCastVolumeIcon"
                                                                   Symbol="Speaker220"
                                                                   Foreground="{DynamicResource MediaOverlayTextBrush}"
                                                                   FontSize="15"/>
                                                </Button>
                                                <Slider x:Name="MediaCastVolumeSlider"
                                                        Style="{StaticResource MediaPlayerSliderStyle}"
                                                        Width="82" Margin="6,0,7,0"
                                                        Minimum="0" Maximum="100" Value="100"
                                                        VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                                        ValueChanged="OnMediaCastVolumeValueChanged"
                                                        AutomationProperties.AutomationId="MediaCastVolumeSlider"
                                                        ToolTip="{DynamicResource PlaybackVolume}"/>
                                                <Button x:Name="MediaCastFullScreenButton"
                                                        Style="{StaticResource MediaPlayerIconButtonStyle}"
                                                        Click="OnFullScreenClick"
                                                        ToolTip="{DynamicResource FullScreenPreview}"
                                                        AutomationProperties.AutomationId="MediaCastFullScreenButton">
                                                    <ui:SymbolIcon x:Name="MediaCastFullScreenIcon"
                                                                   Symbol="FullScreenMaximize20"
                                                                   Foreground="{DynamicResource MediaOverlayTextBrush}"
                                                                   FontSize="16"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="StatsPanel" Grid.Row="3" Style="{StaticResource WorkspaceCardBorder}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="13,10"
                              Visibility="{Binding MediaOutputStatusVisibility}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource StatusPendingBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MediaOutputTone}" Value="Applied">
                                                <Setter Property="Fill" Value="{DynamicResource StatusAppliedBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MediaOutputTone}" Value="Failed">
                                                <Setter Property="Fill" Value="{DynamicResource StatusFailedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Grid.Column="2" Text="{Binding MediaOutputStatus}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="11" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="MediaOutputStatusText"/>
                        </Grid>
                        <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderSoftBrush}"
                                Visibility="{Binding MediaOutputStatusVisibility}"/>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="13">
                            <TextBlock Text="{DynamicResource ResolutionLabel}" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding Resolution}" Style="{StaticResource StatValue}"
                                       AutomationProperties.AutomationId="ResolutionValue"/>
                            <TextBlock Text="{Binding TargetResolutionDisplay}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource BorderSoftBrush}" Margin="0,10"/>
                        <StackPanel Grid.Column="2" Margin="13">
                            <TextBlock Text="{DynamicResource FrameRateLabel}" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding FpsDisplay}" Style="{StaticResource StatValue}"
                                       AutomationProperties.AutomationId="FrameRateValue"/>
                            <TextBlock Text="{Binding TargetFpsDisplay}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10"/>
                        </StackPanel>
                        <Border Grid.Column="3" Background="{DynamicResource BorderSoftBrush}" Margin="0,10"/>
                        <StackPanel Grid.Column="4" Margin="13">
                            <TextBlock Text="{DynamicResource LatencyLabel}" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding LatencyDisplay}" Style="{StaticResource StatValue}"
                                       AutomationProperties.AutomationId="LatencyValue"/>
                            <TextBlock Text="{DynamicResource EndToEndLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10"/>
                        </StackPanel>
                        <Border Grid.Column="5" Background="{DynamicResource BorderSoftBrush}" Margin="0,10"/>
                        <StackPanel Grid.Column="6" Margin="13">
                            <TextBlock Text="{DynamicResource AudioLabel}" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding AudioDisplay}" Style="{StaticResource StatValue}"
                                       AutomationProperties.AutomationId="AudioValue"/>
                            <TextBlock Text="{Binding AudioDetailDisplay}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10"/>
                        </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

            </Grid>

            <Border x:Name="ControlPanel" Grid.Column="4" Width="0"
                    Style="{StaticResource WorkspaceCardBorder}"
                    Padding="16,16,1,16" Visibility="Collapsed">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              PanningMode="VerticalOnly">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar"
                               BasedOn="{StaticResource ContentEdgeScrollBarStyle}"/>
                    </ScrollViewer.Resources>
                    <StackPanel Margin="0,0,10,0">
                        <Grid>
                            <TextBlock Text="{DynamicResource ControlTitle}" FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Button Style="{StaticResource WorkspaceIconButton}"
                                    Width="32" Height="32" MinHeight="32" Margin="0" Padding="0"
                                    HorizontalAlignment="Right"
                                    Click="OnCloseSettingsPanelClick" ToolTip="{DynamicResource Close}"
                                    AutomationProperties.AutomationId="CloseSettingsPanelButton">
                                <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="16"/>
                            </Button>
                        </Grid>

                        <Border Style="{StaticResource ControlSectionCard}"
                                Visibility="{Binding WirelessTopSettingsVisibility}">
                            <StackPanel>
                                <Grid><TextBlock Text="{DynamicResource WirelessReceiverTitle}" Style="{StaticResource ControlSectionTitle}"/><TextBlock Text="{DynamicResource WirelessServiceAlwaysOn}" HorizontalAlignment="Right" Foreground="{DynamicResource SuccessBrush}" FontSize="10"/></Grid>
                                <TextBlock Text="{DynamicResource WirelessResolutionLabel}" Style="{StaticResource DetailLabel}" Margin="0,10,0,5"/>
                                <ComboBox ItemsSource="{Binding WirelessDisplayProfiles}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedWirelessDisplayProfile, Mode=TwoWay}"/>
                                <TextBlock Text="{DynamicResource WirelessResolutionHelp}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding WirelessReceiverName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RoundedTextBox}" MaxLength="63" Height="36" ToolTip="{DynamicResource WirelessReceiverNameLabel}"/><Button Grid.Column="2" Content="{DynamicResource ApplyWirelessSettings}" Command="{Binding ApplyWirelessSettingsCommand}" Style="{StaticResource ToolButton}" MinWidth="64"/></Grid>
                                <TextBlock Text="{Binding WirelessStatus}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="1,8,0,0"/>
                                <TextBlock Text="{Binding AppliedWirelessProfileDisplay}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" TextWrapping="Wrap" Margin="1,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ControlSectionCard}"
                                Visibility="{Binding UsbProjectionSettingsVisibility}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource UsbProjectionModeTitle}"
                                           Style="{StaticResource ControlSectionTitle}"/>
                                <Border Background="{DynamicResource ControlFillBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="12"
                                        Padding="2" Margin="0,9,0,0">
                                    <ListBox ItemsSource="{Binding UsbProjectionModes}"
                                             SelectedItem="{Binding SelectedUsbProjectionMode, Mode=TwoWay}"
                                             IsEnabled="{Binding CanChangeUsbProjectionMode}"
                                             ItemContainerStyle="{StaticResource UsbModeTabItem}"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" Columns="3"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <TextBlock Text="{Binding Label}" FontSize="9"
                                                               FontWeight="SemiBold" TextWrapping="Wrap"
                                                               TextAlignment="Center" VerticalAlignment="Center"
                                                               Margin="0,0,20,0"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                    <Button Style="{StaticResource UsbModeInfoButton}"
                                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                                            Click="OnUsbProjectionModeInfoClick"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                                <TextBlock Text="{DynamicResource UsbProjectionPerDeviceHint}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="9" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ControlSectionCard}" Visibility="Collapsed">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{DynamicResource CurrentDevice}" Style="{StaticResource ControlSectionTitle}"/>
                                    <TextBlock Text="{Binding SelectedConnection}"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="10"/>
                                </Grid>
                                <TextBlock Text="{Binding SelectedName}" FontSize="15" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Margin="0,11,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding SelectedModel}" FontSize="11"/>
                                    <TextBlock Text="  ·  " Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedOs}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
                                </StackPanel>
                                <TextBlock Text="UDID" Style="{StaticResource DetailLabel}" Margin="0,9,0,3"/>
                                <TextBlock Text="{Binding SelectedUdid}" FontFamily="Consolas" FontSize="9"
                                           AutomationProperties.AutomationId="SelectedDeviceUdidText"
                                           Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border>
                            <Border.Style>
                                <Style TargetType="Border"
                                       BasedOn="{StaticResource ControlSectionCard}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCaptureSession}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMediaCasting}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ImageAndSound}" Style="{StaticResource ControlSectionTitle}"/>
                                <StackPanel Visibility="{Binding VideoSettingsVisibility}">
                                    <TextBlock Text="{DynamicResource RenderLimitHelp}"
                                               Foreground="{DynamicResource MutedTextBrush}" FontSize="9"
                                               TextWrapping="Wrap" Margin="0,4,0,1"
                                               Visibility="{Binding WiredVideoLimitSettingsVisibility}"/>

                                    <StackPanel Visibility="{Binding WiredVideoLimitSettingsVisibility}">
                                        <TextBlock Text="{DynamicResource RenderResolutionLimit}" Style="{StaticResource DetailLabel}" Margin="0,10,0,5"/>
                                        <ComboBox x:Name="ResolutionComboBox"
                                                  ItemsSource="{Binding ResolutionPresets}"
                                                  DisplayMemberPath="Label"
                                                  IsEnabled="{Binding CanChangeVideoPipeline}"
                                                  SelectedItem="{Binding SelectedResolutionPreset, Mode=TwoWay}"/>

                                        <TextBlock Text="{DynamicResource TargetFrameRate}" Style="{StaticResource DetailLabel}" Margin="0,10,0,5"/>
                                        <ComboBox x:Name="FrameRateComboBox"
                                                  ItemsSource="{Binding FrameRates}"
                                                  IsEnabled="{Binding CanChangeVideoPipeline}"
                                                  SelectedItem="{Binding SelectedFrameRate, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <TextBlock Text="{DynamicResource DecoderPreferenceLabel}"
                                               Style="{StaticResource DetailLabel}" Margin="0,10,0,5"/>
                                    <ComboBox ItemsSource="{Binding DecoderPreferences}"
                                              DisplayMemberPath="Label"
                                              IsEnabled="{Binding CanChangeDecoderPipeline}"
                                              SelectedItem="{Binding SelectedDecoderPreference, Mode=TwoWay}"/>

                                    <TextBlock Text="{DynamicResource VideoPipelinePreferenceHelp}"
                                               Foreground="{DynamicResource MutedTextBrush}" FontSize="9"
                                               TextWrapping="Wrap" Margin="0,6,0,0"/>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="ApplyVideoSettingsButton"
                                                Content="{DynamicResource ApplyVideoSettings}"
                                                Command="{Binding ApplyVideoSettingsCommand}"
                                                Style="{StaticResource ToolButton}"/>
                                        <Button Grid.Column="2"
                                                Content="{DynamicResource MoreImageSettingsButton}"
                                                Command="{Binding MoreImageSettingsCommand}"
                                                Style="{StaticResource ToolButton}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding SettingsStatus}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="9" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="0,12,0,11"/>
                                <CheckBox x:Name="AudioPlaybackCheckBox"
                                          Content="{DynamicResource PlayAudioWindows}"
                                          IsChecked="{Binding PlayAudio, Mode=TwoWay}"/>
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource PlaybackVolume}" Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding PlaybackVolume, StringFormat={}{0:F0}%}"
                                               Width="42" TextAlignment="Right"
                                               Foreground="{DynamicResource AccentHoverBrush}"
                                               FontSize="10" FontWeight="SemiBold"/>
                                </Grid>
                                <Slider x:Name="VolumeSlider"
                                        Minimum="0" Maximum="100"
                                        Value="{Binding PlaybackVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,4,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ControlSectionCard}"
                                Visibility="{Binding WirelessBottomSettingsVisibility}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{DynamicResource WirelessReceiverTitle}"
                                               Style="{StaticResource ControlSectionTitle}"/>
                                    <TextBlock Text="{DynamicResource WirelessServiceAlwaysOn}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SuccessBrush}" FontSize="10"/>
                                </Grid>
                                <TextBlock Text="{DynamicResource WirelessResolutionLabel}"
                                           Style="{StaticResource DetailLabel}" Margin="0,10,0,5"/>
                                <ComboBox ItemsSource="{Binding WirelessDisplayProfiles}"
                                          DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedWirelessDisplayProfile, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="WirelessResolutionComboBox"/>
                                <TextBlock Text="{DynamicResource WirelessResolutionHelp}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="9" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding WirelessReceiverName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource RoundedTextBox}"
                                             MaxLength="63" Height="36"
                                             ToolTip="{DynamicResource WirelessReceiverNameLabel}"/>
                                    <Button Grid.Column="2" Content="{DynamicResource ApplyWirelessSettings}"
                                            Command="{Binding ApplyWirelessSettingsCommand}"
                                            Style="{StaticResource ToolButton}" MinWidth="64"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="1,8,0,0">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}"
                                             VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding WirelessStatus}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="10" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Text="{Binding AppliedWirelessProfileDisplay}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="9" TextWrapping="Wrap" Margin="1,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ControlSectionCard}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{DynamicResource MediaCastTitle}"
                                               Style="{StaticResource ControlSectionTitle}"/>
                                    <TextBlock Text="{DynamicResource WirelessServiceAlwaysOn}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SuccessBrush}" FontSize="10"/>
                                </Grid>
                                <TextBlock Text="{DynamicResource MediaCastDescription}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding MediaCastReceiverName}"
                                           FontSize="13" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="1,7,0,0">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}"
                                             VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding MediaCastStatus}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="10" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="AdvancedSettingsCard"
                                Style="{StaticResource ControlSectionCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource AppPreferencesTitle}"
                                           Style="{StaticResource ControlSectionTitle}"/>
                                <TextBlock Text="{DynamicResource LanguageToolTip}"
                                           Style="{StaticResource DetailLabel}" Margin="0,10,0,5"/>
                                <ComboBox x:Name="LanguageComboBox" Height="36"
                                          AutomationProperties.AutomationId="LanguageComboBox"
                                          SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                                          SelectedValuePath="Tag"
                                          ToolTip="{DynamicResource LanguageToolTip}">
                                    <ComboBoxItem Tag="system" Content="{DynamicResource LanguageSystem}"/>
                                    <ComboBoxItem Tag="zh-CN" Content="{DynamicResource LanguageChinese}"/>
                                    <ComboBoxItem Tag="zh-HK" Content="{DynamicResource LanguageTraditionalChineseHongKong}"/>
                                    <ComboBoxItem Tag="en-US" Content="{DynamicResource LanguageEnglish}"/>
                                </ComboBox>
                                <TextBlock Text="{DynamicResource ThemeTitle}"
                                           Style="{StaticResource DetailLabel}" Margin="0,10,0,5"/>
                                <ComboBox x:Name="ThemeComboBox" Height="36"
                                          AutomationProperties.AutomationId="ThemeComboBox"
                                          SelectedValuePath="Tag"
                                          SelectionChanged="OnThemeSelectionChanged">
                                    <ComboBoxItem Tag="System" Content="{DynamicResource ThemeSystem}"/>
                                    <ComboBoxItem Tag="Dark" Content="{DynamicResource ThemeDark}"/>
                                    <ComboBoxItem Tag="Light" Content="{DynamicResource ThemeLight}"/>
                                </ComboBox>
                                <Button Content="{DynamicResource AdvancedSettings}"
                                        Command="{Binding AdvancedSettingsCommand}"
                                        Style="{StaticResource ToolButton}"
                                        Margin="0,10,0,0"
                                        Visibility="{Binding AdvancedSettingsVisibility}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid x:Name="FooterPanel" Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="{DynamicResource FooterConnectivity}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10"/>
            <Button x:Name="VersionButton"
                    Content="{Binding VersionText, RelativeSource={RelativeSource AncestorType=Window}}"
                    Foreground="{DynamicResource MutedTextBrush}" Background="Transparent"
                    BorderBrush="Transparent" BorderThickness="0" Padding="0"
                    Height="22" MinHeight="22" MinWidth="150" FontSize="10" FontWeight="Normal"
                    HorizontalAlignment="Right" Cursor="Hand" FocusVisualStyle="{x:Null}"
                    Focusable="True" IsTabStop="True" IsHitTestVisible="True"
                    AutomationProperties.AutomationId="VersionButton"
                    AutomationProperties.Name="{Binding VersionText, RelativeSource={RelativeSource AncestorType=Window}}"
                    Click="OnVersionClick"/>
        </Grid>

        <Popup x:Name="PreviewTransitionMask"
               PlacementTarget="{Binding ElementName=PreviewPanel}"
               Placement="Center"
               AllowsTransparency="True"
               StaysOpen="True"
               Focusable="False"
               IsHitTestVisible="False">
            <Grid Width="{Binding ActualWidth, ElementName=PreviewPanel}"
                  Height="{Binding ActualHeight, ElementName=PreviewPanel}"
                  Background="Transparent"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True">
                <Border Margin="1,0,1,2"
                        Background="{DynamicResource PreviewChromeBrush}"
                        CornerRadius="7"
                        SnapsToDevicePixels="True"/>
            </Grid>
        </Popup>
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
