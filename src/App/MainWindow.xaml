                            <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="16"/>
                        </Button>
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource ControlSectionCard}" Margin="0" Padding="12">
