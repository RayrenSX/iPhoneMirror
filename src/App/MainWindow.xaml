                                <StackPanel Orientation="Horizontal">
                                     <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="VideoRecording20" FontSize="16"/>
                                    <TextBlock Text="{DynamicResource MediaOutputButton}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding MoreImageSettingsCommand}"
