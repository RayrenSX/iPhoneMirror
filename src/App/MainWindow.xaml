<ui:FluentWindow x:Class="IPhoneMirror.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:IPhoneMirror.App.Controls"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="{DynamicResource WindowTitleConnectivity}"
        Icon="pack://application:,,,/Assets/iPhoneMirror.ico"
        Width="1540" Height="900" MinWidth="1280" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        PreviewKeyDown="OnPreviewKeyDown">
    <ui:FluentWindow.Resources>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding Udid}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="{DynamicResource WorkspaceItemBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="14">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource WorkspaceCardHoverBrush}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ComboBorderHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource WorkspaceItemSelectedBorderBrush}"/>
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource WorkspaceItemSelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,13,0,3"/>
        </Style>
        <Style x:Key="ControlSectionCard" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0,14,0,0"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
        </Style>
        <Style x:Key="ControlSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource ControlFillBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="8,7"/>
        </Style>
        <Style x:Key="WorkspaceIconButton" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RailRoot" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RailRoot" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RailRoot" Property="Background" Value="{DynamicResource ControlPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RailRoot" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ShellNavigationItem"
               TargetType="{x:Type ui:NavigationViewItem}"
               BasedOn="{StaticResource {x:Type ui:NavigationViewItem}}">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{DynamicResource NavigationTextFontFamily}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ui:NavigationViewItem}">
                        <Grid x:Name="NavigationItemRoot"
                              Height="{TemplateBinding MinHeight}"
                              Background="Transparent"
                              SnapsToDevicePixels="True">
                            <Border x:Name="InteractionBackground"
                                    Margin="4,0"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="7"/>
                            <Border x:Name="ActiveIndicator"
                                    Width="3" Height="18"
                                    Margin="4,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="2"
                                    Opacity="0"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="NavigationIcon"
                                                  Content="{TemplateBinding Icon}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                <TextBlock x:Name="PaneItemText"
                                           Grid.Column="1"
                                           Margin="8,0,12,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           Foreground="{TemplateBinding Foreground}"
                                           Text="{TemplateBinding Content}"
                                           TextOptions.TextFormattingMode="Display"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InteractionBackground"
                                        Property="Background"
                                        Value="{DynamicResource ControlHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="InteractionBackground"
                                        Property="Background"
                                        Value="{DynamicResource ControlPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsActive" Value="True">
                                <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1"/>
                                <Setter TargetName="PaneItemText" Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsActive" Value="True"/>
                                    <Condition Property="IsPaneOpen" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="InteractionBackground"
                                        Property="Background"
                                        Value="{DynamicResource ControlFillBrush}"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsActive" Value="True"/>
                                    <Condition Property="IsPaneOpen" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="InteractionBackground"
                                        Property="Background"
                                        Value="Transparent"/>
                            </MultiTrigger>
                            <Trigger Property="IsPaneOpen" Value="False">
                                <Setter TargetName="PaneItemText" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InteractionBackground"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="NavigationItemRoot" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PreviewToolButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="UsbModeTabItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="7,6"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="TabRoot" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="TabRoot" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="UsbModeInfoButton" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="MinHeight" Value="18"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ControlFillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="InfoRoot" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <TextBlock Text="!" Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InfoRoot" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="InfoRoot" Property="Background" Value="{DynamicResource ControlPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptureActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="132"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Background" Value="{DynamicResource CaptureStartBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CaptureStartBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource CaptureActionTextBrush}"/>
            <Setter Property="Content" Value="{DynamicResource StartMirroring}"/>
            <Setter Property="Command" Value="{Binding StartCommand}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <TextBlock Text="{TemplateBinding Content}"
                                        Foreground="{TemplateBinding Foreground}"
                                        HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionRoot" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionRoot" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ActionRoot" Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}"/>
                                <Setter TargetName="ActionRoot" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionRoot" Property="Opacity" Value="0.34"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasCaptureSession}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CaptureStopBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource CaptureStopBorderBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource CaptureActionTextBrush}"/>
                    <Setter Property="Content" Value="{DynamicResource StopMirroring}"/>
                    <Setter Property="Command" Value="{Binding StopCommand}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMediaCasting}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CaptureStopBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource CaptureStopBorderBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource CaptureActionTextBrush}"/>
                    <Setter Property="Content" Value="{DynamicResource StopMirroring}"/>
                    <Setter Property="Command" Value="{Binding MediaCastStopCommand}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid x:Name="AppShell">
        <ui:NavigationView x:Name="RootNavigation"
                           PaneDisplayMode="LeftMinimal"
                           IsPaneOpen="False"
                           IsPaneVisible="True"
                           IsPaneToggleVisible="True"
                           IsBackButtonVisible="Collapsed"
                           IsTopSeparatorVisible="False"
                           IsFooterSeparatorVisible="True"
                           CompactPaneLength="48"
                           OpenPaneLength="208"
                           FrameMargin="0"
                           Padding="0"
                           Background="Transparent"
                           AutomationProperties.AutomationId="RootNavigation">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="MirroringPanelToggle"
                                       Style="{StaticResource ShellNavigationItem}"
                                       Content="{DynamicResource NavMirroring}"
                                       Click="OnNavigateMirroringClick"
                                       ToolTip="{DynamicResource NavMirroringDescription}"
                                       AutomationProperties.AutomationId="MirroringNavButton">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7F4;" FontSize="18"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="DevicePanelToggle"
                                       Style="{StaticResource ShellNavigationItem}"
                                       Content="{DynamicResource NavDevices}"
                                       Click="OnNavigateDevicesClick"
                                       ToolTip="{DynamicResource NavDevicesDescription}"
                                       AutomationProperties.AutomationId="DevicePanelToggle">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8EA;" FontSize="18"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="SettingsPanelToggle"
                                       Style="{StaticResource ShellNavigationItem}"
                                       Content="{DynamicResource NavSettings}"
                                       Click="OnNavigateSettingsClick"
                                       ToolTip="{DynamicResource NavSettingsDescription}"
                                       AutomationProperties.AutomationId="SettingsPanelToggle">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="18"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItemSeparator/>
                <ui:NavigationViewItem Style="{StaticResource ShellNavigationItem}"
                                       Content="{DynamicResource NavOutput}"
                                       Click="OnNavigateOutputClick"
                                       ToolTip="{DynamicResource NavOutputDescription}"
                                       AutomationProperties.AutomationId="OutputNavButton">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE714;" FontSize="18"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="DriverManagerButton"
                                       Style="{StaticResource ShellNavigationItem}"
                                       Content="{DynamicResource NavDriver}"
                                       Click="OnNavigateDriverClick"
                                       ToolTip="{DynamicResource NavDriverDescription}"
                                       AutomationProperties.AutomationId="DriverManagerButton">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE90F;" FontSize="18"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem x:Name="AboutButton"
                                       Style="{StaticResource ShellNavigationItem}"
                                       Content="{DynamicResource NavAbout}"
                                       Click="OnNavigateAboutClick"
                                       ToolTip="{DynamicResource NavAboutDescription}"
                                       AutomationProperties.AutomationId="AboutButton">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="18"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
            <ui:NavigationView.ContentOverlay>
                <Grid x:Name="RootLayout" Margin="12,18,18,18"
                      animations:PageTransition.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="HeaderGapRow" Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderPanel" Grid.Row="0"
              MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="iPhoneMirror" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource AppSubtitleConnectivity}" Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Padding="0" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0" MaxWidth="360">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource WarningBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding DriverState}" FontSize="12" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <Button x:Name="CaptureActionButton" Grid.Column="3"
                    AutomationProperties.AutomationId="CaptureActionButton"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Style="{StaticResource CaptureActionButton}"
                    VerticalAlignment="Center"/>
            <StackPanel Grid.Column="5" Orientation="Horizontal"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource TitleBarButton}"
                        AutomationProperties.Name="{DynamicResource Minimize}"
                        Click="OnMinimizeClick">
                    <Button.ToolTip>
                        <ToolTip FontFamily="{DynamicResource NavigationTextFontFamily}"
                                 FontSize="12"
                                 Content="{DynamicResource TitleBarMinimizeToolTip}"/>
                    </Button.ToolTip>
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE921;" FontSize="12"/>
                </Button>
                <Button Style="{StaticResource TitleBarButton}"
                        AutomationProperties.Name="{DynamicResource Maximize}"
                        Click="OnMaximizeClick">
                    <Button.ToolTip>
                        <ToolTip FontFamily="{DynamicResource NavigationTextFontFamily}"
                                 FontSize="12"
                                 Content="{DynamicResource TitleBarMaximizeToolTip}"/>
                    </Button.ToolTip>
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE922;" FontSize="12"/>
                </Button>
                <Button Style="{StaticResource TitleBarButton}"
                        AutomationProperties.Name="{DynamicResource Close}"
                        Click="OnCloseWindowClick">
                    <Button.ToolTip>
                        <ToolTip FontFamily="{DynamicResource NavigationTextFontFamily}"
                                 FontSize="12"
                                 Content="{DynamicResource TitleBarCloseToolTip}"/>
                    </Button.ToolTip>
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8BB;" FontSize="12"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="MainContentGrid" Grid.Row="2" UseLayoutRounding="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="DeviceColumn" Width="Auto"/>
                <ColumnDefinition x:Name="LeftGapColumn" Width="18"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RightGapColumn" Width="0"/>
                <ColumnDefinition x:Name="ControlColumn" Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="LeftPanelHost" Grid.Column="0" Width="300">
            <Border x:Name="DevicePanel"
                    Style="{StaticResource WorkspaceCardBorder}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource DevicesTitle}" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding DeviceCount}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center" FontSize="12"/>
                        <Button Grid.Column="3" Style="{StaticResource WorkspaceIconButton}"
                                Width="32" Height="32" MinHeight="32" Margin="0" Padding="0"
                                Click="OnCloseDevicePanelClick" ToolTip="{DynamicResource Close}"
                                AutomationProperties.AutomationId="CloseDevicePanelButton">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8BB;" FontSize="12"/>
                        </Button>
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource ControlSectionCard}" Margin="0" Padding="12">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{DynamicResource CurrentDevice}" Style="{StaticResource ControlSectionTitle}"/>
                                <TextBlock Text="{Binding SelectedConnection}" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource MutedTextBrush}" FontSize="10"/>
                            </Grid>
                            <TextBlock Text="{Binding SelectedName}" FontSize="15" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Margin="0,9,0,0"/>
                            <TextBlock Text="{Binding SelectedModel}" Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="11" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding SelectedOs}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding SelectedUdid}" FontFamily="Consolas" FontSize="9"
                                       AutomationProperties.AutomationId="SelectedDeviceUdidText"
                                       Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"
                                       Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="3" Height="1" Background="{DynamicResource BorderSoftBrush}"
                            VerticalAlignment="Center" Margin="2,0"/>
                    <ListBox x:Name="DeviceListBox" Grid.Row="4" ItemsSource="{Binding Devices}"
                             AutomationProperties.AutomationId="DeviceListBox"
                             SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="OnDeviceListLeftButtonDown"
                             PreviewMouseMove="OnDeviceListMouseMove"
                             PreviewMouseLeftButtonUp="OnDeviceListLeftButtonUp"
                             PreviewMouseRightButtonDown="OnDeviceListRightButtonDown"
                             DragOver="OnDeviceListDragOver"
                             Drop="OnDeviceListDrop">
                        <ListBox.Resources>
                            <Style TargetType="ContextMenu">
                                <Setter Property="Background" Value="{DynamicResource PanelRaisedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Padding" Value="5"/>
                                <Setter Property="HasDropShadow" Value="True"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ContextMenu">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style TargetType="MenuItem">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="FontFamily" Value="Segoe UI"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Padding" Value="14,9"/>
                                <Setter Property="MinWidth" Value="150"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Border x:Name="MenuRoot" Background="{TemplateBinding Background}"
                                                    CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter ContentSource="Header"
                                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Setter TargetName="MenuRoot" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <ContextMenu x:Key="DeviceContextMenu" Placement="MousePoint">
                                <MenuItem Header="{DynamicResource MirrorSimultaneously}"
                                          Click="OnMirrorSimultaneouslyClick"/>
                            </ContextMenu>
                        </ListBox.Resources>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem"
                                   BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="ContextMenu" Value="{StaticResource DeviceContextMenu}"/>
                                <Setter Property="AutomationProperties.AutomationId"
                                        Value="{Binding AutomationId}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid AutomationProperties.AutomationId="{Binding AutomationId}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="48" CornerRadius="6" BorderThickness="2"
                                            BorderBrush="{DynamicResource MutedTextBrush}" VerticalAlignment="Top">
                                        <Ellipse Width="3" Height="3" Fill="{DynamicResource MutedTextBrush}"
                                                 VerticalAlignment="Top" Margin="0,4,0,0"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ModelDisplay}" Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="11" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding OsDisplay}" Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="11"/>
                                        <TextBlock Text="{Binding StatusDisplay}" Foreground="{DynamicResource SuccessBrush}"
                                                   FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="5">
                        <Button x:Name="RefreshDevicesButton"
                                Content="{DynamicResource RefreshDevices}" Command="{Binding RefreshCommand}"
                                Background="{DynamicResource ControlFillBrush}"/>
                        <TextBlock Text="{DynamicResource KeepUnlocked}" Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11" TextAlignment="Center" Margin="0,9,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="MirroringPanel"
                    Style="{StaticResource WorkspaceCardBorder}" Padding="16"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="{DynamicResource NavMirroring}" FontSize="16"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource WorkspaceIconButton}"
                                Width="32" Height="32" MinHeight="32" Margin="0" Padding="0"
                                HorizontalAlignment="Right" Click="OnCloseMirroringPanelClick"
                                ToolTip="{DynamicResource Close}"
                                AutomationProperties.AutomationId="CloseMirroringPanelButton">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8BB;" FontSize="12"/>
                        </Button>
                    </Grid>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{DynamicResource ProjectionSettingsDescription}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <Button Command="{Binding MoreImageSettingsCommand}"
                                Style="{StaticResource ToolButton}" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" FontSize="15"/>
                                <TextBlock Text="{DynamicResource IndependentWindowImageSettings}" Margin="9,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OnPreviewWindowClick" IsEnabled="{Binding CanUseVisualPreviewTools}"
                                Style="{StaticResource ToolButton}" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8A7;" FontSize="15"/>
                                <TextBlock Text="{DynamicResource SeparateWindow}" Margin="9,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OnScreenshotClick" IsEnabled="{Binding CanUseVisualPreviewTools}"
                                Style="{StaticResource ToolButton}" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE722;" FontSize="15"/>
                                <TextBlock Text="{DynamicResource Screenshot}" Margin="9,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OnRefreshPreviewClick" IsEnabled="{Binding CanUseVisualPreviewTools}"
                                Style="{StaticResource ToolButton}"
                                Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" FontSize="15"/>
                                <TextBlock Text="{DynamicResource RefreshFrame}" Margin="9,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OnFullScreenClick" IsEnabled="{Binding CanUseVisualPreviewTools}"
                                Style="{StaticResource ToolButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE740;" FontSize="15"/>
                                <TextBlock Text="{DynamicResource FullScreenPreview}" Margin="9,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            </Grid>

            <Grid x:Name="CenterPanel" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition x:Name="StatsGapRow" Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="EnvironmentPanel" Grid.Row="0"
                        Margin="0,0,0,14" Padding="10,9,10,9">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}"
                               BasedOn="{StaticResource WorkspaceCardBorder}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PreviewAndObsVisibility}" Value="Visible">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="PreviewQuickActions" Grid.Column="1"
                                    Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding PreviewAndObsVisibility}">
                            <Button Command="{Binding MoreImageSettingsCommand}"
                                    Style="{StaticResource PreviewToolButton}"
                                    ToolTip="{DynamicResource IndependentWindowImageSettings}"
                                    AutomationProperties.AutomationId="QuickImageSettingsButton">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" FontSize="14"/>
                                    <TextBlock Text="{DynamicResource IndependentWindowImageSettings}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="QuickPreviewWindowButton" Click="OnPreviewWindowClick"
                                    Style="{StaticResource PreviewToolButton}"
                                    IsEnabled="{Binding CanUseVisualPreviewTools}"
                                    ToolTip="{DynamicResource SeparateWindow}"
                                    AutomationProperties.AutomationId="QuickPreviewWindowButton">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8A7;" FontSize="14"/>
                                    <TextBlock Text="{DynamicResource SeparateWindow}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="QuickScreenshotButton" Click="OnScreenshotClick"
                                    Style="{StaticResource PreviewToolButton}"
                                    IsEnabled="{Binding CanUseVisualPreviewTools}"
                                    ToolTip="{DynamicResource Screenshot}"
                                    AutomationProperties.AutomationId="QuickScreenshotButton">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE722;" FontSize="15"/>
                            </Button>
                            <Button x:Name="QuickRefreshPreviewButton" Click="OnRefreshPreviewClick"
                                    Style="{StaticResource PreviewToolButton}"
                                    IsEnabled="{Binding CanUseVisualPreviewTools}"
                                    ToolTip="{DynamicResource RefreshFrame}"
                                    AutomationProperties.AutomationId="QuickRefreshPreviewButton">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" FontSize="15"/>
                            </Button>
                            <Button x:Name="QuickFullScreenButton" Click="OnFullScreenClick"
                                    Style="{StaticResource PreviewToolButton}"
                                    IsEnabled="{Binding CanUseVisualPreviewTools}"
                                    ToolTip="{DynamicResource FullScreenPreview}"
                                    AutomationProperties.AutomationId="QuickFullScreenButton">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE740;" FontSize="15"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="PreviewPanel" Grid.Row="1" Background="{DynamicResource PreviewChromeBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="16" ClipToBounds="True"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        MinWidth="0" MinHeight="0" SnapsToDevicePixels="True">
                    <Grid>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <StackPanel x:Name="WaitingForDeviceState"
                                        AutomationProperties.AutomationId="WaitingForDeviceState"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDevice}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Width="92" Height="92" CornerRadius="46"
                                        Background="{DynamicResource PreviewPanelAltBrush}"
                                        BorderBrush="{DynamicResource PreviewBorderBrush}" BorderThickness="1"
                                        HorizontalAlignment="Center">
                                    <Grid>
                                        <Path Width="38" Height="48"
                                              Data="M13,2 L25,2 C31,2 35,6 35,12 L35,36 C35,42 31,46 25,46 L13,46 C7,46 3,42 3,36 L3,12 C3,6 7,2 13,2 Z M15,7 L23,7"
                                              Stroke="{DynamicResource PreviewMutedTextBrush}" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Stretch="Uniform"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{DynamicResource StatusWaitingDevice}"
                                           Foreground="{DynamicResource PreviewTextBrush}"
                                           FontSize="21" FontWeight="SemiBold" TextAlignment="Center"
                                           Margin="0,20,0,0"/>
                                <TextBlock Text="{DynamicResource KeepUnlocked}"
                                           Foreground="{DynamicResource PreviewMutedTextBrush}" FontSize="12"
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>

                            <StackPanel x:Name="ReadyToMirrorState"
                                        AutomationProperties.AutomationId="ReadyToMirrorState"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDevice}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Width="84" Height="126" CornerRadius="12" BorderThickness="2"
                                        BorderBrush="{DynamicResource PreviewBorderBrush}" HorizontalAlignment="Center">
                                    <Grid>
                                        <Border Width="30" Height="4" CornerRadius="2"
                                                Background="{DynamicResource PreviewBorderBrush}"
                                                VerticalAlignment="Top" Margin="0,8,0,0"/>
                                        <TextBlock Text="{Binding SelectedConnection}"
                                                   Foreground="{DynamicResource PreviewMutedTextBrush}"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding SelectedName}" Foreground="{DynamicResource PreviewTextBrush}"
                                           FontSize="20" FontWeight="SemiBold"
                                           TextAlignment="Center" Margin="0,20,0,0"/>
                                <TextBlock Text="{Binding CaptureStatus}" Foreground="{DynamicResource PreviewMutedTextBrush}"
                                           FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                        <controls:NativePreviewHost x:Name="MainPreviewHost">
                            <controls:NativePreviewHost.Style>
                                <Style TargetType="{x:Type controls:NativePreviewHost}">
                                    <!-- HwndHost airspace cannot be painted over by WPF. Remove it
                                         from idle layout entirely instead of shrinking it through an
                                         intermediate native surface that DWM can expose for a frame. -->
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsCapturing}" Value="True"/>
                                                <Condition Binding="{Binding IsAudioOnlyAirPlay}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:NativePreviewHost.Style>
                        </controls:NativePreviewHost>
                        <Grid x:Name="AirPlayMusicSurface"
                              AutomationProperties.AutomationId="AirPlayMusicSurface"
                              Background="{DynamicResource PreviewChromeBrush}"
                              Panel.ZIndex="1" IsHitTestVisible="False">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAudioOnlyAirPlay}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        MaxWidth="460">
                                <Border Width="96" Height="96" CornerRadius="48"
                                        Background="{DynamicResource PreviewPanelAltBrush}"
                                        BorderBrush="{DynamicResource PreviewBorderBrush}"
                                        BorderThickness="1" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8D6;"
                                               Foreground="{DynamicResource PreviewTextBrush}"
                                               FontSize="38" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{DynamicResource WirelessMusicTitle}"
                                           Foreground="{DynamicResource PreviewTextBrush}"
                                           FontSize="21" FontWeight="SemiBold" TextAlignment="Center"
                                           Margin="0,20,0,0"/>
                                <TextBlock Text="{Binding SelectedName}"
                                           Foreground="{DynamicResource PreviewTextBrush}"
                                           FontSize="14" TextAlignment="Center" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding CaptureStatus}"
                                           Foreground="{DynamicResource PreviewMutedTextBrush}"
                                           FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="MediaCastSurface" Visibility="Collapsed"
                              AutomationProperties.AutomationId="MediaCastSurface"
                              Background="{DynamicResource PreviewChromeBrush}" Panel.ZIndex="2">
                            <Grid x:Name="MediaCastPlayerHost"
                                  Background="{DynamicResource PreviewChromeBrush}">
                                <MediaElement x:Name="MediaCastMediaElement"
                                              LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                              Stretch="Uniform" ScrubbingEnabled="True"/>
                            </Grid>
                            <Border x:Name="MediaCastStatusPanel"
                                    Visibility="Collapsed"
                                    AutomationProperties.AutomationId="MediaCastStatusPanel"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{DynamicResource MediaOverlayBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="12" Padding="20,12">
                                <TextBlock x:Name="MediaCastStatusText"
                                           Text="{DynamicResource MediaCastWaitingVideo}"
                                           Foreground="{DynamicResource MediaOverlayTextBrush}"
                                           FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                                           MaxWidth="560"/>
                            </Border>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Width="34" Height="30" MinHeight="30" Margin="0,8,8,0"
                                    Padding="0" Content="&#x00D7;"
                                    AutomationProperties.AutomationId="CloseMediaCastButton"
                                    Click="OnMediaCastCloseClick"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="StatsPanel" Grid.Row="3" Style="{StaticResource WorkspaceCardBorder}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="13,10"
                              Visibility="{Binding MediaOutputStatusVisibility}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource StatusPendingBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MediaOutputTone}" Value="Applied">
                                                <Setter Property="Fill" Value="{DynamicResource StatusAppliedBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MediaOutputTone}" Value="Failed">
                                                <Setter Property="Fill" Value="{DynamicResource StatusFailedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Grid.Column="2" Text="{Binding MediaOutputStatus}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="11" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="MediaOutputStatusText"/>
                        </Grid>
                        <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderSoftBrush}"
                                Visibility="{Binding MediaOutputStatusVisibility}"/>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="13">
                            <TextBlock Text="{DynamicResource ResolutionLabel}" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding Resolution}" Style="{StaticResource StatValue}"
                                       AutomationProperties.AutomationId="ResolutionValue"/>
                            <TextBlock Text="{Binding TargetResolutionDisplay}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource BorderSoftBrush}" Margin="0,10"/>
                        <StackPanel Grid.Column="2" Margin="13">
                            <TextBlock Text="{DynamicResource FrameRateLabel}" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding FpsDisplay}" Style="{StaticResource StatValue}"
                                       AutomationProperties.AutomationId="FrameRateValue"/>
                            <TextBlock Text="{Binding TargetFpsDisplay}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10"/>
                        </StackPanel>
                        <Border Grid.Column="3" Background="{DynamicResource BorderSoftBrush}" Margin="0,10"/>
                        <StackPanel Grid.Column="4" Margin="13">
                            <TextBlock Text="{DynamicResource LatencyLabel}" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding LatencyDisplay}" Style="{StaticResource StatValue}"
                                       AutomationProperties.AutomationId="LatencyValue"/>
                            <TextBlock Text="{DynamicResource EndToEndLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10"/>
                        </StackPanel>
                        <Border Grid.Column="5" Background="{DynamicResource BorderSoftBrush}" Margin="0,10"/>
                        <StackPanel Grid.Column="6" Margin="13">
                            <TextBlock Text="{DynamicResource AudioLabel}" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding AudioDisplay}" Style="{StaticResource StatValue}"
                                       AutomationProperties.AutomationId="AudioValue"/>
                            <TextBlock Text="{Binding AudioDetailDisplay}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10"/>
                        </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

            </Grid>

            <Border x:Name="ControlPanel" Grid.Column="4" Width="0"
                    Style="{StaticResource WorkspaceCardBorder}"
                    Padding="16,16,1,16" Visibility="Collapsed">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              PanningMode="VerticalOnly">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar"
                               BasedOn="{StaticResource ContentEdgeScrollBarStyle}"/>
                    </ScrollViewer.Resources>
                    <StackPanel Margin="0,0,10,0">
                        <Grid>
                            <TextBlock Text="{DynamicResource ControlTitle}" FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Button Style="{StaticResource WorkspaceIconButton}"
                                    Width="32" Height="32" MinHeight="32" Margin="0" Padding="0"
                                    HorizontalAlignment="Right"
                                    Click="OnCloseSettingsPanelClick" ToolTip="{DynamicResource Close}"
                                    AutomationProperties.AutomationId="CloseSettingsPanelButton">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8BB;" FontSize="12"/>
                            </Button>
                        </Grid>

                        <Border Style="{StaticResource ControlSectionCard}"
                                Visibility="{Binding WirelessTopSettingsVisibility}">
                            <StackPanel>
                                <Grid><TextBlock Text="{DynamicResource WirelessReceiverTitle}" Style="{StaticResource ControlSectionTitle}"/><TextBlock Text="{DynamicResource WirelessServiceAlwaysOn}" HorizontalAlignment="Right" Foreground="{DynamicResource SuccessBrush}" FontSize="10"/></Grid>
                                <TextBlock Text="{DynamicResource WirelessResolutionLabel}" Style="{StaticResource DetailLabel}" Margin="0,10,0,5"/>
                                <ComboBox ItemsSource="{Binding WirelessDisplayProfiles}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedWirelessDisplayProfile, Mode=TwoWay}"/>
                                <TextBlock Text="{DynamicResource WirelessResolutionHelp}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding WirelessReceiverName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RoundedTextBox}" MaxLength="63" Height="36" ToolTip="{DynamicResource WirelessReceiverNameLabel}"/><Button Grid.Column="2" Content="{DynamicResource ApplyWirelessSettings}" Command="{Binding ApplyWirelessSettingsCommand}" Style="{StaticResource ToolButton}" MinWidth="64"/></Grid>
                                <TextBlock Text="{Binding WirelessStatus}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="1,8,0,0"/>
                                <TextBlock Text="{Binding AppliedWirelessProfileDisplay}" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" TextWrapping="Wrap" Margin="1,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ControlSectionCard}"
                                Visibility="{Binding UsbProjectionSettingsVisibility}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource UsbProjectionModeTitle}"
                                           Style="{StaticResource ControlSectionTitle}"/>
                                <Border Background="{DynamicResource ControlFillBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="12"
                                        Padding="2" Margin="0,9,0,0">
                                    <ListBox ItemsSource="{Binding UsbProjectionModes}"
                                             SelectedItem="{Binding SelectedUsbProjectionMode, Mode=TwoWay}"
                                             IsEnabled="{Binding CanChangeUsbProjectionMode}"
                                             ItemContainerStyle="{StaticResource UsbModeTabItem}"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" Columns="3"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <TextBlock Text="{Binding Label}" FontSize="9"
                                                               FontWeight="SemiBold" TextWrapping="Wrap"
                                                               TextAlignment="Center" VerticalAlignment="Center"
                                                               Margin="0,0,20,0"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                    <Button Style="{StaticResource UsbModeInfoButton}"
                                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                                            Click="OnUsbProjectionModeInfoClick"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                                <TextBlock Text="{DynamicResource UsbProjectionPerDeviceHint}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="9" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ControlSectionCard}" Visibility="Collapsed">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{DynamicResource CurrentDevice}" Style="{StaticResource ControlSectionTitle}"/>
                                    <TextBlock Text="{Binding SelectedConnection}"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="10"/>
                                </Grid>
                                <TextBlock Text="{Binding SelectedName}" FontSize="15" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Margin="0,11,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding SelectedModel}" FontSize="11"/>
                                    <TextBlock Text="  ·  " Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedOs}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
                                </StackPanel>
                                <TextBlock Text="UDID" Style="{StaticResource DetailLabel}" Margin="0,9,0,3"/>
                                <TextBlock Text="{Binding SelectedUdid}" FontFamily="Consolas" FontSize="9"
                                           AutomationProperties.AutomationId="SelectedDeviceUdidText"
                                           Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border>
                            <Border.Style>
                                <Style TargetType="Border"
                                       BasedOn="{StaticResource ControlSectionCard}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCaptureSession}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMediaCasting}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ImageAndSound}" Style="{StaticResource ControlSectionTitle}"/>
                                <StackPanel Visibility="{Binding VideoSettingsVisibility}">
                                    <TextBlock Text="{DynamicResource RenderLimitHelp}"
                                               Foreground="{DynamicResource MutedTextBrush}" FontSize="9"
                                               TextWrapping="Wrap" Margin="0,4,0,1"
                                               Visibility="{Binding WiredVideoLimitSettingsVisibility}"/>

                                    <StackPanel Visibility="{Binding WiredVideoLimitSettingsVisibility}">
                                        <TextBlock Text="{DynamicResource RenderResolutionLimit}" Style="{StaticResource DetailLabel}" Margin="0,10,0,5"/>
                                        <ComboBox x:Name="ResolutionComboBox"
                                                  ItemsSource="{Binding ResolutionPresets}"
                                                  DisplayMemberPath="Label"
                                                  IsEnabled="{Binding CanChangeVideoPipeline}"
                                                  SelectedItem="{Binding SelectedResolutionPreset, Mode=TwoWay}"/>

                                        <TextBlock Text="{DynamicResource TargetFrameRate}" Style="{StaticResource DetailLabel}" Margin="0,10,0,5"/>
                                        <ComboBox x:Name="FrameRateComboBox"
                                                  ItemsSource="{Binding FrameRates}"
                                                  IsEnabled="{Binding CanChangeVideoPipeline}"
                                                  SelectedItem="{Binding SelectedFrameRate, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <TextBlock Text="{DynamicResource DecoderPreferenceLabel}"
                                               Style="{StaticResource DetailLabel}" Margin="0,10,0,5"/>
                                    <ComboBox ItemsSource="{Binding DecoderPreferences}"
                                              DisplayMemberPath="Label"
                                              IsEnabled="{Binding CanChangeDecoderPipeline}"
                                              SelectedItem="{Binding SelectedDecoderPreference, Mode=TwoWay}"/>

                                    <TextBlock Text="{DynamicResource VideoPipelinePreferenceHelp}"
                                               Foreground="{DynamicResource MutedTextBrush}" FontSize="9"
                                               TextWrapping="Wrap" Margin="0,6,0,0"/>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="ApplyVideoSettingsButton"
                                                Content="{DynamicResource ApplyVideoSettings}"
                                                Command="{Binding ApplyVideoSettingsCommand}"
                                                Style="{StaticResource ToolButton}"/>
                                        <Button Grid.Column="2"
                                                Content="{DynamicResource MoreImageSettingsButton}"
                                                Command="{Binding MoreImageSettingsCommand}"
                                                Style="{StaticResource ToolButton}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding SettingsStatus}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="9" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="0,12,0,11"/>
                                <CheckBox x:Name="AudioPlaybackCheckBox"
                                          Content="{DynamicResource PlayAudioWindows}"
                                          IsChecked="{Binding PlayAudio, Mode=TwoWay}"/>
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource PlaybackVolume}" Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding PlaybackVolume, StringFormat={}{0:F0}%}"
                                               Width="42" TextAlignment="Right"
                                               Foreground="{DynamicResource AccentHoverBrush}"
                                               FontSize="10" FontWeight="SemiBold"/>
                                </Grid>
                                <Slider x:Name="VolumeSlider"
                                        Minimum="0" Maximum="100"
                                        Value="{Binding PlaybackVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,4,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ControlSectionCard}"
                                Visibility="{Binding WirelessBottomSettingsVisibility}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{DynamicResource WirelessReceiverTitle}"
                                               Style="{StaticResource ControlSectionTitle}"/>
                                    <TextBlock Text="{DynamicResource WirelessServiceAlwaysOn}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SuccessBrush}" FontSize="10"/>
                                </Grid>
                                <TextBlock Text="{DynamicResource WirelessResolutionLabel}"
                                           Style="{StaticResource DetailLabel}" Margin="0,10,0,5"/>
                                <ComboBox ItemsSource="{Binding WirelessDisplayProfiles}"
                                          DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedWirelessDisplayProfile, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="WirelessResolutionComboBox"/>
                                <TextBlock Text="{DynamicResource WirelessResolutionHelp}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="9" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding WirelessReceiverName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource RoundedTextBox}"
                                             MaxLength="63" Height="36"
                                             ToolTip="{DynamicResource WirelessReceiverNameLabel}"/>
                                    <Button Grid.Column="2" Content="{DynamicResource ApplyWirelessSettings}"
                                            Command="{Binding ApplyWirelessSettingsCommand}"
                                            Style="{StaticResource ToolButton}" MinWidth="64"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="1,8,0,0">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}"
                                             VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding WirelessStatus}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="10" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Text="{Binding AppliedWirelessProfileDisplay}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="9" TextWrapping="Wrap" Margin="1,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ControlSectionCard}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{DynamicResource MediaCastTitle}"
                                               Style="{StaticResource ControlSectionTitle}"/>
                                    <TextBlock Text="{DynamicResource WirelessServiceAlwaysOn}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SuccessBrush}" FontSize="10"/>
                                </Grid>
                                <TextBlock Text="{DynamicResource MediaCastDescription}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding MediaCastReceiverName}"
                                           FontSize="13" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="1,7,0,0">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}"
                                             VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding MediaCastStatus}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="10" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="AdvancedSettingsCard"
                                Style="{StaticResource ControlSectionCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource AppPreferencesTitle}"
                                           Style="{StaticResource ControlSectionTitle}"/>
                                <TextBlock Text="{DynamicResource LanguageToolTip}"
                                           Style="{StaticResource DetailLabel}" Margin="0,10,0,5"/>
                                <ComboBox x:Name="LanguageComboBox" Height="36"
                                          AutomationProperties.AutomationId="LanguageComboBox"
                                          SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                                          SelectedValuePath="Tag"
                                          ToolTip="{DynamicResource LanguageToolTip}">
                                    <ComboBoxItem Tag="system" Content="{DynamicResource LanguageSystem}"/>
                                    <ComboBoxItem Tag="zh-CN" Content="{DynamicResource LanguageChinese}"/>
                                    <ComboBoxItem Tag="zh-HK" Content="{DynamicResource LanguageTraditionalChineseHongKong}"/>
                                    <ComboBoxItem Tag="en-US" Content="{DynamicResource LanguageEnglish}"/>
                                </ComboBox>
                                <TextBlock Text="{DynamicResource ThemeTitle}"
                                           Style="{StaticResource DetailLabel}" Margin="0,10,0,5"/>
                                <ComboBox x:Name="ThemeComboBox" Height="36"
                                          AutomationProperties.AutomationId="ThemeComboBox"
                                          SelectedValuePath="Tag"
                                          SelectionChanged="OnThemeSelectionChanged">
                                    <ComboBoxItem Tag="System" Content="{DynamicResource ThemeSystem}"/>
                                    <ComboBoxItem Tag="Dark" Content="{DynamicResource ThemeDark}"/>
                                    <ComboBoxItem Tag="Light" Content="{DynamicResource ThemeLight}"/>
                                </ComboBox>
                                <Button Content="{DynamicResource AdvancedSettings}"
                                        Command="{Binding AdvancedSettingsCommand}"
                                        Style="{StaticResource ToolButton}"
                                        Margin="0,10,0,0"
                                        Visibility="{Binding AdvancedSettingsVisibility}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid x:Name="FooterPanel" Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="{DynamicResource FooterConnectivity}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10"/>
            <TextBlock Text="{Binding VersionText, RelativeSource={RelativeSource AncestorType=Window}}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="10" HorizontalAlignment="Right" Cursor="Hand"
                       MouseLeftButtonDown="OnVersionClick"/>
        </Grid>

        <Popup x:Name="PreviewTransitionMask"
               PlacementTarget="{Binding ElementName=PreviewPanel}"
               Placement="Center"
               AllowsTransparency="True"
               StaysOpen="True"
               Focusable="False"
               IsHitTestVisible="False">
            <Grid Width="{Binding ActualWidth, ElementName=PreviewPanel}"
                  Height="{Binding ActualHeight, ElementName=PreviewPanel}"
                  Background="Transparent"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True">
                <Border Margin="1,0,1,2"
                        Background="{DynamicResource PreviewChromeBrush}"
                        CornerRadius="7"
                        SnapsToDevicePixels="True"/>
            </Grid>
        </Popup>
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
