                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ModelDisplay}" Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="11" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding OsDisplay}" Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="11"/>
                                        <TextBlock Text="{Binding StatusDisplay}" Foreground="{DynamicResource SuccessBrush}"
                                                   FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="5">
                        <Button x:Name="RefreshDevicesButton"
                                Content="{DynamicResource RefreshDevices}" Command="{Binding RefreshCommand}"
