<UserControl x:Class="IPhoneMirror.App.Controls.DeviceHubPanel" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextBrush}" AutomationProperties.AutomationId="DeviceHubPanel" PreviewKeyDown="OnPanelKeyDown">
    <UserControl.Resources>
        <Style x:Key="HubPageTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,8,4,10" RecognizesAccessKey="True">
                            <ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="TextAlignment" Value="Center"/></Style></ContentPresenter.Resources>
                        </ContentPresenter>
                        <Border x:Name="Indicator" Height="3" Margin="16,0,16,0" VerticalAlignment="Bottom" CornerRadius="2" Background="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="Indicator" Property="Visibility" Value="Visible"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HubMenuSeparator" TargetType="Separator">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
                <Border Height="1" Margin="6,4" Background="{DynamicResource BorderBrush}"/>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="HubAction" TargetType="Button" BasedOn="{StaticResource CompactButton}">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
        <Style x:Key="HubCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="HubMappingSwitch" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Border x:Name="Track" Width="40" Height="22" CornerRadius="11"
                                BorderThickness="1" BorderBrush="{DynamicResource ComboBorderHoverBrush}"
                                Background="{DynamicResource ComboBackgroundBrush}">
                            <Ellipse x:Name="Thumb" Width="14" Height="14" HorizontalAlignment="Left" Margin="3,0,3,0"
                                     Fill="{DynamicResource MutedTextBrush}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource OnAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource FocusStrokeBrush}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="HubHeading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="HubEmpty" TargetType="StackPanel">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="16"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style x:Key="HubEmptyTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="HubListItem" TargetType="ListBoxItem" BasedOn="{StaticResource SelectableListItem}">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemRoot" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions>
                            <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource ComboItemSelectedBrush}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="HubList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource HubListItem}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"
                                CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="HubRow">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="7" Background="{DynamicResource ControlHoverBrush}" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="{Binding Glyph}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                        <Image Source="{Binding Icon}" Stretch="Uniform"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTip="{Binding Title}"/>
                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button x:Name="RowMore" Grid.Column="2" Style="{StaticResource IconButton}" Width="30" Height="30" MinHeight="30" VerticalAlignment="Center"
                    ToolTip="{DynamicResource DeviceHubPanelMore}" AutomationProperties.Name="{DynamicResource DeviceHubPanelMore}" Click="OnRowMoreClick">
                    <ui:SymbolIcon Symbol="MoreHorizontal20" FontSize="16"/>
                </Button>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="HubGroupHeader">
            <Border Margin="4,10,4,2" Padding="0,0,0,4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}"/>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Border Style="{StaticResource WorkspaceCardBorder}" Padding="16" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="{DynamicResource DeviceHubPanelTitle}" FontSize="{DynamicResource FontSize16}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,106,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="HeaderRefresh" Style="{StaticResource IconButton}" Width="32" Height="32" MinHeight="32" ToolTip="{DynamicResource DeviceHubRefresh}" Tag="refresh" Click="OnActionClick" AutomationProperties.AutomationId="DeviceHubRefreshButton">
                        <ui:SymbolIcon Symbol="ArrowClockwise20" FontSize="16"/>
                    </Button>
                    <Button x:Name="HeaderMore" Style="{StaticResource IconButton}" Width="32" Height="32" MinHeight="32" ToolTip="{DynamicResource DeviceHubPanelMore}" Click="OnMoreClick" AutomationProperties.AutomationId="DeviceHubMoreButton">
                        <ui:SymbolIcon Symbol="MoreHorizontal20" FontSize="16"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="32" Height="32" MinHeight="32" ToolTip="{DynamicResource Close}" Click="OnCloseClick" AutomationProperties.AutomationId="CloseDeviceHubButton">
                        <ui:SymbolIcon Symbol="Dismiss20" FontSize="16"/>
                    </Button>
                </StackPanel>
            </Grid>
            <DockPanel Grid.Row="1" Margin="0,12,0,12">
                <TextBlock x:Name="ConnectionText" DockPanel.Dock="Right" Style="{StaticResource HubCaption}" TextWrapping="NoWrap" VerticalAlignment="Top" FontSize="11" Margin="6,2,0,0" SizeChanged="OnConnectionTextSizeChanged"/>
                <StackPanel>
                    <TextBlock x:Name="DeviceNameText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="DeviceDetailText" Style="{StaticResource HubCaption}" FontSize="11" Margin="0,4,8,0"/>
                    <TextBlock x:Name="RecoveryHint" Text="{DynamicResource DeviceHubPanelRecoveryShort}" Style="{StaticResource HubCaption}" FontSize="11" Visibility="Collapsed" Margin="0,7,8,0" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </DockPanel>
            <UniformGrid x:Name="PageTabs" Grid.Row="2" Columns="6" Margin="0,0,0,12" KeyboardNavigation.DirectionalNavigation="Cycle">
                <RadioButton x:Name="InfoTab" Content="{DynamicResource DeviceHubPanelInfoTab}" Tag="0" GroupName="DeviceHubPages" Style="{StaticResource HubPageTab}" Checked="OnTabChecked" AutomationProperties.AutomationId="DeviceHubInfoTab"/>
                <RadioButton x:Name="AppsTab" Content="{DynamicResource DeviceHubApplications}" Tag="1" GroupName="DeviceHubPages" Style="{StaticResource HubPageTab}" Checked="OnTabChecked" AutomationProperties.AutomationId="DeviceHubAppsTab"/>
                <RadioButton Content="{DynamicResource DeviceHubProfiles}" Tag="2" GroupName="DeviceHubPages" Style="{StaticResource HubPageTab}" Checked="OnTabChecked"/>
                <RadioButton Content="{DynamicResource DeviceHubPanelFilesTab}" Tag="3" GroupName="DeviceHubPages" Style="{StaticResource HubPageTab}" Checked="OnTabChecked"/>
                <RadioButton Content="{DynamicResource DeviceHubPanelLogsTab}" Tag="4" GroupName="DeviceHubPages" Style="{StaticResource HubPageTab}" Checked="OnTabChecked"/>
                <RadioButton Content="{DynamicResource DeviceHubPanelControlsTab}" Tag="5" GroupName="DeviceHubPages" Style="{StaticResource HubPageTab}" Checked="OnTabChecked"/>
            </UniformGrid>
            <Grid Grid.Row="3">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel x:Name="FileToolbar" Visibility="Collapsed">
                    <DockPanel Margin="0,0,0,8">
                        <Button x:Name="FileImport" DockPanel.Dock="Right" Content="{DynamicResource DeviceHubPanelImportFiles}" Tag="file-import" Click="OnActionClick"
                            Style="{StaticResource HubAction}" Margin="6,0,0,0" ToolTip="{DynamicResource DeviceHubPanelImportFilesHelp}"
                            AutomationProperties.AutomationId="DeviceHubImportFilesButton"/>
                        <ComboBox x:Name="FileRoot" SelectedIndex="0" SelectionChanged="OnFileRootChanged" AutomationProperties.Name="{DynamicResource DeviceHubPanelFileRoot}">
                            <ComboBoxItem Content="{DynamicResource DeviceHubPanelMediaFiles}" Tag="media"/>
                            <ComboBoxItem Content="{DynamicResource DeviceHubPanelCrashFiles}" Tag="crashes"/>
                        </ComboBox>
                    </DockPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="FileParent" Tag="file-parent" Click="OnActionClick" Style="{StaticResource HubAction}" ToolTip="{DynamicResource DeviceHubParent}" AutomationProperties.Name="{DynamicResource DeviceHubParent}" Margin="0,0,6,0">
                            <ui:SymbolIcon Symbol="ArrowUp20" FontSize="16"/>
                        </Button>
                        <TextBox x:Name="FilePath" Grid.Column="1" Text="/" KeyDown="OnPathKeyDown" AutomationProperties.Name="{DynamicResource DeviceHubPanelFilePath}"/>
                        <Button Grid.Column="2" Content="{DynamicResource DeviceHubBrowse}" Tag="file-browse" Click="OnActionClick" Style="{StaticResource HubAction}" Margin="6,0,0,0"/>
                    </Grid>
                </StackPanel>
                <!-- Keep disconnect available even while the phone pages are
                     disabled during a lost management connection. -->
                <StackPanel x:Name="ExplorerMappingRow" Grid.Row="1" Margin="0,0,0,10" Visibility="Collapsed">
                    <Border Background="{DynamicResource ControlFillBrush}" CornerRadius="10" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock x:Name="ExplorerMappingTitle" Text="{DynamicResource DeviceHubExplorerToggle}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ExplorerMappingFeedback" Style="{StaticResource HubCaption}" FontSize="11" Margin="0,3,0,0"
                                       Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                        <Button x:Name="ExplorerMappingOpen" Grid.Column="1" Style="{StaticResource IconButton}"
                                Width="32" Height="32" MinHeight="32" Margin="0,0,4,0" Visibility="Collapsed" Click="OnExplorerMappingOpenClick"
                                AutomationProperties.Name="{DynamicResource DeviceHubExplorerOpen}" AutomationProperties.AutomationId="DeviceHubExplorerMappingOpenButton">
                            <ui:SymbolIcon Symbol="FolderOpen20" FontSize="16"/>
                        </Button>
                        <CheckBox x:Name="ExplorerMappingToggle" Grid.Column="2" Style="{StaticResource HubMappingSwitch}" IsChecked="False"
                                  VerticalAlignment="Center" Checked="OnExplorerMappingChanged" Unchecked="OnExplorerMappingChanged"
                                  AutomationProperties.Name="{DynamicResource DeviceHubExplorerToggle}" AutomationProperties.AutomationId="DeviceHubExplorerMappingToggle"/>
                    </Grid>
                    </Border>
                </StackPanel>
                <Grid x:Name="Pages" Grid.Row="2" Visibility="Collapsed">
                    <ScrollViewer x:Name="InfoPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel x:Name="InfoRows"/>
                            <TextBlock Style="{StaticResource HubHeading}" Text="{DynamicResource DeviceHubPanelDiagnostics}"/>
                            <WrapPanel>
                                <Button Content="{DynamicResource DeviceHubCapabilities}" Tag="capabilities" Click="OnActionClick" Style="{StaticResource HubAction}"/>
                                <Button Content="{DynamicResource DeviceHubTunnel}" Tag="tunnel" Click="OnActionClick" Style="{StaticResource HubAction}"/>
                            </WrapPanel>
                            <StackPanel x:Name="DiagnosticRows"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid x:Name="AppsPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,8">
                            <TextBox x:Name="AppSearch" Padding="12,7,34,7" ToolTip="{DynamicResource DeviceHubPanelSearchApps}" AutomationProperties.Name="{DynamicResource DeviceHubPanelSearchApps}" TextChanged="OnAppSearchChanged"/>
                            <TextBlock x:Name="AppSearchHint" Text="{DynamicResource DeviceHubPanelSearchApps}" Style="{StaticResource HubCaption}" Margin="12,0,34,0" VerticalAlignment="Center" IsHitTestVisible="False" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            <Button x:Name="AppSearchClear" Style="{StaticResource IconButton}" Width="28" Height="28" MinHeight="28" Margin="0,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"
                                ToolTip="{DynamicResource DeviceHubPanelClearSearch}" AutomationProperties.Name="{DynamicResource DeviceHubPanelClearSearch}" Click="OnClearSearchClick" Tag="apps">
                                <ui:SymbolIcon Symbol="Dismiss20" FontSize="14"/>
                            </Button>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="AppFilter" SelectedIndex="0" SelectionChanged="OnAppFilterChanged" AutomationProperties.Name="{DynamicResource DeviceHubPanelAppFilter}">
                                <ComboBoxItem Content="{DynamicResource DeviceHubAllApps}" Tag="all"/>
                                <ComboBoxItem Content="{DynamicResource DeviceHubUserApps}" Tag="user"/>
                                <ComboBoxItem Content="{DynamicResource DeviceHubSystemApps}" Tag="system"/>
                                <ComboBoxItem Content="{DynamicResource DeviceHubDeveloperApps}" Tag="developer"/>
                                <ComboBoxItem Content="{DynamicResource DeviceHubClipApps}" Tag="clips"/>
                                <ComboBoxItem Content="{DynamicResource DeviceHubProcesses}" Tag="processes"/>
                            </ComboBox>
                            <CheckBox x:Name="IncludeHidden" Grid.Column="1" Margin="10,0,0,0" Content="{DynamicResource DeviceHubPanelHiddenApps}" ToolTip="{DynamicResource DeviceHubIncludeAll}" VerticalAlignment="Center" Checked="OnIncludeHiddenChanged" Unchecked="OnIncludeHiddenChanged"/>
                        </Grid>
                        <Grid Grid.Row="2">
                            <ListBox x:Name="AppsList" Style="{StaticResource HubList}" VirtualizingPanel.ScrollUnit="Pixel" ItemTemplate="{StaticResource HubRow}" SelectionChanged="OnListSelectionChanged" MouseDoubleClick="OnAppDoubleClick" AutomationProperties.AutomationId="DeviceHubAppList">
                                <ListBox.GroupStyle>
                                    <GroupStyle HeaderTemplate="{StaticResource HubGroupHeader}"/>
                                </ListBox.GroupStyle>
                            </ListBox>
                            <StackPanel x:Name="AppsEmpty" Style="{StaticResource HubEmpty}">
                                <TextBlock x:Name="AppsEmptyTitle" Text="{DynamicResource DeviceHubPanelNoResults}" Style="{StaticResource HubEmptyTitle}"/>
                                <TextBlock x:Name="AppsEmptyHint" Style="{StaticResource HubCaption}" TextAlignment="Center"/>
                                <Button x:Name="ResetAppFilters" Content="{DynamicResource DeviceHubPanelResetFilters}" Click="OnResetAppFiltersClick" Style="{StaticResource HubAction}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="AppCount" Grid.Row="3" Style="{StaticResource HubCaption}" FontSize="11" Margin="0,8,0,0"/>
                    </Grid>
                    <Grid x:Name="ProfilesPage" Visibility="Collapsed">
                        <ListBox x:Name="ProfilesList" Style="{StaticResource HubList}" ItemTemplate="{StaticResource HubRow}" SelectionChanged="OnListSelectionChanged"/>
                        <StackPanel x:Name="ProfilesEmpty" Style="{StaticResource HubEmpty}">
                            <TextBlock x:Name="ProfilesEmptyTitle" Text="{DynamicResource DeviceHubPanelNoProfiles}" Style="{StaticResource HubEmptyTitle}"/>
                            <TextBlock x:Name="ProfilesEmptyHint" Text="{DynamicResource DeviceHubPanelProfilesEmptyHint}" Style="{StaticResource HubCaption}" TextAlignment="Center"/>
                            <Button x:Name="ProfileEmptyInstall" Content="{DynamicResource DeviceHubPanelInstallProfile}" Tag="profile-install" Click="OnActionClick" Style="{StaticResource HubAction}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="FilesPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <ListBox x:Name="FilesList" Style="{StaticResource HubList}" ItemTemplate="{StaticResource HubRow}" SelectionChanged="OnListSelectionChanged" MouseDoubleClick="OnFileDoubleClick"/>
                            <StackPanel x:Name="FilesEmpty" Style="{StaticResource HubEmpty}">
                                <TextBlock Text="{DynamicResource DeviceHubPanelEmptyFolder}" Style="{StaticResource HubEmptyTitle}"/>
                                <TextBlock Text="{DynamicResource DeviceHubPanelFilesEmptyHint}" Style="{StaticResource HubCaption}" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                            <Button x:Name="FileNext" Content="{DynamicResource DeviceHubPanelLoadMore}" Tag="file-next" Click="OnActionClick" Style="{StaticResource HubAction}"/>
                        </WrapPanel>
                    </Grid>
                    <Grid x:Name="LogsPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <WrapPanel>
                            <Button x:Name="LogStart" Content="{DynamicResource DeviceHubStartLog}" Tag="log-start" Click="OnActionClick" Style="{StaticResource HubAction}"/>
                            <Button x:Name="LogStop" Content="{DynamicResource DeviceHubStopLog}" Tag="log-stop" Click="OnActionClick" Style="{StaticResource HubAction}"/>
                            <Button x:Name="LogSave" ToolTip="{DynamicResource DeviceHubSaveLog}" AutomationProperties.Name="{DynamicResource DeviceHubSaveLog}" Tag="log-save" Click="OnActionClick"
                                Style="{StaticResource IconButton}" Width="34" Height="34" MinHeight="34" Margin="0,0,8,6">
                                <ui:SymbolIcon Symbol="Save20" FontSize="16"/>
                            </Button>
                            <CheckBox x:Name="LogFollow" Content="{DynamicResource DeviceHubPanelFollowLogs}" IsChecked="True" VerticalAlignment="Center" Margin="0,0,0,6"/>
                        </WrapPanel>
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <TextBox x:Name="LogSearch" Padding="12,7,34,7" TextChanged="OnLogSearchChanged" ToolTip="{DynamicResource DeviceHubPanelFilterLogs}" AutomationProperties.Name="{DynamicResource DeviceHubPanelFilterLogs}"/>
                            <TextBlock x:Name="LogSearchHint" Text="{DynamicResource DeviceHubPanelFilterLogs}" Style="{StaticResource HubCaption}" Margin="12,0,34,0" VerticalAlignment="Center" IsHitTestVisible="False" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            <Button x:Name="LogSearchClear" Style="{StaticResource IconButton}" Width="28" Height="28" MinHeight="28" Margin="0,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"
                                ToolTip="{DynamicResource DeviceHubPanelClearSearch}" AutomationProperties.Name="{DynamicResource DeviceHubPanelClearSearch}" Click="OnClearSearchClick" Tag="logs">
                                <ui:SymbolIcon Symbol="Dismiss20" FontSize="14"/>
                            </Button>
                        </Grid>
                        <Grid Grid.Row="2">
                            <TextBox x:Name="LogText" IsReadOnly="True" AcceptsReturn="True" Background="{DynamicResource ControlFillBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource DeviceHubLogs}"/>
                            <StackPanel x:Name="LogsEmpty" Style="{StaticResource HubEmpty}" IsHitTestVisible="False">
                                <TextBlock x:Name="LogsEmptyTitle" Style="{StaticResource HubEmptyTitle}"/>
                                <TextBlock x:Name="LogsEmptyHint" Style="{StaticResource HubCaption}" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <ScrollViewer x:Name="ControlsPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                        <StackPanel x:Name="ControlGroups"/>
                    </ScrollViewer>
                </Grid>
                <StackPanel x:Name="ConnectionPrompt" Grid.Row="2" VerticalAlignment="Center" Margin="16,0">
                    <ui:SymbolIcon Symbol="PhoneDesktop24" FontSize="36" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock x:Name="PromptTitle" TextAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PromptDetail" Style="{StaticResource HubCaption}" TextAlignment="Center" Margin="0,8,0,16"/>
                    <Button x:Name="PrepareButton" Tag="prepare" Click="OnActionClick" HorizontalAlignment="Center" Style="{StaticResource HubAction}" AutomationProperties.AutomationId="PrepareDeviceHubButton"/>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="4" Margin="0,10,0,0">
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" MaxHeight="64" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
