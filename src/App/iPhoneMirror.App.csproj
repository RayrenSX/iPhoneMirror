<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IPhoneMirror.App.Runtime.Tests" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>iPhoneMirror</AssemblyName>
    <RootNamespace>IPhoneMirror.App</RootNamespace>
    <Version>1.8.5-pre2</Version>
    <AssemblyVersion>1.8.5.0</AssemblyVersion>
    <FileVersion>1.8.5.0</FileVersion>
    <Authors>RayrenSX</Authors>
    <Product>iPhoneMirror</Product>
    <Description>Low-latency iPhone screen mirroring for Windows over USB and AirPlay.</Description>
    <Copyright>Copyright (c) 2026 RayrenSX</Copyright>
    <RepositoryUrl>https://github.com/RayrenSX/iPhoneMirror</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/RayrenSX/iPhoneMirror</PackageProjectUrl>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\iPhoneMirror.ico</ApplicationIcon>
    <DebugType>embedded</DebugType>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <UsbBridgeRoot Condition="'$(UsbBridgeRoot)' == ''">$(MSBuildProjectDirectory)\..\..\dist</UsbBridgeRoot>
    <!-- Keep the framework resource satellites used by the supported UI
         cultures in addition to the neutral English fallback. -->
    <SatelliteResourceLanguages>en;zh-Hans;zh-Hant</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\config\uxplay-component.json"
                      LogicalName="IPhoneMirror.App.Components.UxPlay.json" />
    <EmbeddedResource Include="native\components\ffmpeg.sha256"
                      LogicalName="IPhoneMirror.App.Components.Ffmpeg.sha256"
                      Condition="Exists('native\components\ffmpeg.sha256')" />
    <Content Include="$(UsbBridgeRoot)\iUsbBridge.exe">
      <Link>tools\iUsbBridge.exe</Link>
      <TargetPath>tools\iUsbBridge.exe</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="$(UsbBridgeRoot)\_internal\**\*">
      <Link>tools\_internal\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <TargetPath>tools\_internal\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="$(UsbBridgeRoot)\iUsbBridge.runtime.json">
      <Link>tools\iUsbBridge.runtime.json</Link>
      <TargetPath>tools\iUsbBridge.runtime.json</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\..\tools\ddi\Xcode_iOS_DDI_Personalized\**\*">
      <Link>tools\ddi\Xcode_iOS_DDI_Personalized\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <TargetPath>tools\ddi\Xcode_iOS_DDI_Personalized\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <Target Name="ValidateUsbTouchBridgePayload" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(UsbBridgeRoot)\iUsbBridge.exe')"
           Text="iUsbBridge.exe is missing. Run build.ps1 so the self-developed USB bridge is built first." />
    <Error Condition="!Exists('$(UsbBridgeRoot)\_internal')"
           Text="UsbTouchBridge runtime directory is missing. Run build.ps1 so the self-developed USB bridge is built first." />
    <Error Condition="!Exists('$(UsbBridgeRoot)\iUsbBridge.runtime.json')"
           Text="iUsbBridge runtime manifest is missing. Run build.ps1 so the self-developed USB bridge is built first." />
  </Target>

  <ItemGroup>
    <Compile Include="..\Shared\Networking\SegmentedHttpDownloader.cs"
             Link="Networking\SegmentedHttpDownloader.cs" />
    <Compile Include="..\Shared\Security\ElevationPathLock.cs"
             Link="Security\ElevationPathLock.cs" />
    <Compile Include="..\SharedUI\Services\AccessibilityAppearance.cs" Link="Services\AccessibilityAppearance.cs" />
    <Compile Include="..\SharedUI\Services\WindowWorkAreaController.cs"
             Link="Services\WindowWorkAreaController.cs" />
    <Compile Include="..\SharedUI\Animations\PageTransition.cs"
             Link="Animations\PageTransition.cs" />
    <Compile Include="..\SharedUI\Animations\RevealTransition.cs"
             Link="Animations\RevealTransition.cs" />
    <Compile Include="..\SharedUI\Controls\ModernButton.cs"
             Link="Controls\ModernButton.cs" />
    <Compile Include="..\SharedUI\Controls\ModernCard.cs"
             Link="Controls\ModernCard.cs" />
    <Compile Include="..\SharedUI\Controls\ModernDialog.cs"
             Link="Controls\ModernDialog.cs" />
    <Page Include="..\SharedUI\Themes\DesignTokens.xaml" Link="Themes\DesignTokens.xaml" />
    <Page Include="..\SharedUI\Controls\Inputs.xaml" Link="Controls\Inputs.xaml" />
    <Page Include="..\SharedUI\Controls\Buttons.xaml" Link="Controls\Buttons.xaml" />
    <Compile Include="..\SharedUI\Controls\StatusAppearance.cs" Link="Controls\StatusAppearance.cs" />
    <Compile Include="..\SharedUI\Controls\DialogKeyboard.cs" Link="Controls\DialogKeyboard.cs" />
    <Compile Include="..\SharedUI\Controls\ComboBoxTextLayout.cs" Link="Controls\ComboBoxTextLayout.cs" />
    <Compile Include="..\SharedUI\Controls\DialogViewport.cs" Link="Controls\DialogViewport.cs" />
    <Compile Include="..\SharedUI\Controls\RoundedWindow.cs" Link="Controls\RoundedWindow.cs" />
    <Page Include="..\SharedUI\Themes\LightTheme.xaml"
          Link="Themes\LightTheme.xaml" />
    <Page Include="..\SharedUI\Themes\DarkTheme.xaml"
          Link="Themes\DarkTheme.xaml" />
    <Page Include="..\SharedUI\Animations\ModernAnimations.xaml"
          Link="Animations\ModernAnimations.xaml" />
    <Page Include="..\SharedUI\Controls\ModernControls.xaml"
          Link="Controls\ModernControls.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(NuGetPackageRoot)wpf-ui\4.3.0\LICENSE.md"
             Condition="Exists('$(NuGetPackageRoot)wpf-ui\4.3.0\LICENSE.md')">
      <Link>licenses\WPF-UI-LICENSE.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="$(NuGetPackageRoot)wpf-ui\4.3.0\ThirdPartyNotices.txt"
             Condition="Exists('$(NuGetPackageRoot)wpf-ui\4.3.0\ThirdPartyNotices.txt')">
      <Link>licenses\WPF-UI-ThirdPartyNotices.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="Assets\iPhoneMirror.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <!-- MainWindow resolves this icon through a site-of-origin URI. -->
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Resource Include="Assets\iPhoneMirror.png" />
    <Content Include="native\iPhoneMirror.Core.dll" Condition="Exists('native\iPhoneMirror.Core.dll')">
      <Link>iPhoneMirror.Core.dll</Link>
      <TargetPath>iPhoneMirror.Core.dll</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="native\iPhoneMirror.VirtualCamera.dll" Condition="Exists('native\iPhoneMirror.VirtualCamera.dll')">
      <Link>iPhoneMirror.VirtualCamera.dll</Link>
      <TargetPath>iPhoneMirror.VirtualCamera.dll</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="native\iPhoneMirror.VirtualCamera.Admin.exe" Condition="Exists('native\iPhoneMirror.VirtualCamera.Admin.exe')">
      <Link>iPhoneMirror.VirtualCamera.Admin.exe</Link>
      <TargetPath>iPhoneMirror.VirtualCamera.Admin.exe</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="native\tools\ffmpeg\ffmpeg.exe;native\tools\ffmpeg\LICENSE.txt;native\tools\ffmpeg\README.txt;native\tools\ffmpeg\SOURCE.txt"
             Condition="'$(IncludeBundledFfmpeg)' != 'false' and Exists('native\tools\ffmpeg\ffmpeg.exe')">
      <Link>tools\ffmpeg\%(Filename)%(Extension)</Link>
      <TargetPath>tools\ffmpeg\%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="native\libusb-1.0.dll" Condition="Exists('native\libusb-1.0.dll')">
      <Link>libusb-1.0.dll</Link>
      <TargetPath>libusb-1.0.dll</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="native\libusb0.dll" Condition="Exists('native\libusb0.dll')">
      <Link>libusb0.dll</Link>
      <TargetPath>libusb0.dll</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="native\msvcp140.dll;native\vcruntime140.dll;native\vcruntime140_1.dll"
             Condition="Exists('native\vcruntime140.dll')">
      <Link>%(Filename)%(Extension)</Link>
      <TargetPath>%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="native\Wireless\iPhoneMirror.WirelessHost.exe" Condition="Exists('native\Wireless\iPhoneMirror.WirelessHost.exe')">
      <Link>Wireless\iPhoneMirror.WirelessHost.exe</Link>
      <TargetPath>Wireless\iPhoneMirror.WirelessHost.exe</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="native\Wireless\UxPlay\**\*"
             Condition="'$(IncludeBundledUxPlay)' == 'true' and Exists('native\Wireless\UxPlay')">
      <Link>Wireless\UxPlay\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <TargetPath>Wireless\UxPlay\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="native\Wireless\dnssd.dll" Condition="Exists('native\Wireless\dnssd.dll')">
      <Link>Wireless\dnssd.dll</Link>
      <TargetPath>Wireless\dnssd.dll</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="native\Wireless\msvcp140.dll;native\Wireless\vcruntime140.dll;native\Wireless\vcruntime140_1.dll"
             Condition="Exists('native\Wireless\vcruntime140.dll')">
      <Link>Wireless\%(Filename)%(Extension)</Link>
      <TargetPath>Wireless\%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\..\third_party\airplay-server\bin\x64\airplay2dll.dll;..\..\third_party\airplay-server\bin\x64\avcodec-58.dll;..\..\third_party\airplay-server\bin\x64\avutil-56.dll;..\..\third_party\airplay-server\bin\x64\swresample-3.dll;..\..\third_party\airplay-server\bin\x64\swscale-5.dll">
      <Link>Wireless\%(Filename)%(Extension)</Link>
      <TargetPath>Wireless\%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\..\third_party\airplay-server\LICENSE-*;..\..\third_party\airplay-server\NOTICE-*;..\..\third_party\airplay-server\SOURCE.md;..\..\third_party\airplay-server\SHA256SUMS.txt;..\..\third_party\airplay-server\BUILD.json">
      <Link>Wireless\licenses\%(Filename)%(Extension)</Link>
      <TargetPath>Wireless\licenses\%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\..\third_party\libusb\COPYING">
      <Link>licenses\libusb-COPYING.txt</Link>
      <TargetPath>licenses\libusb-COPYING.txt</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\..\LICENSE">
      <Link>LICENSE</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\..\THIRD_PARTY_NOTICES.md" Condition="Exists('..\..\THIRD_PARTY_NOTICES.md')">
      <Link>THIRD_PARTY_NOTICES.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\DriverInstaller\Assets\libusb-win32-1.2.6.0\COPYING_LGPL.txt">
      <Link>licenses\libusb-win32-COPYING-LGPL.txt</Link>
      <TargetPath>licenses\libusb-win32-COPYING-LGPL.txt</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\..\CHANGELOG.md">
      <Link>CHANGELOG.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <EmbeddedResource Include="..\..\CHANGELOG.zh-TW.md" WithCulture="false"
                      LogicalName="Localization.CHANGELOG.zh-TW.md" />
    <Content Include="..\..\CHANGELOG.zh-TW.md">
      <Link>CHANGELOG.zh-TW.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\..\docs\DRIVER_DEPENDENCIES.md">
      <Link>DRIVER_DEPENDENCIES.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="tools\updater\Apply-ZipUpdate.ps1">
      <Link>tools\updater\Apply-ZipUpdate.ps1</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="native\iPhoneMirror.UsbConfigurationSwitch.exe" Condition="Exists('native\iPhoneMirror.UsbConfigurationSwitch.exe')">
      <Link>iPhoneMirror.UsbConfigurationSwitch.exe</Link>
      <TargetPath>iPhoneMirror.UsbConfigurationSwitch.exe</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <EmbeddedResource Include="tools\updater\Apply-ZipUpdate.ps1"
                      LogicalName="IPhoneMirror.App.Updater.Apply-ZipUpdate.ps1" />
    <EmbeddedResource Include="native\iPhoneMirror.VirtualCamera.dll"
                      LogicalName="IPhoneMirror.App.Payload.iPhoneMirror.VirtualCamera.dll"
                      Condition="Exists('native\iPhoneMirror.VirtualCamera.dll')" />
    <EmbeddedResource Include="native\iPhoneMirror.VirtualCamera.Admin.exe"
                      LogicalName="IPhoneMirror.App.Payload.iPhoneMirror.VirtualCamera.Admin.exe"
                      Condition="Exists('native\iPhoneMirror.VirtualCamera.Admin.exe')" />
  </ItemGroup>

</Project>
