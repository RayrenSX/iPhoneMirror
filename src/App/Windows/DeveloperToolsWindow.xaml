<chrome:RoundedWindow x:Class="IPhoneMirror.App.Windows.DeveloperToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource DeveloperToolsTitle}" Width="1002" Height="782"
        MinWidth="842" MinHeight="642" WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False" Topmost="False"
        xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <chrome:RoundedWindow.Resources>
    </chrome:RoundedWindow.Resources>
    <Border x:Name="WindowSurface"
            SnapsToDevicePixels="True" Style="{StaticResource RoundedWindowContent}">
        <Grid animations:PageTransition.IsEnabled="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="{StaticResource DialogContentMinHeight}"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderDragSurface"
                  Style="{StaticResource SubWindowHeader}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  animations:WindowDragBehavior.IsEnabled="True">
                <StackPanel Margin="0,0,52,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource DeveloperToolsTitle}"
                                   Style="{StaticResource SubWindowTitle}"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource DeveloperToolsSubtitle}"
                               Style="{StaticResource SubWindowSubtitle}"/>
                </StackPanel>
                <Button Style="{StaticResource SubWindowCloseButton}" Click="OnCloseClick">
                    <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                <StackPanel>
                    <Border Style="{StaticResource SettingsSection}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource AutomationTitle}" Style="{StaticResource SubWindowSectionTitle}"/>
                            <TextBlock Text="{DynamicResource AutomationHelp}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,0"/>
                            <CheckBox x:Name="ApiEnabled" Content="{DynamicResource AutomationEnable}" Margin="0,10,0,8"/>
                            <TextBlock Text="127.0.0.1"/>
                            <TextBlock Text="{DynamicResource AutomationPort}" Margin="0,8,0,4"/>
                            <TextBox x:Name="ApiPort" MaxLength="5" AutomationProperties.Name="{DynamicResource AutomationPort}"/>
                            <TextBlock x:Name="ApiStatus" Margin="0,8,0,4" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ApiAddress" TextWrapping="Wrap"/>
                            <TextBlock Text="API Key: ••••••••••••" Margin="0,8,0,4"/>
                            <WrapPanel>
                                <Button Content="{DynamicResource AutomationApply}" Click="OnAutomationApply" Margin="0,4,6,0"/>
                                <Button Content="{DynamicResource AutomationRegenerate}" Click="OnAutomationRegenerate" Margin="0,4,6,0"/>
                                <Button Content="{DynamicResource AutomationCopyKey}" Click="OnAutomationCopyKey" Margin="0,4,6,0"/>
                                <Button Content="{DynamicResource AutomationDocs}" Click="OnAutomationDocs" Margin="0,4,6,0"/>
                                <Button Content="{DynamicResource AutomationCopyAddress}" Click="OnAutomationCopyAddress" Margin="0,4,6,0"/>
                                <Button Content="{DynamicResource AutomationReclaim}" Click="OnAutomationReclaim" Margin="0,4,6,0"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsSection}" Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource DeveloperToolsWorkspaceSection}"
                                       Style="{StaticResource SubWindowSectionTitle}"/>
                            <TextBlock Text="{DynamicResource DeveloperToolsWorkspaceHint}"
                                       Style="{StaticResource SubWindowSubtitle}"/>
                            <ItemsControl ItemsSource="{Binding WorkspaceItems}" Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding Key}" Click="OnSurfaceClick"
                                                MinWidth="180" MinHeight="54" Margin="0,0,8,8"
                                                HorizontalContentAlignment="Stretch">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="{Binding Icon}"
                                                               FontSize="16" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="{DynamicResource BodyFontSize}"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="{DynamicResource CaptionFontSize}"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsSection}" Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource DeveloperToolsWindowsSection}"
                                       Style="{StaticResource SubWindowSectionTitle}"/>
                            <TextBlock Text="{DynamicResource DeveloperToolsWindowsHint}"
                                       Style="{StaticResource SubWindowSubtitle}"/>
                            <ItemsControl ItemsSource="{Binding WindowItems}" Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding Key}" Click="OnSurfaceClick"
                                                MinWidth="180" MinHeight="54" Margin="0,0,8,8"
                                                HorizontalContentAlignment="Stretch">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="{Binding Icon}"
                                                               FontSize="16" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontSize="{DynamicResource BodyFontSize}"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="{DynamicResource CaptionFontSize}"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsSection}" Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource DeveloperToolsParametersSection}"
                                       Style="{StaticResource SubWindowSectionTitle}"/>
                            <TextBlock Text="{DynamicResource DeveloperToolsParametersHint}"
                                       Style="{StaticResource SubWindowSubtitle}"/>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource DeveloperParamTheme}"
                                               Style="{StaticResource DetailLabel}"/>
                                    <ComboBox x:Name="ThemeComboBox" SelectedValuePath="Tag"
                                              SelectionChanged="OnThemeChanged" Margin="0,6,0,0">
                                        <ComboBoxItem Tag="System" Content="{DynamicResource DeveloperThemeSystem}"/>
                                        <ComboBoxItem Tag="Light" Content="{DynamicResource DeveloperThemeLight}"/>
                                        <ComboBoxItem Tag="Dark" Content="{DynamicResource DeveloperThemeDark}"/>
                                    </ComboBox>
                                    <TextBlock Text="{DynamicResource DeveloperParamLanguage}"
                                               Style="{StaticResource DetailLabel}" Margin="0,14,0,0"/>
                                    <ComboBox x:Name="LanguageComboBox" SelectedValuePath="Tag"
                                              SelectionChanged="OnLanguageChanged" Margin="0,6,0,0">
                                        <ComboBoxItem Tag="system" Content="{DynamicResource DeveloperLanguageSystem}"/>
                                        <ComboBoxItem Tag="zh-CN" Content="{DynamicResource DeveloperLanguageSimplified}"/>
                                        <ComboBoxItem Tag="zh-HK" Content="{DynamicResource DeveloperLanguageTraditional}"/>
                                        <ComboBoxItem Tag="zh-TW" Content="{DynamicResource DeveloperLanguageTaiwan}"/>
                                        <ComboBoxItem Tag="en-US" Content="{DynamicResource DeveloperLanguageEnglish}"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource DeveloperParamOpacity}"
                                               Style="{StaticResource DetailLabel}"/>
                                    <Slider x:Name="OpacitySlider" Minimum="0.72" Maximum="1" Value="1"
                                            TickFrequency="0.01" IsSnapToTickEnabled="True"
                                            ValueChanged="OnOpacityChanged" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding OpacityText}" Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="{DynamicResource CaptionFontSize}" Margin="0,2,0,0"/>
                                    <CheckBox x:Name="TopmostCheckBox" Content="{DynamicResource DeveloperParamTopmost}"
                                              Checked="OnTopmostChanged" Unchecked="OnTopmostChanged"
                                              Margin="0,14,0,0"/>
                                    <TextBlock Text="{DynamicResource DeveloperParamWindowPreset}"
                                               Style="{StaticResource DetailLabel}" Margin="0,14,0,0"/>
                                    <WrapPanel Margin="0,6,0,0">
                                        <Button Content="{DynamicResource DeveloperPresetCompact}" Tag="compact"
                                                Click="OnPresetClick" MinWidth="94" Margin="0,0,6,0"/>
                                        <Button Content="{DynamicResource DeveloperPresetDefault}" Tag="default"
                                                Click="OnPresetClick" MinWidth="94" Margin="0,0,6,0"/>
                                        <Button Content="{DynamicResource DeveloperPresetMaximize}" Tag="maximize"
                                                Click="OnPresetClick" MinWidth="94"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                <Button Content="{DynamicResource DeveloperResetParameters}" Click="OnResetClick"
                                        MinWidth="116" Margin="0,0,8,0"/>
                                <Button Content="{DynamicResource DeveloperRefresh}" Click="OnRefreshClick"
                                        Style="{StaticResource PrimaryButton}" MinWidth="116"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsSection}" Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource DeveloperToolsInspectorSection}"
                                       Style="{StaticResource SubWindowSectionTitle}"/>
                            <TextBlock Text="{Binding DiagnosticsText}"
                                       FontFamily="Cascadia Mono,Consolas" FontSize="{DynamicResource CaptionFontSize}"
                                       Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>
                            <ItemsControl ItemsSource="{Binding OpenWindows}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="1" Content="{DynamicResource DeveloperActivate}"
                                                    Tag="{Binding}" Click="OnActivateWindowClick" MinWidth="76" MinHeight="30"/>
                                            <Button Grid.Column="3" Content="{DynamicResource DeveloperClose}"
                                                    Tag="{Binding}" Click="OnCloseWindowClick" MinWidth="64" MinHeight="30"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedTextBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Margin="8,0,0,0" Content="{DynamicResource Close}" Style="{StaticResource PrimaryButton}"
                        MinWidth="96" HorizontalAlignment="Right" Click="OnCloseClick"/>
            </Grid>
        </Grid>
    </Border>
</chrome:RoundedWindow>
