<chrome:RoundedWindow x:Class="IPhoneMirror.App.Windows.BluetoothConnectionWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="{DynamicResource DeviceBindingBluetoothWaitingTitle}" Width="522" Height="412" MinWidth="462" MinHeight="362" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Foreground="{DynamicResource TextBrush}"
        xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
 <Grid Style="{StaticResource SubWindowPageRoot}" animations:PageTransition.IsEnabled="True"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Style="{StaticResource SubWindowHeader}" animations:WindowDragBehavior.IsEnabled="True"><TextBlock Text="{DynamicResource DeviceBindingBluetoothWaitingTitle}" Style="{StaticResource SubWindowTitle}" Margin="0,0,48,0"/><Button Style="{StaticResource SubWindowCloseButton}" Click="CancelClick" ToolTip="{DynamicResource DeviceBindingCancel}"><ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/></Button></Grid>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{DynamicResource DeviceBindingBluetoothBroadcasting}" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource DeviceBindingBluetoothWaitingDescription}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="{StaticResource SecondaryFontSize}" Margin="0,10,0,0"/><Border Background="{DynamicResource ControlFillBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,18,0,0"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Bluetooth20" FontSize="18" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{DynamicResource DeviceBindingBluetoothWaitingStatus}" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Border></StackPanel></ScrollViewer>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{DynamicResource DeviceBindingCancel}" Click="CancelClick" MinWidth="88"/><Button Content="{DynamicResource DeviceBindingNext}" IsDefault="True" Click="NextClick" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" MinWidth="100"/></StackPanel>
 </Grid>
</chrome:RoundedWindow>
