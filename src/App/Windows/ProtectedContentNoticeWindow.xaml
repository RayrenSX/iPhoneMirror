<chrome:RoundedWindow x:Class="IPhoneMirror.App.Windows.ProtectedContentNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="452" SizeToContent="Height" MaxHeight="622" MinHeight="234"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False"
        xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Padding="20" Style="{StaticResource RoundedWindowContent}">
        <Grid animations:PageTransition.IsEnabled="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*" MinHeight="{StaticResource DialogContentMinHeight}"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Style="{StaticResource SubWindowHeader}"
                  animations:WindowDragBehavior.IsEnabled="True">
                <TextBlock Text="{Binding TitleText}"
                           Style="{StaticResource SubWindowTitle}" Margin="0,0,48,0"/>
                <Button Style="{StaticResource SubWindowCloseButton}" Click="OnCloseClick">
                    <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}"
                                   Symbol="Dismiss20" FontSize="18"/>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border  Background="{DynamicResource WarningSurfaceBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="15"
                            Background="{DynamicResource WarningBrush}"
                            VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="Warning20" FontSize="17"
                                       Foreground="{DynamicResource OnAccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="{Binding VideoStatusText}" TextWrapping="Wrap"
                                   FontSize="{DynamicResource SectionTitleFontSize}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ProtectionStatusText}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="{DynamicResource SecondaryFontSize}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            </ScrollViewer>
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center">
                    <Border Background="{DynamicResource ControlFillBrush}"
                            BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="1" CornerRadius="15"
                            Padding="10,5" Margin="0,0,6,0">
                        <DockPanel LastChildFill="True"><ui:SymbolIcon DockPanel.Dock="Left" Symbol="Speaker220"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="14" Margin="0,0,5,0"/><TextBlock TextWrapping="Wrap" Text="{Binding AudioBadgeText}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="{DynamicResource CaptionFontSize}" VerticalAlignment="Center"/></DockPanel>
                    </Border>
                    <Border Background="{DynamicResource ControlFillBrush}"
                            BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="1" CornerRadius="15"
                            Padding="10,5">
                        <DockPanel LastChildFill="True"><ui:SymbolIcon DockPanel.Dock="Left" Symbol="ArrowClockwise20"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="14" Margin="0,0,5,0"/><TextBlock TextWrapping="Wrap" Text="{Binding HintText}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="{DynamicResource CaptionFontSize}" VerticalAlignment="Center"/></DockPanel>
                    </Border>
                </WrapPanel>
                <Button Grid.Column="1" Content="{DynamicResource Close}"
                        Click="OnCloseClick" MinWidth="80" Margin="12,0,0,0"
                        Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </Grid>
    </Border>
</chrome:RoundedWindow>
