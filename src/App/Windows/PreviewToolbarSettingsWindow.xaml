<chrome:RoundedWindow x:Class="IPhoneMirror.App.Windows.PreviewToolbarSettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls" xmlns:local="clr-namespace:IPhoneMirror.App.Windows"
 xmlns:controls="clr-namespace:IPhoneMirror.App.Controls"
 Title="{DynamicResource ToolbarCustomize}" Width="1280" Height="800" WindowStartupLocation="CenterOwner"
 ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="False" Background="Black" ResizeMode="NoResize"
 Foreground="{DynamicResource TextBrush}" PreviewKeyDown="OnKeyDown">
 <Grid x:Name="EditorRoot" Background="Black" ClipToBounds="True"
       Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}"
       Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}}">
  <Grid.Resources>
   <Style x:Key="LibraryToggleStyle" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource ControlFillBrush}"/>
    <Setter Property="Padding" Value="16,8"/><Setter Property="MinHeight" Value="40"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
     <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
  </Grid.Resources>
  <Canvas IsHitTestVisible="False">
  <Image x:Name="SceneImage" Stretch="Fill" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0,0">
   <Image.RenderTransform><TransformGroup><ScaleTransform x:Name="SceneScale"/><TranslateTransform x:Name="SceneShift"/></TransformGroup></Image.RenderTransform>
  </Image>
  </Canvas>
  <Path x:Name="SurroundShade" Fill="Black" Opacity="0" IsHitTestVisible="False"/>
  <Canvas IsHitTestVisible="False">
   <Image x:Name="FocusToolbarImage" Stretch="Fill" IsHitTestVisible="False" RenderTransformOrigin="0,0">
    <Image.RenderTransform><TransformGroup><ScaleTransform x:Name="SnapshotScale"/><TranslateTransform x:Name="SnapshotShift"/></TransformGroup></Image.RenderTransform>
   </Image>
  </Canvas>
  <Grid x:Name="EditorContent" Opacity="0" IsHitTestVisible="False">
   <Border x:Name="ToolbarSurface" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource WorkspaceCardBrush}"
           BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="18" Padding="8">
    <Border.RenderTransform><TransformGroup><ScaleTransform x:Name="LiveToolbarScale"/><TranslateTransform x:Name="LiveToolbarShift"/></TransformGroup></Border.RenderTransform>
    <Grid>
    <ListBox x:Name="PreviewList" Background="Transparent" BorderThickness="0" Padding="0" SelectionChanged="OnSelectionChanged"
             ToolTip="{DynamicResource ToolbarBasicHelp}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
             ScrollViewer.CanContentScroll="False"
             PreviewMouseLeftButtonDown="OnToolbarMouseDown" PreviewMouseMove="OnToolbarMouseMove"
             PreviewMouseLeftButtonUp="OnToolbarMouseUp" LostMouseCapture="OnToolbarLostCapture"
             AutomationProperties.AutomationId="Toolbar.Preview">
     <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
      <Setter Property="Margin" Value="2"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
       <Border x:Name="Chip" Padding="10,8" Background="{DynamicResource ControlFillBrush}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="12">
        <ContentPresenter/>
       </Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource ControlHoverBrush}"/></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
     </Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate DataType="{x:Type local:ToolbarRow}">
      <StackPanel Orientation="Horizontal" ToolTip="{Binding Name}">
       <controls:ThemedSymbolIcon Symbol="{Binding Symbol}" FontSize="18" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
       <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="14" Margin="7,0,0,0" VerticalAlignment="Center" Visibility="{Binding LabelVisibility}"/>
      </StackPanel>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock x:Name="EmptyHint" Text="{DynamicResource ToolbarBasicEmpty}" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12" IsHitTestVisible="False"/>
    </Grid>
   </Border>
   <Border x:Name="SelectionTools" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"
           Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="6" Padding="5" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
    <StackPanel Orientation="Horizontal">
     <TextBlock x:Name="SelectionName" Foreground="{DynamicResource TextBrush}" MaxWidth="240" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,12,0"/>
     <Button x:Name="HideButton" Content="{DynamicResource ToolbarHide}" Click="OnHide" Margin="6,0,0,0" AutomationProperties.AutomationId="Toolbar.Hide"/>
    </StackPanel>
   </Border>
   <Border x:Name="SettingsPanel" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,28"
           Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="9" Padding="10">
    <Border.RenderTransform><TranslateTransform x:Name="FooterShift"/></Border.RenderTransform>
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ScrollViewer x:Name="OptionsScroll" MaxHeight="250" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <Border x:Name="LibraryPanel" Visibility="Collapsed" Padding="0,0,0,8">
        <StackPanel>
         <TextBlock Text="{DynamicResource ToolbarLibrary}" FontWeight="SemiBold" Margin="0,0,0,10"/>
         <WrapPanel x:Name="LibraryItems"/>
        </StackPanel>
       </Border>
     </ScrollViewer>
     <StackPanel Grid.Row="1">
      <TextBlock x:Name="Feedback" Foreground="{DynamicResource WarningBrush}" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <WrapPanel>
        <ToggleButton x:Name="LibraryToggle" Content="{DynamicResource ToolbarLibrary}" Click="OnLibrary" Margin="0,0,8,4" Style="{StaticResource LibraryToggleStyle}"/>
        <CheckBox x:Name="IconsOnlyCheck" Content="{DynamicResource ToolbarIconsOnly}" Margin="4,0,16,4" VerticalAlignment="Center" Click="OnModeChanged" AutomationProperties.AutomationId="Toolbar.IconsOnly"/>
        <Button Content="{DynamicResource ToolbarReset}" Click="OnReset" Margin="0,0,8,4"/>
       </WrapPanel>
       <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
        <Button Content="{DynamicResource ToolbarCancel}" Click="OnCancel" Margin="0,0,8,4"/>
        <Button x:Name="DoneButton" Content="{DynamicResource ToolbarDone}" Style="{StaticResource PrimaryButton}" Click="OnDone" Margin="0,0,0,4" AutomationProperties.AutomationId="Toolbar.Done"/>
       </StackPanel>
      </Grid>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
  <Canvas IsHitTestVisible="False">
   <Image x:Name="DragPreview" Visibility="Collapsed" Opacity="0.92">
    <Image.RenderTransform><TranslateTransform x:Name="DragShift"/></Image.RenderTransform>
   </Image>
  </Canvas>
 </Grid>
</chrome:RoundedWindow>
