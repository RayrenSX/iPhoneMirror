<chrome:RoundedWindow x:Class="IPhoneMirror.App.Windows.BluetoothClientBindingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource BluetoothClientBindingTitle}"
        Width="500" SizeToContent="Height" MaxHeight="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Foreground="{DynamicResource TextBrush}"
        xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <chrome:RoundedWindow.Resources>
        <Style x:Key="BluetoothPairingGuide" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Clients.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </chrome:RoundedWindow.Resources>
    <Grid Style="{StaticResource SubWindowPageRoot}"
          animations:PageTransition.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource SubWindowHeader}"
              animations:WindowDragBehavior.IsEnabled="True">
            <StackPanel Margin="0,0,48,0">
                <TextBlock TextWrapping="Wrap" Text="{DynamicResource BluetoothClientBindingTitle}"
                           Style="{StaticResource SubWindowTitle}"/>
                <TextBlock Text="{Binding TargetText}" Style="{StaticResource SubWindowSubtitle}"/>
            </StackPanel>
            <Button Style="{StaticResource SubWindowCloseButton}" Click="OnCancelClick"
                    ToolTip="{DynamicResource Cancel}">
                <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/>
            </Button>
        </Grid>
        <Border Grid.Row="1" Margin="0,16,0,0">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource SettingsSection}">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Clients.Count}" Value="0">
                            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Padding" Value="16"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource BluetoothPairingGuide}" Margin="0,0,12,0">
                    <Border Background="{DynamicResource ControlFillBrush}" Width="36" Height="36" CornerRadius="10">
                        <ui:SymbolIcon Symbol="Bluetooth20" FontSize="20" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <StackPanel x:Name="PairingInstructions" Style="{StaticResource BluetoothPairingGuide}">
                        <TextBlock Text="{DynamicResource BluetoothClientBindingEmptyTitle}" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource BluetoothEmptyState}" Style="{StaticResource SecondaryText}" Margin="0,4,0,12"/>
                    </StackPanel>
                    <Button x:Name="RefreshDevicesButton" Content="{DynamicResource BluetoothClientBindingRefresh}"
                            Click="OnRefreshClick" IsEnabled="{Binding CanRefresh}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Clients.Count}" Value="0">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock x:Name="FeedbackText" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"
                               AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                                <Setter Property="Margin" Value="0,8,0,0"/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
        <ListBox Grid.Row="2" ItemsSource="{Binding Clients}" MaxHeight="216" Margin="0,10,0,0"
                 SelectedItem="{Binding SelectedClient, Mode=TwoWay}"
                 BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.Style>
                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Clients.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Style>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="ItemRoot" Background="{DynamicResource ControlFillBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="0">
                                    <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemRoot" Property="Background"
                                                Value="{DynamicResource ControlHoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemRoot" Property="Background"
                                                Value="{DynamicResource ComboItemSelectedBrush}"/>
                                        <Setter TargetName="ItemRoot" Property="BorderBrush"
                                                Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="ItemRoot" Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                        <Grid Margin="12,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                <TextBlock TextWrapping="Wrap" Text="{Binding ConnectionTimeText}" Foreground="{DynamicResource AccentHoverBrush}"
                                           FontSize="{DynamicResource CaptionFontSize}" Margin="0,4,0,0"/>
                                <TextBlock TextWrapping="Wrap" Text="{Binding BindingText}" Foreground="{DynamicResource SuccessBrush}"
                                           FontSize="{DynamicResource CaptionFontSize}" Margin="0,3,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBound}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding IdentifierText}" Foreground="{DynamicResource MutedTextBrush}"
                                           FontFamily="{StaticResource CodeFontFamily}" FontSize="{DynamicResource CaptionFontSize}" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{DynamicResource BluetoothClientBindingUnbind}"
                                    Click="OnUnbindClick" VerticalAlignment="Center" Margin="12,0,0,0"
                                    Padding="10,5">
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBound}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <WrapPanel Grid.Row="3" Style="{StaticResource DialogActions}" Margin="0,14,0,0">
            <Button Content="{DynamicResource Cancel}" Click="OnCancelClick" MinWidth="88" Margin="{StaticResource DialogActionMargin}"/>
            <Button Content="{DynamicResource BluetoothClientBindingConfirm}" IsDefault="True"
                    Click="OnConfirmClick" IsEnabled="{Binding CanConfirm}" MinWidth="132" Margin="{StaticResource DialogActionMargin}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Clients.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </WrapPanel>
    </Grid>
</chrome:RoundedWindow>
