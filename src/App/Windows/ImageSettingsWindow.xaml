<chrome:RoundedWindow x:Class="IPhoneMirror.App.Windows.ImageSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource MoreImageSettingsTitle}"
        Width="582" Height="672" MinWidth="542" MinHeight="622"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        PreviewKeyDown="OnPreviewKeyDown"
        Closing="OnWindowClosing"
        Foreground="{DynamicResource TextBrush}"
        xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <chrome:RoundedWindow.Resources>
        <Style x:Key="AdjustmentLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize13}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="AdjustmentValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize12}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </chrome:RoundedWindow.Resources>

    <Grid Style="{StaticResource SubWindowPageRoot}"
          animations:PageTransition.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*" MinHeight="{StaticResource DialogContentMinHeight}"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Style="{StaticResource SubWindowHeader}"
              animations:WindowDragBehavior.IsEnabled="True">
            <StackPanel Margin="0,0,48,0">
                <TextBlock Text="{DynamicResource MoreImageSettingsTitle}"
                           Style="{StaticResource SubWindowTitle}"/>
                <TextBlock Text="{DynamicResource MoreImageSettingsSubtitle}"
                           Style="{StaticResource SubWindowSubtitle}"/>
            </StackPanel>
            <Button Style="{StaticResource SubWindowCloseButton}" Click="OnBackClick">
                <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/>
            </Button>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource WarningSurfaceBrush}"
                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                CornerRadius="12" Padding="14,11">
            <TextBlock Text="{DynamicResource ImageAdjustmentsPreviewOnlyNotice}"
                       Foreground="{DynamicResource WarningBrush}" FontSize="{DynamicResource SecondaryFontSize}"
                       TextWrapping="Wrap"/>
        </Border>

        <Border x:Name="AdjustmentPanel" Grid.Row="4"
                Style="{StaticResource SettingsSection}" Padding="20,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                <Grid>
                    <TextBlock Text="{DynamicResource BrightnessLabel}" Style="{StaticResource AdjustmentLabel}"/>
                    <TextBlock Text="{Binding ElementName=BrightnessSlider, Path=Value, StringFormat={}{0:F0}}"
                               Style="{StaticResource AdjustmentValue}"/>
                </Grid>
                <Slider x:Name="BrightnessSlider" AutomationProperties.Name="{DynamicResource BrightnessLabel}" Minimum="-100" Maximum="100"
                        TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,0"
                        ValueChanged="OnAdjustmentValueChanged"/>

                <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="0,16"/>
                <Grid>
                    <TextBlock Text="{DynamicResource ContrastLabel}" Style="{StaticResource AdjustmentLabel}"/>
                    <TextBlock Text="{Binding ElementName=ContrastSlider, Path=Value, StringFormat={}{0:F0}%}"
                               Style="{StaticResource AdjustmentValue}"/>
                </Grid>
                <Slider x:Name="ContrastSlider" AutomationProperties.Name="{DynamicResource ContrastLabel}" Minimum="0" Maximum="200"
                        TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,0"
                        ValueChanged="OnAdjustmentValueChanged"/>

                <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="0,16"/>
                <Grid>
                    <TextBlock Text="{DynamicResource SaturationLabel}" Style="{StaticResource AdjustmentLabel}"/>
                    <TextBlock Text="{Binding ElementName=SaturationSlider, Path=Value, StringFormat={}{0:F0}%}"
                               Style="{StaticResource AdjustmentValue}"/>
                </Grid>
                <Slider x:Name="SaturationSlider" AutomationProperties.Name="{DynamicResource SaturationLabel}" Minimum="0" Maximum="200"
                        TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,0"
                        ValueChanged="OnAdjustmentValueChanged"/>

                <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="0,16"/>
                <Grid>
                    <TextBlock Text="{DynamicResource GammaLabel}" Style="{StaticResource AdjustmentLabel}"/>
                    <TextBlock Text="{Binding ElementName=GammaSlider, Path=Value, StringFormat={}{0:F0}%}"
                               Style="{StaticResource AdjustmentValue}"/>
                </Grid>
                <Slider x:Name="GammaSlider" AutomationProperties.Name="{DynamicResource GammaLabel}" Minimum="50" Maximum="200"
                        TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,0"
                        ValueChanged="OnAdjustmentValueChanged"/>
            </StackPanel></ScrollViewer>
        </Border>

        <TextBlock x:Name="FeedbackText" Grid.Row="5"
                   Foreground="{DynamicResource WarningBrush}" FontSize="{DynamicResource CaptionFontSize}"
                   TextWrapping="Wrap" Margin="0,8,0,10"/>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="ResetButton" Content="{DynamicResource ResetImageSettings}" MinWidth="108"
                    Click="OnResetClick"/>
            <Button Grid.Column="2" Content="{DynamicResource BackImageSettings}" MinWidth="96"
                    Click="OnBackClick"/>
            <Button x:Name="SaveButton" Grid.Column="4" Content="{DynamicResource Save}" MinWidth="108"
                    Style="{StaticResource PrimaryButton}" IsDefault="True"
                    Click="OnSaveClick"/>
        </Grid>
    </Grid>
</chrome:RoundedWindow>
