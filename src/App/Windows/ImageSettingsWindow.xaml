<ui:FluentWindow x:Class="IPhoneMirror.App.Windows.ImageSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource MoreImageSettingsTitle}"
        Width="560" Height="650" MinWidth="520" MinHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica" WindowCornerPreference="Round"
        PreviewKeyDown="OnPreviewKeyDown"
        Closing="OnWindowClosing"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
    <ui:FluentWindow.Resources>
        <Style x:Key="AdjustmentLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="AdjustmentValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Style="{StaticResource SubWindowPageRoot}"
          animations:PageTransition.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Style="{StaticResource SubWindowHeader}"
              animations:WindowDragBehavior.IsEnabled="True">
            <StackPanel Margin="0,0,48,0">
                <TextBlock Text="{DynamicResource MoreImageSettingsTitle}"
                           Style="{StaticResource SubWindowTitle}"/>
                <TextBlock Text="{DynamicResource MoreImageSettingsSubtitle}"
                           Style="{StaticResource SubWindowSubtitle}"/>
            </StackPanel>
            <Button Style="{StaticResource SubWindowCloseButton}" Click="OnBackClick">
                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8BB;" FontSize="14"/>
            </Button>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource WarningSurfaceBrush}"
                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                CornerRadius="12" Padding="14,11">
            <TextBlock Text="{DynamicResource ImageAdjustmentsPreviewOnlyNotice}"
                       Foreground="{DynamicResource WarningBrush}" FontSize="12"
                       LineHeight="18" TextWrapping="Wrap"/>
        </Border>

        <Border x:Name="AdjustmentPanel" Grid.Row="4"
                Style="{StaticResource SettingsSection}" Padding="20,16">
            <StackPanel>
                <Grid>
                    <TextBlock Text="{DynamicResource BrightnessLabel}" Style="{StaticResource AdjustmentLabel}"/>
                    <TextBlock Text="{Binding ElementName=BrightnessSlider, Path=Value, StringFormat={}{0:F0}}"
                               Style="{StaticResource AdjustmentValue}"/>
                </Grid>
                <Slider x:Name="BrightnessSlider" Minimum="-100" Maximum="100"
                        TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,0"
                        ValueChanged="OnAdjustmentValueChanged"/>

                <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="0,16"/>
                <Grid>
                    <TextBlock Text="{DynamicResource ContrastLabel}" Style="{StaticResource AdjustmentLabel}"/>
                    <TextBlock Text="{Binding ElementName=ContrastSlider, Path=Value, StringFormat={}{0:F0}%}"
                               Style="{StaticResource AdjustmentValue}"/>
                </Grid>
                <Slider x:Name="ContrastSlider" Minimum="0" Maximum="200"
                        TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,0"
                        ValueChanged="OnAdjustmentValueChanged"/>

                <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="0,16"/>
                <Grid>
                    <TextBlock Text="{DynamicResource SaturationLabel}" Style="{StaticResource AdjustmentLabel}"/>
                    <TextBlock Text="{Binding ElementName=SaturationSlider, Path=Value, StringFormat={}{0:F0}%}"
                               Style="{StaticResource AdjustmentValue}"/>
                </Grid>
                <Slider x:Name="SaturationSlider" Minimum="0" Maximum="200"
                        TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,0"
                        ValueChanged="OnAdjustmentValueChanged"/>

                <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="0,16"/>
                <Grid>
                    <TextBlock Text="{DynamicResource GammaLabel}" Style="{StaticResource AdjustmentLabel}"/>
                    <TextBlock Text="{Binding ElementName=GammaSlider, Path=Value, StringFormat={}{0:F0}%}"
                               Style="{StaticResource AdjustmentValue}"/>
                </Grid>
                <Slider x:Name="GammaSlider" Minimum="50" Maximum="200"
                        TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,0"
                        ValueChanged="OnAdjustmentValueChanged"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="FeedbackText" Grid.Row="5"
                   Foreground="{DynamicResource WarningBrush}" FontSize="11"
                   TextWrapping="Wrap" Margin="0,8,0,10"/>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="ResetButton" Content="{DynamicResource ResetImageSettings}" Width="108"
                    Click="OnResetClick"/>
            <Button Grid.Column="2" Content="{DynamicResource BackImageSettings}" Width="96"
                    Click="OnBackClick"/>
            <Button x:Name="SaveButton" Grid.Column="4" Content="{DynamicResource Save}" Width="108"
                    Style="{StaticResource PrimaryButton}" IsDefault="True"
                    Click="OnSaveClick"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
