<ui:FluentWindow x:Class="IPhoneMirror.App.Windows.CaptureStatusNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="440" SizeToContent="Height" MinHeight="210"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None" WindowCornerPreference="Round"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
    <Border Style="{StaticResource ModernDialogSurface}"
            Background="{DynamicResource DialogSurfaceBrush}"
            Margin="0" Padding="20" BorderThickness="0"
            CornerRadius="0" Effect="{x:Null}">
        <Grid animations:PageTransition.IsEnabled="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Style="{StaticResource SubWindowHeader}"
                  animations:WindowDragBehavior.IsEnabled="True">
                <TextBlock Text="{Binding TitleText}"
                           Style="{StaticResource SubWindowTitle}" Margin="0,0,48,0"/>
                <Button Style="{StaticResource SubWindowCloseButton}"
                        Click="OnCloseClick">
                    <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}"
                                   Symbol="Dismiss20" FontSize="18"/>
                </Button>
            </Grid>

            <Border Grid.Row="2" BorderThickness="1" CornerRadius="12"
                    Padding="14">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background"
                                Value="{DynamicResource ErrorSurfaceBrush}"/>
                        <Setter Property="BorderBrush"
                                Value="{DynamicResource ErrorBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource WarningSurfaceBrush}"/>
                                <Setter Property="BorderBrush"
                                        Value="{DynamicResource WarningBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="15"
                            VerticalAlignment="Top">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background"
                                        Value="{DynamicResource ErrorBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                        <Setter Property="Background"
                                                Value="{DynamicResource WarningBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <ui:SymbolIcon Symbol="ErrorCircle20" FontSize="17"
                                           Foreground="{DynamicResource OnAccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStopped}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <ui:SymbolIcon Symbol="Warning20" FontSize="17"
                                           Foreground="{DynamicResource OnAccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStopped}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <ui:SymbolIcon Symbol="UsbPlug20" FontSize="17"
                                           Foreground="{DynamicResource OnAccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUsbConfiguration}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="{Binding BadgeText}"
                                   FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding BodyText}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource ControlFillBrush}"
                        BorderBrush="{DynamicResource BorderSoftBrush}"
                        BorderThickness="1" CornerRadius="15"
                        Padding="10,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowClockwise20"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="14" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding HintText}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button Grid.Column="1" Content="{DynamicResource Close}"
                        Click="OnCloseClick" MinWidth="80" Height="36" Margin="12,0,0,0"
                        Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </Grid>
    </Border>
</ui:FluentWindow>
