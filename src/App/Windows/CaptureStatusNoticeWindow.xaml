<chrome:RoundedWindow x:Class="IPhoneMirror.App.Windows.CaptureStatusNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
        Title="{Binding TitleText}" Width="486" SizeToContent="Height" MaxHeight="622"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Padding="24" Style="{StaticResource RoundedWindowContent}">
        <Grid animations:PageTransition.IsEnabled="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="NoticeHeader" Style="{StaticResource SubWindowHeader}"
                  animations:WindowDragBehavior.IsEnabled="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="HeaderIcon">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource NoticeHeaderIcon}">
                            <Setter Property="Background" Value="{DynamicResource ErrorSurfaceBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ui:SymbolIcon FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="ErrorCircle20"/>
                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                        <Setter Property="Symbol" Value="Warning20"/>
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsUsbConfiguration}" Value="True">
                                        <Setter Property="Symbol" Value="UsbPlug20"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                </Border>
                <TextBlock x:Name="HeaderTitle" Grid.Column="1" Text="{Binding TitleText}"
                           Style="{StaticResource NoticeHeaderTitle}"/>
                <Button x:Name="HeaderClose" Grid.Column="2" Style="{StaticResource NoticeHeaderCloseButton}"
                        AutomationProperties.Name="{DynamicResource Close}" Click="OnCloseClick">
                    <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="0,16,0,0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{Binding BodyText}" TextWrapping="Wrap" Style="{StaticResource BodyText}"/>
                    <StackPanel x:Name="DiagnosticPanel" Margin="0,8,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDiagnostics}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                    <Border x:Name="FailureDetails" Margin="0,8,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource NoticeDetailsSurface}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFailure}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="{DynamicResource CaptureFailureStageLabel}"
                                           TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="{DynamicResource CaptionFontSize}"/>
                                <TextBlock Text="{Binding FailureStageText}" TextWrapping="Wrap"
                                           Style="{StaticResource BodyText}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{DynamicResource CaptureFailureCodeLabel}"
                                           TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="{DynamicResource CaptionFontSize}"/>
                                <TextBlock Text="{Binding FailureCodeText}" TextWrapping="Wrap"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="{DynamicResource CaptionFontSize}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBox x:Name="TechnicalDetailsText" Text="{Binding TechnicalDetails, Mode=OneWay}" Margin="0,10,0,0"
                             AutomationProperties.Name="{DynamicResource ErrorTechnicalDetails}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource NoticeDiagnosticText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTechnicalDetails}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <TextBlock x:Name="CopyFeedback" TextAlignment="Right" Margin="0,0,0,8"
                           AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <WrapPanel x:Name="NoticeActions" Style="{StaticResource DialogActions}" Margin="0">
                    <Button x:Name="CopyDiagnosticsButton" Content="{DynamicResource CaptureCopyDiagnostics}"
                            Click="OnCopyDiagnosticsClick" Margin="0,0,8,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDiagnostics}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="CloseButton" MinWidth="92" Content="{DynamicResource Close}" Click="OnCloseClick"
                            IsCancel="True" Margin="0,0,0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRecoveryAction}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ControlFillBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="RecoveryButton" Content="{Binding RecoveryActionText}" Click="OnRecoveryClick"
                            MinWidth="92" IsDefault="True" Margin="8,0,0,4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRecoveryAction}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Grid>
    </Border>
</chrome:RoundedWindow>
