<chrome:RoundedWindow x:Class="IPhoneMirror.App.Windows.AdvancedSettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="{DynamicResource AdvancedSettingsTitle}" Width="542" SizeToContent="Height" MaxHeight="560" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Foreground="{DynamicResource TextBrush}"
        xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
 <chrome:RoundedWindow.Resources>
  <Style x:Key="UsbSizeField" TargetType="TextBox" BasedOn="{StaticResource ReceiverTextBox}">
   <Setter Property="Height" Value="Auto"/>
   <Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}"/>
   <Setter Property="Padding" Value="{StaticResource InputPadding}"/>
  </Style>
 </chrome:RoundedWindow.Resources>
 <Grid Style="{StaticResource SubWindowPageRoot}" animations:PageTransition.IsEnabled="True">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*" MinHeight="{StaticResource DialogContentMinHeight}"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Style="{StaticResource SubWindowHeader}"
        animations:WindowDragBehavior.IsEnabled="True">
   <TextBlock Text="{DynamicResource AdvancedSettingsTitle}" Style="{StaticResource SubWindowTitle}" Margin="0,0,48,0"/>
   <Button Style="{StaticResource SubWindowCloseButton}" Click="OnCloseClick">
    <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/>
   </Button>
  </Grid>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <Border Style="{StaticResource SettingsSection}" VerticalAlignment="Top">
   <StackPanel>
    <TextBlock Text="{DynamicResource AdvancedUsbResolution}" Style="{StaticResource SubWindowSectionTitle}"/>
    <TextBlock Text="{DynamicResource AdvancedUsbSizeHint}" Style="{StaticResource SecondaryText}" Margin="0,4,0,10"/>
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBlock Text="{DynamicResource WidthLabel}" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
     <TextBlock Grid.Column="2" Text="{DynamicResource HeightLabel}" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
     <TextBox x:Name="WidthBox" Grid.Row="1" AutomationProperties.Name="{DynamicResource WidthLabel}" Style="{StaticResource UsbSizeField}"/>
     <TextBlock Grid.Row="1" Grid.Column="1" Text="×" Foreground="{DynamicResource MutedTextBrush}"
                HorizontalAlignment="Center" VerticalAlignment="Center"/>
     <TextBox x:Name="HeightBox" Grid.Row="1" Grid.Column="2" AutomationProperties.Name="{DynamicResource HeightLabel}" Style="{StaticResource UsbSizeField}"/>
    </Grid>
    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
     <TextBlock.Style>
      <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
       <Setter Property="Margin" Value="0,10,0,0"/>
       <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
      </Style>
     </TextBlock.Style>
    </TextBlock>
   </StackPanel>
   </Border>
  </ScrollViewer>
  <Border Grid.Row="4" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
   <WrapPanel HorizontalAlignment="Right">
    <Button Content="{DynamicResource DisableAdvancedMode}" Click="OnDisableClick" Margin="0,0,8,0"/>
    <Button Content="{DynamicResource Apply}" MinWidth="112" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnApplyClick"/>
   </WrapPanel>
  </Border>
 </Grid>
</chrome:RoundedWindow>
