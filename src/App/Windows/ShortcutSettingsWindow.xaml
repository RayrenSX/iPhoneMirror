<chrome:RoundedWindow x:Class="IPhoneMirror.App.Windows.ShortcutSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource ShortcutSettingsTitle}"
        Width="620" Height="760" MinWidth="522" MinHeight="542"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Foreground="{DynamicResource TextBrush}"
        xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <chrome:RoundedWindow.Resources>
        <Style x:Key="ShortcutCaptureBox" TargetType="TextBox" BasedOn="{StaticResource RoundedTextBox}">
            <Setter Property="FontSize" Value="{DynamicResource FontSize16}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CaretBrush" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBound}" Value="False">
                    <Setter Property="FontSize" Value="{DynamicResource FontSize13}"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ShortcutClearButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="ToolTip" Value="{DynamicResource ShortcutSettingsReset}"/>
            <Setter Property="AutomationProperties.Name" Value="{DynamicResource ShortcutSettingsReset}"/>
        </Style>
        <Style x:Key="SettingShortcutCaptureBox" TargetType="TextBox" BasedOn="{StaticResource ShortcutCaptureBox}">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}">
                            <TextBlock Text="{TemplateBinding Text}" Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                       FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                       FontWeight="Normal" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </chrome:RoundedWindow.Resources>

    <Grid Style="{StaticResource SubWindowPageRoot}"
          animations:PageTransition.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*" MinHeight="{StaticResource DialogContentMinHeight}"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource SubWindowHeader}"
              animations:WindowDragBehavior.IsEnabled="True">
            <TextBlock Text="{DynamicResource ShortcutSettingsTitle}"
                       Style="{StaticResource SubWindowTitle}" Margin="0,0,48,0"/>
            <Button Style="{StaticResource SubWindowCloseButton}" Click="OnCloseClick">
                <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/>
            </Button>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Visibility="{DynamicResource InterfaceDescriptionsVisibility}" Text="{DynamicResource ShortcutSettingsDescription}"
                       Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}"
                       TextWrapping="Wrap" Margin="0,0,0,12"/>
            <ScrollViewer Grid.Row="1"
                          Margin="0,0,0,12"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource CaptionFontSize}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,7"/>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <chrome:ResponsiveFieldRow Margin="0,0,0,12">
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                       TextWrapping="Wrap"/>
                                            <TextBox Grid.Column="1" Text="{Binding ShortcutText, Mode=OneWay}"
                                                      Style="{StaticResource ShortcutCaptureBox}" MinHeight="40"
                                                      PreviewKeyDown="OnShortcutPreviewKeyDown"
                                                      PreviewMouseDown="OnShortcutPreviewMouseDown"
                                                      ToolTip="{DynamicResource ShortcutSettingsCaptureHint}"
                                                     shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                                            <Button Grid.Column="2" Click="OnResetRowClick"
                                                    Style="{StaticResource ShortcutClearButton}">
                                                <ui:SymbolIcon Symbol="ArrowCounterclockwise20" FontSize="18"
                                                               Foreground="{DynamicResource MutedTextBrush}"/>
                                            </Button>
                                        </chrome:ResponsiveFieldRow>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,16"/>
            <TextBlock x:Name="MoreSettingsHeading" Text="{DynamicResource SettingShortcutsTitle}" FontWeight="SemiBold"
                       FontSize="{DynamicResource FontSize16}"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <TextBlock Visibility="{DynamicResource InterfaceDescriptionsVisibility}" Text="{DynamicResource SettingShortcutsDescription}" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}" Margin="0,0,0,12"/>
            <ItemsControl ItemsSource="{Binding SettingRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                        <StackPanel TextBlock.FontSize="{DynamicResource FontSize14}">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding CardTitle}" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Click="OnRemoveSettingShortcut" Style="{StaticResource IconButton}"
                                        Width="28" Height="28" MinHeight="28" Padding="4"
                                        ToolTip="{DynamicResource SettingShortcutsRemove}"
                                        AutomationProperties.Name="{DynamicResource SettingShortcutsRemove}">
                                    <ui:SymbolIcon Symbol="Dismiss20" FontSize="16"/>
                                </Button>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{DynamicResource SettingShortcutsSetting}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,12,0" TextWrapping="Wrap"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding SettingLabels}" SelectedIndex="{Binding SettingIndex}"
                                          Height="40" MinHeight="40" Padding="12,0" FontSize="{DynamicResource FontSize14}"
                                          AutomationProperties.Name="{DynamicResource SettingShortcutsSetting}"/>
                                <TextBlock Grid.Row="2" Text="{DynamicResource SettingShortcutsKey}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,12,0" TextWrapping="Wrap"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ShortcutText, Mode=OneWay}"
                                         Style="{StaticResource SettingShortcutCaptureBox}" Height="40" MinHeight="40" Padding="12,0"
                                         FontSize="{DynamicResource FontSize14}" FontWeight="Normal" HorizontalContentAlignment="Left"
                                         PreviewKeyDown="OnShortcutPreviewKeyDown" PreviewMouseDown="OnShortcutPreviewMouseDown"
                                         AutomationProperties.Name="{DynamicResource ShortcutSettingsCaptureHint}"
                                         ToolTip="{DynamicResource ShortcutSettingsCaptureHint}"/>
                                <TextBlock Grid.Row="4" Text="{DynamicResource SettingShortcutsTrigger}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,12,0" TextWrapping="Wrap"/>
                                <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding TriggerLabels}" SelectedIndex="{Binding TriggerIndex}"
                                          Height="40" MinHeight="40" Padding="12,0" FontSize="{DynamicResource FontSize14}"
                                          AutomationProperties.Name="{DynamicResource SettingShortcutsTrigger}"/>
                            </Grid>
                            <Border BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,12"/>
                            <StackPanel Visibility="{Binding OpacityVisibility}">
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="{Binding TargetLabel}" FontSize="{DynamicResource FontSize14}"/>
                                    <TextBlock Text="{Binding Value, StringFormat={}{0:0}%}" HorizontalAlignment="Right"
                                               FontSize="{DynamicResource FontSize14}" FontWeight="SemiBold"/>
                                </DockPanel>
                                <Slider Minimum="10" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                        MinHeight="24" Value="{Binding Value}" AutomationProperties.Name="{Binding TargetLabel}"/>
                            </StackPanel>
                            <CheckBox Visibility="{Binding BooleanVisibility}" IsChecked="{Binding BooleanValue}"
                                      Content="{Binding BooleanLabel}"/>
                            <TextBlock Visibility="{DynamicResource InterfaceDescriptionsVisibility}" Text="{Binding TriggerDescription}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="{DynamicResource SettingShortcutsAdd}" Click="OnAddSettingShortcut"
                    IsEnabled="{Binding CanAddSettingShortcut}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
            </StackPanel>
            </ScrollViewer>
            <TextBlock Visibility="{DynamicResource InterfaceDescriptionsVisibility}" Text="{DynamicResource ShortcutSettingsCaptureHint}"
                       Grid.Row="2"
                       Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}"
                       TextWrapping="Wrap" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource ErrorBrush}"
                       Grid.Row="3"
                       FontSize="{DynamicResource CaptionFontSize}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="{DynamicResource Cancel}" Click="OnCloseClick"
                    MinWidth="84"/>
            <Button Grid.Column="3" Content="{DynamicResource Save}" IsDefault="True" Click="OnSaveClick"
                    Style="{StaticResource PrimaryButton}" MinWidth="96"/>
        </Grid>
    </Grid>
</chrome:RoundedWindow>
