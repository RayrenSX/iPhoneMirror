<chrome:RoundedWindow x:Class="IPhoneMirror.App.Windows.ShortcutSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource ShortcutSettingsTitle}"
        Width="620" Height="760" MinWidth="522" MinHeight="542"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Foreground="{DynamicResource TextBrush}"
        xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <chrome:RoundedWindow.Resources>
        <Thickness x:Key="ShortcutContentInset">12,0,12,0</Thickness>
        <Style x:Key="ShortcutCaptureBox" TargetType="TextBox" BasedOn="{StaticResource RoundedTextBox}">
            <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CaretBrush" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBound}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ShortcutFilterChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Segment" Background="Transparent" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="{DynamicResource ComboItemSelectedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ShortcutClearButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="ToolTip" Value="{DynamicResource ShortcutSettingsReset}"/>
            <Setter Property="AutomationProperties.Name" Value="{DynamicResource ShortcutSettingsReset}"/>
        </Style>
        <Style x:Key="SettingShortcutCaptureBox" TargetType="TextBox" BasedOn="{StaticResource ShortcutCaptureBox}">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}">
                            <TextBlock Text="{TemplateBinding Text}" Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                       FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                       FontWeight="Normal" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ShortcutFilterRow" TargetType="chrome:ResponsiveFieldRow">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsBound}" Value="False"/>
                        <Condition Binding="{Binding DataContext.ShowBoundOnly, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Collapsed"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </chrome:RoundedWindow.Resources>

    <Grid Style="{StaticResource SubWindowPageRoot}"
          animations:PageTransition.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*" MinHeight="{StaticResource DialogContentMinHeight}"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource SubWindowHeader}" Margin="{StaticResource ShortcutContentInset}"
              animations:WindowDragBehavior.IsEnabled="True">
            <TextBlock Text="{DynamicResource ShortcutSettingsTitle}"
                       Style="{StaticResource SubWindowTitle}" Margin="0,0,48,0"/>
            <Button Style="{StaticResource SubWindowCloseButton}" Click="OnCloseClick">
                <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/>
            </Button>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="{StaticResource ShortcutContentInset}">
                <TextBlock Visibility="{DynamicResource InterfaceDescriptionsVisibility}" Text="{DynamicResource ShortcutSettingsDescription}"
                           Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}"
                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                <Border x:Name="ShortcutFilterSurface" HorizontalAlignment="Left" Margin="0,0,0,16"
                        Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="2">
                    <UniformGrid Columns="2" AutomationProperties.Name="{DynamicResource ShortcutFilterTitle}">
                        <RadioButton x:Name="ShortcutFilterAll" GroupName="ShortcutFilter" IsChecked="True"
                                     Style="{StaticResource ShortcutFilterChoice}" Content="{DynamicResource ShortcutFilterAll}"/>
                        <RadioButton x:Name="ShortcutFilterBound" GroupName="ShortcutFilter"
                                     Style="{StaticResource ShortcutFilterChoice}" Content="{DynamicResource ShortcutFilterBound}"/>
                    </UniformGrid>
                </Border>
            </StackPanel>
            <ScrollViewer x:Name="ShortcutListScrollViewer" Grid.Row="1"
                          Margin="0,0,0,12" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer" BasedOn="{StaticResource ContentScrollViewerStyle}">
                    <Setter Property="Padding" Value="{StaticResource ShortcutContentInset}"/>
                    <Style.Triggers>
                        <!-- The shared template reserves 12 DIPs on both sides of
                             the content when its scrollbar is visible. -->
                        <Trigger Property="ComputedVerticalScrollBarVisibility" Value="Visible">
                            <Setter Property="Padding" Value="0"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel>
            <ItemsControl x:Name="ShortcutSections" ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="ShortcutGroupCard" Margin="0,0,0,12" Padding="12,10,12,5" CornerRadius="10"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderSoftBrush}"
                                Background="{DynamicResource CardBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasBoundRows}" Value="False"/>
                                                <Condition Binding="{Binding DataContext.ShowBoundOnly, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <chrome:ResponsiveFieldRow Margin="0,0,0,5" Style="{StaticResource ShortcutFilterRow}">
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                       TextWrapping="Wrap"/>
                                            <TextBox Grid.Column="1" Text="{Binding ShortcutText, Mode=OneWay}"
                                                      Style="{StaticResource ShortcutCaptureBox}" Width="156" TextWrapping="Wrap"
                                                      HorizontalAlignment="Right" AutomationProperties.Name="{Binding Label}"
                                                      PreviewKeyDown="OnShortcutPreviewKeyDown"
                                                      PreviewMouseDown="OnShortcutPreviewMouseDown"
                                                      ToolTip="{DynamicResource ShortcutSettingsCaptureHint}"
                                                     shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                                            <Button Grid.Column="2" Click="OnResetRowClick"
                                                    Style="{StaticResource ShortcutClearButton}">
                                                <ui:SymbolIcon Symbol="ArrowCounterclockwise20" FontSize="18"
                                                               Foreground="{DynamicResource MutedTextBrush}"/>
                                            </Button>
                                        </chrome:ResponsiveFieldRow>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowSettingShortcutSection}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,16"/>
            <TextBlock x:Name="MoreSettingsHeading" Text="{DynamicResource SettingShortcutsTitle}" FontWeight="SemiBold"
                       FontSize="{DynamicResource FontSize16}"
                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <TextBlock Visibility="{DynamicResource InterfaceDescriptionsVisibility}" Text="{DynamicResource SettingShortcutsDescription}" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}" Margin="0,0,0,12"/>
            <ItemsControl ItemsSource="{Binding SettingRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsBound}" Value="False"/>
                                            <Condition Binding="{Binding DataContext.ShowBoundOnly, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel TextBlock.FontSize="{DynamicResource FontSize14}">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding CardTitle}" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Click="OnRemoveSettingShortcut" Style="{StaticResource IconButton}"
                                        Width="28" Height="28" MinHeight="28" Padding="4"
                                        ToolTip="{DynamicResource SettingShortcutsRemove}"
                                        AutomationProperties.Name="{DynamicResource SettingShortcutsRemove}">
                                    <ui:SymbolIcon Symbol="Dismiss20" FontSize="16"/>
                                </Button>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{DynamicResource SettingShortcutsSetting}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,12,0" TextWrapping="Wrap"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding SettingLabels}" SelectedIndex="{Binding SettingIndex}"
                                          Height="40" MinHeight="40" Padding="12,0" FontSize="{DynamicResource FontSize14}"
                                          AutomationProperties.Name="{DynamicResource SettingShortcutsSetting}"/>
                                <TextBlock Grid.Row="2" Text="{DynamicResource SettingShortcutsKey}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,12,0" TextWrapping="Wrap"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ShortcutText, Mode=OneWay}"
                                         Style="{StaticResource SettingShortcutCaptureBox}" Height="40" MinHeight="40" Padding="12,0"
                                         FontSize="{DynamicResource FontSize14}" FontWeight="Normal" HorizontalContentAlignment="Left"
                                         PreviewKeyDown="OnShortcutPreviewKeyDown" PreviewMouseDown="OnShortcutPreviewMouseDown"
                                         AutomationProperties.Name="{DynamicResource ShortcutSettingsCaptureHint}"
                                         ToolTip="{DynamicResource ShortcutSettingsCaptureHint}"/>
                            </Grid>
                            <StackPanel Visibility="{Binding SettingControlsVisibility}">
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource SettingShortcutsTrigger}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,12,0" TextWrapping="Wrap"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding TriggerLabels}" SelectedIndex="{Binding TriggerIndex}"
                                              Height="40" MinHeight="40" Padding="12,0" FontSize="{DynamicResource FontSize14}"
                                              AutomationProperties.Name="{DynamicResource SettingShortcutsTrigger}"/>
                                </Grid>
                                <Border BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,12"/>
                                <StackPanel Visibility="{Binding OpacityVisibility}">
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding TargetLabel}" FontSize="{DynamicResource FontSize14}"/>
                                        <TextBlock Text="{Binding Value, StringFormat={}{0:0}%}" HorizontalAlignment="Right"
                                                   FontSize="{DynamicResource FontSize14}" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <Slider Minimum="10" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                            MinHeight="24" Value="{Binding Value}" AutomationProperties.Name="{Binding TargetLabel}"/>
                                </StackPanel>
                                <CheckBox Visibility="{Binding BooleanVisibility}" IsChecked="{Binding BooleanValue}"
                                          Content="{Binding BooleanLabel}"/>
                                <TextBlock Visibility="{DynamicResource InterfaceDescriptionsVisibility}" Text="{Binding TriggerDescription}" TextWrapping="Wrap" Margin="0,10,0,0"
                                           FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource MutedTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="{DynamicResource SettingShortcutsAdd}" Click="OnAddSettingShortcut"
                    IsEnabled="{Binding CanAddSettingShortcut}" HorizontalAlignment="Left" Margin="0,0,0,12">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowBoundOnly}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            </StackPanel>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,16"/>
            <TextBlock Text="{DynamicResource PreviewWindowsHotkeysTitle}" FontWeight="SemiBold"
                       FontSize="{DynamicResource FontSize16}" Foreground="{DynamicResource AccentBrush}"
                       Margin="0,0,0,8" TextWrapping="Wrap"/>
            <TextBlock Text="{DynamicResource PreviewWindowsHotkeysHelp}" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}" Margin="0,0,0,12"/>
            <TextBlock Text="{DynamicResource PreviewWindowsHotkeysAllow}" Margin="0,0,0,4"/>
            <TextBox x:Name="PreviewHotkeysAllow" Style="{StaticResource RoundedTextBox}" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                     MinLines="3" MaxLines="5" MaxLength="4096"
                     AutomationProperties.Name="{DynamicResource PreviewWindowsHotkeysAllow}"/>
            <TextBlock Text="{DynamicResource PreviewWindowsHotkeysBlock}" Margin="0,12,0,4"/>
            <TextBox x:Name="PreviewHotkeysBlock" Style="{StaticResource RoundedTextBox}" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                     MinLines="3" MaxLines="5" MaxLength="4096" Margin="0,0,0,8"
                     AutomationProperties.Name="{DynamicResource PreviewWindowsHotkeysBlock}"/>
            </StackPanel>
            </ScrollViewer>
            <TextBlock Visibility="{DynamicResource InterfaceDescriptionsVisibility}" Text="{DynamicResource ShortcutSettingsCaptureHint}"
                       Grid.Row="2"
                       Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}"
                       TextWrapping="Wrap" Margin="12,2,12,0"/>
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource ErrorBrush}"
                       Grid.Row="3"
                       AutomationProperties.LiveSetting="Polite"
                       FontSize="{DynamicResource CaptionFontSize}" TextWrapping="Wrap" Margin="12,8,12,0"/>
        </Grid>

        <Grid Grid.Row="4" Margin="{StaticResource ShortcutContentInset}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="{DynamicResource Cancel}" Click="OnCloseClick"
                    MinWidth="84"/>
            <Button x:Name="SaveButton" Grid.Column="3" Content="{DynamicResource Save}" IsDefault="True" Click="OnSaveClick"
                    Style="{StaticResource PrimaryButton}" MinWidth="96"/>
        </Grid>
    </Grid>
</chrome:RoundedWindow>
