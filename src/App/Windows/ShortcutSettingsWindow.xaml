<ui:FluentWindow x:Class="IPhoneMirror.App.Windows.ShortcutSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource ShortcutSettingsTitle}"
        Width="560" Height="650" MinWidth="500" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica" WindowCornerPreference="Round"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
    <ui:FluentWindow.Resources>
        <Style x:Key="ShortcutCaptureBox" TargetType="TextBox" BasedOn="{StaticResource RoundedTextBox}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CaretBrush" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBound}" Value="False">
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ShortcutClearButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource ShortcutClearIconBrush}"/>
            <Setter Property="ToolTip" Value="{DynamicResource ShortcutSettingsReset}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ClearRoot" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ClearRoot" Property="BorderBrush"
                                        Value="{DynamicResource FocusStrokeBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Style="{StaticResource SubWindowPageRoot}"
          animations:PageTransition.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource SubWindowHeader}"
              animations:WindowDragBehavior.IsEnabled="True">
            <TextBlock Text="{DynamicResource ShortcutSettingsTitle}"
                       Style="{StaticResource SubWindowTitle}"/>
            <Button Style="{StaticResource SubWindowCloseButton}" Click="OnCloseClick">
                <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/>
            </Button>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource ShortcutSettingsDescription}"
                       Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,0,0,12"/>
            <ScrollViewer Grid.Row="1" Margin="0,0,-25,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,7"/>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                       FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBox Grid.Column="1" Text="{Binding ShortcutText, Mode=OneWay}"
                                                     Style="{StaticResource ShortcutCaptureBox}" Height="40"
                                                     PreviewKeyDown="OnShortcutPreviewKeyDown"
                                                     ToolTip="{DynamicResource ShortcutSettingsCaptureHint}"
                                                     shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                                            <Button Grid.Column="2" Click="OnResetRowClick"
                                                    Style="{StaticResource ShortcutClearButton}">
                                                <ui:SymbolIcon Symbol="Delete20" FontSize="18"
                                                               Foreground="{DynamicResource ShortcutClearIconBrush}"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="{DynamicResource ShortcutSettingsCaptureHint}"
                       Grid.Row="2"
                       Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource ErrorBrush}"
                       Grid.Row="3"
                       FontSize="11" TextWrapping="Wrap" MinHeight="20" Margin="0,8,0,0"/>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="{DynamicResource Cancel}" Click="OnCloseClick"
                    MinWidth="84"/>
            <Button Grid.Column="3" Content="{DynamicResource Save}" Click="OnSaveClick"
                    Style="{StaticResource PrimaryButton}" MinWidth="96"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
