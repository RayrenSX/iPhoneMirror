<UserControl x:Class="IPhoneMirror.App.Windows.MappingWizard.ActionSelectionStep"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <ListBox x:Name="ActionBox" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
   HorizontalContentAlignment="Stretch" AutomationProperties.Name="{DynamicResource MappingAction}">
  <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate></ListBox.ItemsPanel>
  <ListBox.ItemContainerStyle>
   <Style TargetType="ListBoxItem">
    <Setter Property="Margin" Value="6"/><Setter Property="Padding" Value="16"/><Setter Property="Width" Value="200"/>
    <Setter Property="MinHeight" Value="112"/><Setter Property="Background" Value="{DynamicResource CardBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
     <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
       CornerRadius="{StaticResource CardCornerRadius}" Padding="{TemplateBinding Padding}">
      <Grid><ContentPresenter/><ui:SymbolIcon x:Name="SelectedMark" Symbol="Checkmark20" Visibility="Collapsed"
        Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"/></Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ControlHoverBrush}"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
       <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
  </ListBox.ItemContainerStyle>
  <ListBox.ItemTemplate><DataTemplate><StackPanel>
   <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="22" HorizontalAlignment="Left" Margin="0,0,0,8"/>
   <TextBlock Text="{Binding Label}" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
   <TextBlock Text="{Binding Hint}" Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
  </StackPanel></DataTemplate></ListBox.ItemTemplate>
 </ListBox>
</UserControl>
