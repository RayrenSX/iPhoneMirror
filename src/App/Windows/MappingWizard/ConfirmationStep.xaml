<UserControl x:Class="IPhoneMirror.App.Windows.MappingWizard.ConfirmationStep"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="VisibleWhen"/></UserControl.Resources>
 <Border Style="{StaticResource CardBorder}" Padding="24" MaxWidth="420" VerticalAlignment="Center">
  <StackPanel>
   <TextBlock Text="{DynamicResource MappingKey}" Style="{StaticResource CaptionText}"/>
   <TextBlock Text="{Binding KeyText}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,20" TextWrapping="Wrap"/>
   <TextBlock Text="{DynamicResource MappingAction}" Style="{StaticResource CaptionText}"/>
   <TextBlock Text="{Binding ActionText}" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,4,0,4"/>
   <TextBlock Text="{Binding ParameterText}" Style="{StaticResource SecondaryText}"/>
   <TextBlock Text="{DynamicResource WizardPositionLabel}" Style="{StaticResource CaptionText}" Margin="0,20,0,4"/>
   <TextBlock Text="{Binding PositionText}" Style="{StaticResource BodyText}"/>
   <CheckBox Visibility="{Binding CanReleaseAfter, Converter={StaticResource VisibleWhen}}" IsChecked="{Binding ReleasePointerAfter}" Margin="0,16,0,0"><TextBlock Text="{DynamicResource MappingReleaseAfter}" TextWrapping="Wrap"/></CheckBox>
 </StackPanel>
 </Border>
</UserControl>
