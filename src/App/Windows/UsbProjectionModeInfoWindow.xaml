<chrome:RoundedWindow x:Class="IPhoneMirror.App.Windows.UsbProjectionModeInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource UsbModeDetailsTitle}"
        Width="562" Height="642" MinWidth="562" MinHeight="642"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Foreground="{DynamicResource TextBrush}"
        xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Grid Style="{StaticResource SubWindowPageRoot}"
          animations:PageTransition.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource SubWindowHeader}"
              animations:WindowDragBehavior.IsEnabled="True">
            <StackPanel Margin="0,0,48,0">
                <TextBlock x:Name="ModeTitle" Style="{StaticResource SubWindowTitle}"/>
                <TextBlock Text="{DynamicResource UsbModeDetailsTitle}"
                           Style="{StaticResource SubWindowSubtitle}"/>
            </StackPanel>
            <Button Style="{StaticResource SubWindowCloseButton}" Click="OnCloseClick">
                <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/>
            </Button>
        </Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
            <Border Style="{StaticResource SettingsSection}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource UsbModeAdvantageTitle}"
                               Style="{StaticResource SubWindowSectionTitle}"/>
                    <TextBlock x:Name="AdvantageText"
                               Style="{StaticResource SubWindowSubtitle}"
                               LineHeight="19" Margin="0,6,0,0"/>
                    <Border Height="1" Background="{DynamicResource BorderSoftBrush}"
                            Margin="0,18,0,16"/>
                    <TextBlock Text="{DynamicResource UsbModeDisadvantageTitle}"
                               Style="{StaticResource SubWindowSectionTitle}"/>
                    <TextBlock x:Name="DisadvantageText"
                               Style="{StaticResource SubWindowSubtitle}"
                               LineHeight="19" Margin="0,6,0,0"/>
                    <Border Background="{DynamicResource WarningSurfaceBrush}"
                            BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="14" Margin="0,18,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="18" Height="18"
                                    BorderBrush="{DynamicResource WarningBrush}"
                                    BorderThickness="1" CornerRadius="9"
                                    VerticalAlignment="Top">
                                <TextBlock Text="!" Foreground="{DynamicResource WarningBrush}"
                                           FontSize="{StaticResource CaptionFontSize}" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="NoticeText" Grid.Column="1"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="{StaticResource CaptionFontSize}" TextWrapping="Wrap" LineHeight="18"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>
        <Button Grid.Row="4" Content="{DynamicResource Close}" MinWidth="112" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                IsDefault="True" IsCancel="True" Click="OnCloseClick"/>
    </Grid>
</chrome:RoundedWindow>
