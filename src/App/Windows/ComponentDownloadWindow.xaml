<chrome:RoundedWindow x:Class="IPhoneMirror.App.Windows.ComponentDownloadWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
    Title="{DynamicResource UxPlayDownloadTitle}" Width="580" Height="400"
    MinWidth="480" MinHeight="400" WindowStartupLocation="CenterOwner"
    Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False"
    WindowStyle="None" AllowsTransparency="True" Background="Transparent"
    AutomationProperties.AutomationId="UxPlayDownloadWindow">
    <chrome:RoundedWindow.Resources>
        <BooleanToVisibilityConverter x:Key="RetryVisibility"/>
    </chrome:RoundedWindow.Resources>
    <Grid Style="{StaticResource SubWindowPageRoot}" animations:PageTransition.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*" MinHeight="{StaticResource DialogContentMinHeight}"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource SubWindowHeader}"
                    animations:WindowDragBehavior.IsEnabled="True">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{DynamicResource UxPlayDownloadTitle}" Style="{StaticResource SubWindowTitle}"/>
            <TextBlock Text="{DynamicResource UxPlayDownloadDescription}" TextWrapping="Wrap"
                       Style="{StaticResource SubWindowSubtitle}"/>
          </StackPanel>
          <Button Grid.Column="1" Style="{StaticResource SubWindowCloseButton}" Click="OnCancel"
                  ToolTip="{DynamicResource UxPlayDownloadCancel}" Margin="12,0,0,0" VerticalAlignment="Top">
              <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/>
          </Button>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource SettingsSection}" Padding="16">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
           <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource BodyText}" Margin="0,0,0,12"
                       AutomationProperties.AutomationId="UxPlayDownloadStatus"/>
            <ProgressBar Minimum="0" Maximum="100" Height="7"
                         Value="{Binding Percentage, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}"
                         AutomationProperties.AutomationId="UxPlayDownloadProgress"/>
            <TextBlock Text="{Binding DetailText}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,10,0,0"
                       AutomationProperties.AutomationId="UxPlayDownloadDetails"/>
           </StackPanel>
          </ScrollViewer>
        </Border>
        <WrapPanel Grid.Row="4" Style="{StaticResource DialogActions}">
            <Button Content="{DynamicResource UxPlayDownloadCancel}" Click="OnCancel" MinWidth="100"
                    Margin="{StaticResource DialogActionMargin}" AutomationProperties.AutomationId="UxPlayDownloadCancel"/>
            <Button Content="{DynamicResource UxPlayDownloadRetry}" Click="OnRetry" Margin="{StaticResource DialogActionMargin}"
                    Visibility="{Binding CanRetry, Converter={StaticResource RetryVisibility}}"
                    AutomationProperties.AutomationId="UxPlayDownloadRetry" IsDefault="{Binding CanRetry}"
                    Style="{StaticResource PrimaryButton}" MinWidth="100" IsEnabled="{Binding CanRetry}"/>
        </WrapPanel>
    </Grid>
</chrome:RoundedWindow>
