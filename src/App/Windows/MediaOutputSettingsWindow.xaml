<ui:FluentWindow x:Class="IPhoneMirror.App.Windows.MediaOutputSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource MediaOutputTitle}"
        Width="560" Height="660" MinWidth="500" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica" WindowCornerPreference="Round"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
    <ui:FluentWindow.Resources>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource PanelAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Style="{StaticResource SubWindowPageRoot}"
          animations:PageTransition.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Style="{StaticResource SubWindowHeader}"
              animations:WindowDragBehavior.IsEnabled="True">
            <StackPanel Margin="0,0,48,0">
                <TextBlock Text="{DynamicResource MediaOutputTitle}"
                           Style="{StaticResource SubWindowTitle}"/>
                <TextBlock Text="{Binding SelectedName}"
                           Style="{StaticResource SubWindowSubtitle}"/>
                <TextBlock Text="{Binding MediaOutputCapabilitiesText}" FontSize="10"
                           Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Style="{StaticResource SubWindowCloseButton}" Click="OnCloseClick">
                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8BB;" FontSize="14"/>
            </Button>
        </Grid>

        <TabControl Grid.Row="2" Style="{StaticResource SubWindowTabControl}">
            <TabItem Header="{DynamicResource RecordTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource RecordDescription}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource OutputWidth}" Style="{StaticResource DetailLabel}"/>
                                    <TextBox x:Name="RecordWidthBox" Style="{StaticResource RoundedTextBox}" Height="36"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource OutputHeight}" Style="{StaticResource DetailLabel}"/>
                                    <TextBox x:Name="RecordHeightBox" Style="{StaticResource RoundedTextBox}" Height="36"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource OutputFps}" Style="{StaticResource DetailLabel}"/>
                                    <TextBox x:Name="RecordFpsBox" Style="{StaticResource RoundedTextBox}" Height="36"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource OutputBitrate}" Style="{StaticResource DetailLabel}"/>
                                    <TextBox x:Name="RecordBitrateBox" Style="{StaticResource RoundedTextBox}" Height="36"/>
                                </StackPanel>
                            </Grid>
                            <Button x:Name="StartRecordingButton"
                                    Content="{DynamicResource StartRecording}" Click="OnStartRecordingClick"
                                    IsEnabled="False"
                                    Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource StreamTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource StreamDescription}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
                            <TextBlock Text="{DynamicResource StreamProtocol}" Style="{StaticResource DetailLabel}"/>
                            <ComboBox x:Name="StreamProtocolBox" SelectedIndex="0"
                                      SelectionChanged="OnStreamProtocolChanged">
                                <ComboBoxItem x:Name="RtmpProtocolItem" Content="RTMP"
                                              IsEnabled="{Binding DataContext.CanStreamRtmp, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <ComboBoxItem x:Name="SrtProtocolItem" Content="SRT"
                                              IsEnabled="{Binding DataContext.CanStreamSrt, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <ComboBoxItem x:Name="WhipProtocolItem" Content="WebRTC / WHIP"
                                              IsEnabled="{Binding DataContext.CanStreamWhip, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </ComboBox>
                            <TextBlock Text="{DynamicResource StreamDestination}" Style="{StaticResource DetailLabel}"/>
                            <TextBox x:Name="StreamDestinationBox" Style="{StaticResource RoundedTextBox}" Height="36"/>
                            <TextBlock Text="{DynamicResource StreamAuthorization}" Style="{StaticResource DetailLabel}"/>
                            <TextBox x:Name="StreamAuthorizationBox" Style="{StaticResource RoundedTextBox}" Height="36"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource OutputWidth}" Style="{StaticResource DetailLabel}"/>
                                    <TextBox x:Name="StreamWidthBox" Style="{StaticResource RoundedTextBox}" Height="36"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource OutputHeight}" Style="{StaticResource DetailLabel}"/>
                                    <TextBox x:Name="StreamHeightBox" Style="{StaticResource RoundedTextBox}" Height="36"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource OutputFps}" Style="{StaticResource DetailLabel}"/>
                                    <TextBox x:Name="StreamFpsBox" Style="{StaticResource RoundedTextBox}" Height="36"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource OutputBitrate}" Style="{StaticResource DetailLabel}"/>
                                    <TextBox x:Name="StreamBitrateBox" Style="{StaticResource RoundedTextBox}" Height="36"/>
                                </StackPanel>
                            </Grid>
                            <Button x:Name="StartStreamingButton"
                                    Content="{DynamicResource StartStreaming}" Click="OnStartStreamingClick"
                                    IsEnabled="False"
                                    Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource VirtualCameraTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource VirtualCameraDescription}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ResolutionLabel}"
                                           Style="{StaticResource DetailLabel}"/>
                                <ComboBox x:Name="VirtualCameraResolutionBox">
                                    <ComboBoxItem x:Name="VirtualCameraCurrentResolutionItem"
                                                  Visibility="Collapsed"/>
                                    <ComboBoxItem Content="1280 x 720" Tag="1280x720"/>
                                    <ComboBoxItem Content="1920 x 1080" Tag="1920x1080"/>
                                    <ComboBoxItem Content="720 x 1280" Tag="720x1280"/>
                                    <ComboBoxItem Content="1080 x 1920" Tag="1080x1920"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource OutputFps}"
                                           Style="{StaticResource DetailLabel}"/>
                                <ComboBox x:Name="VirtualCameraFpsBox">
                                    <ComboBoxItem Content="30 fps" Tag="30"/>
                                    <ComboBoxItem Content="60 fps" Tag="60"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding VirtualCameraStatusText}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                                   Margin="0,14,0,0"/>
                        <Button Content="{Binding VirtualCameraInstallActionText}"
                                Click="OnInstallVirtualCameraClick"
                                IsEnabled="{Binding CanInstallVirtualCamera}"
                                Visibility="{Binding VirtualCameraInstallVisibility}"
                                Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"/>
                        <Button Content="{DynamicResource StartVirtualCamera}"
                                Click="OnStartVirtualCameraClick"
                                IsEnabled="{Binding CanUseVirtualCamera}"
                                Visibility="{Binding VirtualCameraStartVisibility}"
                                Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"/>
                        <Button Content="{DynamicResource UninstallVirtualCamera}"
                                Click="OnUninstallVirtualCameraClick"
                                IsEnabled="{Binding CanUninstallVirtualCamera}"
                                Visibility="{Binding VirtualCameraUninstallVisibility}"
                                Style="{StaticResource ToolButton}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FeedbackText" Text="{Binding MediaOutputStatus}"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
            <Button Grid.Column="2" Content="{DynamicResource StopMediaOutput}"
                    Click="OnStopClick" Style="{StaticResource ToolButton}"
                    IsEnabled="{Binding CanStopMediaOutput}" MinWidth="110"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
