<chrome:RoundedWindow x:Class="IPhoneMirror.App.Windows.MediaOutputSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource MediaOutputTitle}"
        Width="680" Height="560" MinWidth="522" MinHeight="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Foreground="{DynamicResource TextBrush}"
        xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <chrome:RoundedWindow.Resources>
        <Style x:Key="OutputTextField" TargetType="TextBox" BasedOn="{StaticResource ReceiverTextBox}">
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}"/>
            <Setter Property="Padding" Value="{StaticResource InputPadding}"/>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="{DynamicResource CardPadding}"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>
        <Style x:Key="OutputSectionHeading" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </chrome:RoundedWindow.Resources>

    <Grid Style="{StaticResource SubWindowPageRoot}"
          animations:PageTransition.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*" MinHeight="{StaticResource DialogContentMinHeight}"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Style="{StaticResource SubWindowHeader}"
              animations:WindowDragBehavior.IsEnabled="True">
            <StackPanel Margin="0,0,48,0">
                <TextBlock Text="{DynamicResource MediaOutputTitle}"
                           Style="{StaticResource SubWindowTitle}"/>
                <TextBlock Text="{Binding SelectedName}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubWindowSubtitle}">
                            <Setter Property="Visibility" Value="{DynamicResource InterfaceDescriptionsVisibility}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedDevice}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <Button Style="{StaticResource SubWindowCloseButton}" Click="OnCloseClick">
                <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/>
            </Button>
        </Grid>

        <TabControl x:Name="OutputTabs" Grid.Row="2" Style="{StaticResource SubWindowTabControl}"
                    SelectionChanged="OnOutputTabChanged">
            <TabItem x:Name="RecordingTab" Header="{DynamicResource RecordTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Grid.IsSharedSizeScope="True">
                            <TextBlock Text="{DynamicResource StreamPictureSection}" Style="{StaticResource OutputSectionHeading}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource OutputWidth}" Style="{StaticResource DetailLabel}"/>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" SharedSizeGroup="OutputFieldHeight"/></Grid.RowDefinitions>
                                        <TextBox AutomationProperties.Name="{DynamicResource OutputWidth}" x:Name="RecordWidthBox" Style="{StaticResource OutputTextField}"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource OutputHeight}" Style="{StaticResource DetailLabel}"/>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" SharedSizeGroup="OutputFieldHeight"/></Grid.RowDefinitions>
                                        <TextBox AutomationProperties.Name="{DynamicResource OutputHeight}" x:Name="RecordHeightBox" Style="{StaticResource OutputTextField}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource OutputFps}" Style="{StaticResource DetailLabel}"/>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" SharedSizeGroup="OutputFieldHeight"/></Grid.RowDefinitions>
                                        <TextBox AutomationProperties.Name="{DynamicResource OutputFps}" x:Name="RecordFpsBox" Style="{StaticResource OutputTextField}"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource OutputBitrate}" Style="{StaticResource DetailLabel}"/>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" SharedSizeGroup="OutputFieldHeight"/></Grid.RowDefinitions>
                                        <TextBox AutomationProperties.Name="{DynamicResource OutputBitrate}" x:Name="RecordBitrateBox" Style="{StaticResource OutputTextField}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{DynamicResource RecordingSaveHint}" Style="{StaticResource SecondaryText}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="StreamingTab" Header="{DynamicResource StreamTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Grid.IsSharedSizeScope="True">
                            <TextBlock Text="{DynamicResource StreamConnectionSection}" Style="{StaticResource OutputSectionHeading}"/>
                            <TextBlock Text="{DynamicResource StreamProtocol}" Style="{StaticResource DetailLabel}" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" SharedSizeGroup="OutputFieldHeight"/></Grid.RowDefinitions>
                                <ComboBox AutomationProperties.Name="{DynamicResource StreamProtocol}" x:Name="StreamProtocolBox" SelectedIndex="0"
                                          SelectionChanged="OnStreamProtocolChanged">
                                    <ComboBoxItem x:Name="RtmpProtocolItem" Content="RTMP"
                                                  IsEnabled="{Binding DataContext.CanStreamRtmp, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <ComboBoxItem x:Name="SrtProtocolItem" Content="SRT"
                                                  IsEnabled="{Binding DataContext.CanStreamSrt, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <ComboBoxItem x:Name="WhipProtocolItem" Content="WebRTC / WHIP"
                                                  IsEnabled="{Binding DataContext.CanStreamWhip, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </ComboBox>
                            </Grid>
                            <TextBlock x:Name="StreamAddressLabel" Text="{DynamicResource StreamRtmpAddress}" Style="{StaticResource DetailLabel}"/>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" SharedSizeGroup="OutputFieldHeight"/></Grid.RowDefinitions>
                                <TextBox AutomationProperties.Name="{DynamicResource StreamDestination}" x:Name="StreamDestinationBox" Style="{StaticResource OutputTextField}"/>
                                <TextBlock x:Name="StreamAddressHint" Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="12,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Text, ElementName=StreamDestinationBox}" Value=""/>
                                                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=StreamDestinationBox}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <StackPanel x:Name="WhipAuthorizationFields" Visibility="Collapsed">
                                <TextBlock Text="{DynamicResource StreamAuthorization}" Style="{StaticResource DetailLabel}"/>
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" SharedSizeGroup="OutputFieldHeight"/></Grid.RowDefinitions>
                                    <TextBox AutomationProperties.Name="{DynamicResource StreamAuthorization}" x:Name="StreamAuthorizationBox" Style="{StaticResource OutputTextField}"/>
                                </Grid>
                            </StackPanel>
                            <Border BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,8"/>
                            <TextBlock Text="{DynamicResource StreamPictureSection}" Style="{StaticResource OutputSectionHeading}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource OutputWidth}" Style="{StaticResource DetailLabel}"/>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" SharedSizeGroup="OutputFieldHeight"/></Grid.RowDefinitions>
                                        <TextBox AutomationProperties.Name="{DynamicResource OutputWidth}" x:Name="StreamWidthBox" Style="{StaticResource OutputTextField}"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource OutputHeight}" Style="{StaticResource DetailLabel}"/>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" SharedSizeGroup="OutputFieldHeight"/></Grid.RowDefinitions>
                                        <TextBox AutomationProperties.Name="{DynamicResource OutputHeight}" x:Name="StreamHeightBox" Style="{StaticResource OutputTextField}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource OutputFps}" Style="{StaticResource DetailLabel}"/>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" SharedSizeGroup="OutputFieldHeight"/></Grid.RowDefinitions>
                                        <TextBox AutomationProperties.Name="{DynamicResource OutputFps}" x:Name="StreamFpsBox" Style="{StaticResource OutputTextField}"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource OutputBitrate}" Style="{StaticResource DetailLabel}"/>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" SharedSizeGroup="OutputFieldHeight"/></Grid.RowDefinitions>
                                        <TextBox AutomationProperties.Name="{DynamicResource OutputBitrate}" x:Name="StreamBitrateBox" Style="{StaticResource OutputTextField}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <Border BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,8"/>
                            <TextBlock Text="{DynamicResource StreamMicrophone}" Style="{StaticResource OutputSectionHeading}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" SharedSizeGroup="OutputFieldHeight"/></Grid.RowDefinitions>
                                    <ComboBox AutomationProperties.Name="{DynamicResource StreamMicrophone}" x:Name="MicrophoneBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                                              IsEnabled="{Binding CanStartStreaming}"/>
                                </Grid>
                                <Button x:Name="RefreshMicrophonesButton" Grid.Column="1" Margin="8,0,0,0"
                                        Style="{StaticResource IconButton}" ToolTip="{DynamicResource RefreshMicrophones}"
                                        AutomationProperties.Name="{DynamicResource RefreshMicrophones}" Click="OnRefreshMicrophonesClick">
                                    <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="ArrowClockwise20" FontSize="18"/>
                                </Button>
                            </Grid>
                            <TextBlock Visibility="{DynamicResource InterfaceDescriptionsVisibility}" Text="{DynamicResource StreamMicrophoneHint}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="CameraTab" Header="{DynamicResource VirtualCameraTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel Grid.IsSharedSizeScope="True">
                        <TextBlock Text="{DynamicResource VirtualCameraTab}" Style="{StaticResource OutputSectionHeading}"/>
                        <TextBlock Text="{Binding VirtualCameraStatusText}" Style="{StaticResource SecondaryText}"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ResolutionLabel}"
                                           Style="{StaticResource DetailLabel}"/>
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" SharedSizeGroup="OutputFieldHeight"/></Grid.RowDefinitions>
                                    <ComboBox AutomationProperties.Name="{DynamicResource ResolutionLabel}" x:Name="VirtualCameraResolutionBox">
                                        <ComboBoxItem x:Name="VirtualCameraCurrentResolutionItem"
                                                      Visibility="Collapsed"/>
                                        <ComboBoxItem Content="1280 x 720" Tag="1280x720"/>
                                        <ComboBoxItem Content="1920 x 1080" Tag="1920x1080"/>
                                        <ComboBoxItem Content="720 x 1280" Tag="720x1280"/>
                                        <ComboBoxItem Content="1088 x 1920" Tag="1088x1920"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource OutputFps}"
                                           Style="{StaticResource DetailLabel}"/>
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" SharedSizeGroup="OutputFieldHeight"/></Grid.RowDefinitions>
                                    <ComboBox AutomationProperties.Name="{DynamicResource OutputFps}" x:Name="VirtualCameraFpsBox">
                                        <ComboBoxItem Content="30 fps" Tag="30"/>
                                        <ComboBoxItem Content="60 fps" Tag="60"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{DynamicResource VirtualCameraUseHint}" Style="{StaticResource SecondaryText}" Margin="0,12,0,0"/>
                        <Button Content="{DynamicResource UninstallVirtualCamera}"
                                Click="OnUninstallVirtualCameraClick"
                                IsEnabled="{Binding CanUninstallVirtualCamera}"
                                Visibility="{Binding VirtualCameraUninstallVisibility}"
                                Style="{StaticResource ToolButton}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Margin="0,12,0,0" Padding="0,12,0,0"
                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0">
            <Grid x:Name="OutputFooter" SizeChanged="OnFooterSizeChanged">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <WrapPanel x:Name="OutputActions" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12,0,0,0">
                <Button x:Name="StopAllOutputsButton" Content="{DynamicResource StopMediaOutput}" Click="OnStopAllClick"
                        IsEnabled="False">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMediaOutputRunning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="DiscardRecordingButton" Content="{DynamicResource DiscardRecording}" Margin="8,0,0,0"
                        Click="OnDiscardClick" IsEnabled="{Binding CanDiscardRecording}" Visibility="Collapsed"/>
                <Button x:Name="StartRecordingButton" Content="{DynamicResource StartRecording}" Click="OnStartRecordingClick"
                        IsEnabled="False" MinWidth="136" Margin="8,0,0,0" ToolTipService.ShowOnDisabled="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, ElementName=RecordingTab}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="StartStreamingButton" Content="{DynamicResource StartStreaming}" Click="OnStartStreamingClick"
                        IsEnabled="False" MinWidth="136" Margin="8,0,0,0" ToolTipService.ShowOnDisabled="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, ElementName=StreamingTab}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="InstallVirtualCameraButton" Content="{Binding VirtualCameraInstallActionText}"
                        Click="OnInstallVirtualCameraClick" IsEnabled="{Binding CanInstallVirtualCamera}"
                        Style="{StaticResource PrimaryButton}" Visibility="Collapsed" Margin="8,0,0,0"/>
                <Button x:Name="StartVirtualCameraButton" Content="{DynamicResource StartVirtualCamera}"
                        Click="OnStartVirtualCameraClick" IsEnabled="False" Visibility="Collapsed" MinWidth="136"
                        Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" ToolTipService.ShowOnDisabled="True"/>
            </WrapPanel>
            <StackPanel x:Name="OutputFeedback" VerticalAlignment="Center">
                <TextBlock x:Name="OutputSourceHint" Visibility="Collapsed" Style="{StaticResource SecondaryText}"/>
                <TextBlock x:Name="OutputStatusText" Text="{Binding MediaOutputStatus}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}"/>
                <TextBlock x:Name="FeedbackText" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource MutedTextBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                            <Style.Triggers>
                                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock x:Name="OutputCapabilityHint" Text="{Binding MediaOutputCapabilitiesText}"
                           Visibility="Collapsed" Style="{StaticResource SecondaryText}"/>
            </StackPanel>
            </Grid>
        </Border>
    </Grid>
</chrome:RoundedWindow>
