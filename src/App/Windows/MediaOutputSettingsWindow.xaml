<chrome:RoundedWindow x:Class="IPhoneMirror.App.Windows.MediaOutputSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource MediaOutputTitle}"
        Width="582" Height="682" MinWidth="522" MinHeight="582"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Foreground="{DynamicResource TextBrush}"
        xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <chrome:RoundedWindow.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>
    </chrome:RoundedWindow.Resources>

    <Grid Style="{StaticResource SubWindowPageRoot}"
          animations:PageTransition.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*" MinHeight="{StaticResource DialogContentMinHeight}"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Style="{StaticResource SubWindowHeader}"
              animations:WindowDragBehavior.IsEnabled="True">
            <StackPanel Margin="0,0,48,0">
                <TextBlock Text="{DynamicResource MediaOutputTitle}"
                           Style="{StaticResource SubWindowTitle}"/>
                <TextBlock Text="{Binding SelectedName}"
                           Style="{StaticResource SubWindowSubtitle}"/>
                <TextBlock Text="{Binding MediaOutputCapabilitiesText}" FontSize="{DynamicResource CaptionFontSize}"
                           Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Style="{StaticResource SubWindowCloseButton}" Click="OnCloseClick">
                <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/>
            </Button>
        </Grid>

        <TabControl Grid.Row="2" Style="{StaticResource SubWindowTabControl}">
            <TabItem Header="{DynamicResource RecordTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource RecordDescription}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource SecondaryFontSize}"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource OutputWidth}" Style="{StaticResource DetailLabel}"/>
                                    <TextBox AutomationProperties.Name="{DynamicResource OutputWidth}" x:Name="RecordWidthBox" Style="{StaticResource RoundedTextBox}" MinHeight="40"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource OutputHeight}" Style="{StaticResource DetailLabel}"/>
                                    <TextBox AutomationProperties.Name="{DynamicResource OutputHeight}" x:Name="RecordHeightBox" Style="{StaticResource RoundedTextBox}" MinHeight="40"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource OutputFps}" Style="{StaticResource DetailLabel}"/>
                                    <TextBox AutomationProperties.Name="{DynamicResource OutputFps}" x:Name="RecordFpsBox" Style="{StaticResource RoundedTextBox}" MinHeight="40"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource OutputBitrate}" Style="{StaticResource DetailLabel}"/>
                                    <TextBox AutomationProperties.Name="{DynamicResource OutputBitrate}" x:Name="RecordBitrateBox" Style="{StaticResource RoundedTextBox}" MinHeight="40"/>
                                </StackPanel>
                            </Grid>
                            <Button x:Name="StartRecordingButton"
                                    Content="{DynamicResource StartRecording}" Click="OnStartRecordingClick"
                                    IsEnabled="False"
                                    Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource StreamTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource StreamDescription}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource SecondaryFontSize}"/>
                            <TextBlock Text="{DynamicResource StreamProtocol}" Style="{StaticResource DetailLabel}"/>
                            <ComboBox AutomationProperties.Name="{DynamicResource StreamProtocol}" x:Name="StreamProtocolBox" SelectedIndex="0"
                                      SelectionChanged="OnStreamProtocolChanged">
                                <ComboBoxItem x:Name="RtmpProtocolItem" Content="RTMP"
                                              IsEnabled="{Binding DataContext.CanStreamRtmp, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <ComboBoxItem x:Name="SrtProtocolItem" Content="SRT"
                                              IsEnabled="{Binding DataContext.CanStreamSrt, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <ComboBoxItem x:Name="WhipProtocolItem" Content="WebRTC / WHIP"
                                              IsEnabled="{Binding DataContext.CanStreamWhip, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </ComboBox>
                            <TextBlock Text="{DynamicResource StreamDestination}" Style="{StaticResource DetailLabel}"/>
                            <TextBox AutomationProperties.Name="{DynamicResource StreamDestination}" x:Name="StreamDestinationBox" Style="{StaticResource RoundedTextBox}" MinHeight="40"/>
                            <TextBlock Text="{DynamicResource StreamAuthorization}" Style="{StaticResource DetailLabel}"/>
                            <TextBox AutomationProperties.Name="{DynamicResource StreamAuthorization}" x:Name="StreamAuthorizationBox" Style="{StaticResource RoundedTextBox}" MinHeight="40"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource OutputWidth}" Style="{StaticResource DetailLabel}"/>
                                    <TextBox AutomationProperties.Name="{DynamicResource OutputWidth}" x:Name="StreamWidthBox" Style="{StaticResource RoundedTextBox}" MinHeight="40"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource OutputHeight}" Style="{StaticResource DetailLabel}"/>
                                    <TextBox AutomationProperties.Name="{DynamicResource OutputHeight}" x:Name="StreamHeightBox" Style="{StaticResource RoundedTextBox}" MinHeight="40"/>
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource OutputFps}" Style="{StaticResource DetailLabel}"/>
                                    <TextBox AutomationProperties.Name="{DynamicResource OutputFps}" x:Name="StreamFpsBox" Style="{StaticResource RoundedTextBox}" MinHeight="40"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource OutputBitrate}" Style="{StaticResource DetailLabel}"/>
                                    <TextBox AutomationProperties.Name="{DynamicResource OutputBitrate}" x:Name="StreamBitrateBox" Style="{StaticResource RoundedTextBox}" MinHeight="40"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{DynamicResource StreamMicrophone}" Style="{StaticResource DetailLabel}" Margin="0,14,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox AutomationProperties.Name="{DynamicResource StreamMicrophone}" x:Name="MicrophoneBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                                          IsEnabled="{Binding CanStartMediaOutput}"/>
                                <Button x:Name="RefreshMicrophonesButton" Grid.Column="1" Margin="8,0,0,0"
                                        Style="{StaticResource IconButton}" ToolTip="{DynamicResource RefreshMicrophones}"
                                        AutomationProperties.Name="{DynamicResource RefreshMicrophones}" Click="OnRefreshMicrophonesClick">
                                    <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="ArrowClockwise20" FontSize="18"/>
                                </Button>
                            </Grid>
                            <TextBlock Text="{DynamicResource StreamMicrophoneHint}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,0"/>
                            <Button x:Name="StartStreamingButton"
                                    Content="{DynamicResource StartStreaming}" Click="OnStartStreamingClick"
                                    IsEnabled="False"
                                    Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource VirtualCameraTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource VirtualCameraDescription}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource SecondaryFontSize}"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource ResolutionLabel}"
                                           Style="{StaticResource DetailLabel}"/>
                                <ComboBox AutomationProperties.Name="{DynamicResource ResolutionLabel}" x:Name="VirtualCameraResolutionBox">
                                    <ComboBoxItem x:Name="VirtualCameraCurrentResolutionItem"
                                                  Visibility="Collapsed"/>
                                    <ComboBoxItem Content="1280 x 720" Tag="1280x720"/>
                                    <ComboBoxItem Content="1920 x 1080" Tag="1920x1080"/>
                                    <ComboBoxItem Content="720 x 1280" Tag="720x1280"/>
                                    <ComboBoxItem Content="1080 x 1920" Tag="1080x1920"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource OutputFps}"
                                           Style="{StaticResource DetailLabel}"/>
                                <ComboBox AutomationProperties.Name="{DynamicResource OutputFps}" x:Name="VirtualCameraFpsBox">
                                    <ComboBoxItem Content="30 fps" Tag="30"/>
                                    <ComboBoxItem Content="60 fps" Tag="60"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding VirtualCameraStatusText}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource SecondaryFontSize}"
                                   Margin="0,14,0,0"/>
                        <Button Content="{Binding VirtualCameraInstallActionText}"
                                Click="OnInstallVirtualCameraClick"
                                IsEnabled="{Binding CanInstallVirtualCamera}"
                                Visibility="{Binding VirtualCameraInstallVisibility}"
                                Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"/>
                        <Button Content="{DynamicResource StartVirtualCamera}"
                                Click="OnStartVirtualCameraClick"
                                IsEnabled="{Binding CanUseVirtualCamera}"
                                Visibility="{Binding VirtualCameraStartVisibility}"
                                Style="{StaticResource PrimaryButton}" Margin="0,18,0,0"/>
                        <Button Content="{DynamicResource UninstallVirtualCamera}"
                                Click="OnUninstallVirtualCameraClick"
                                IsEnabled="{Binding CanUninstallVirtualCamera}"
                                Visibility="{Binding VirtualCameraUninstallVisibility}"
                                Style="{StaticResource ToolButton}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="OutputStatusText" Text="{Binding MediaOutputStatus}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}"/>
                <TextBlock x:Name="FeedbackText" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}"/>
            </StackPanel>
            <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="{DynamicResource DiscardRecording}"
                        Click="OnDiscardClick" Style="{StaticResource ToolButton}"
                        MinWidth="110" Margin="0,0,8,0"/>
                <Button Content="{DynamicResource StopMediaOutput}"
                        Click="OnStopClick" Style="{StaticResource ToolButton}"
                        IsEnabled="{Binding CanStopMediaOutput}" MinWidth="110"/>
            </WrapPanel>
        </Grid>
    </Grid>
</chrome:RoundedWindow>
