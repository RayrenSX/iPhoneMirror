<chrome:RoundedWindow x:Class="IPhoneMirror.App.Windows.AppPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:design="clr-namespace:IPhoneMirror.UI.Controls"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding PromptTitle}" Width="542" SizeToContent="Height" MinHeight="272" MaxHeight="562"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False"
        xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Style="{StaticResource RoundedWindowContent}">
        <Grid animations:PageTransition.IsEnabled="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="16"/>
                <RowDefinition Height="*" MinHeight="{StaticResource DialogContentMinHeight}"/><RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Style="{StaticResource SubWindowHeader}"
                  animations:WindowDragBehavior.IsEnabled="True">
                <TextBlock Text="{Binding PromptTitle}"
                           Style="{StaticResource SubWindowTitle}" Margin="0,0,48,0"/>
                <Button Style="{StaticResource SubWindowCloseButton}" Click="OnCancelClick">
                    <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/>
                </Button>
            </Grid>
            <Border Grid.Row="2" Style="{StaticResource SettingsSection}" Padding="16" design:StatusAppearance.Tone="{Binding Tone}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="300">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="{Binding PromptSymbol}" FontSize="20" VerticalAlignment="Top"
                                       design:StatusAppearance.Tone="{Binding Tone}"/>
                        <TextBlock Grid.Column="1" Text="{Binding PromptBody}" Style="{StaticResource BodyText}"/>
                    </Grid>
                </ScrollViewer>
            </Border>
            <WrapPanel Grid.Row="4" Style="{StaticResource DialogActions}">
                <Button Margin="{StaticResource DialogActionMargin}" Content="{Binding CancelText}" Click="OnCancelClick"
                        IsDefault="{Binding CancelIsDefault}" MinWidth="92"
                        Visibility="{Binding CancelVisibility}"/>
                <Button Margin="{StaticResource DialogActionMargin}" Content="{Binding ConfirmText}" Click="OnConfirmClick"
                        IsDefault="{Binding ConfirmIsDefault}" MinWidth="118" Style="{Binding ConfirmStyle}"/>
            </WrapPanel>
        </Grid>
    </Border>
</chrome:RoundedWindow>
