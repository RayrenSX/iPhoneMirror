<chrome:RoundedWindow x:Class="IPhoneMirror.App.Windows.AppPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:design="clr-namespace:IPhoneMirror.UI.Controls"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding PromptTitle}" Width="542" SizeToContent="Height" MaxHeight="562"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False"
        xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Style="{StaticResource RoundedWindowContent}">
        <Grid animations:PageTransition.IsEnabled="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="16"/>
                <RowDefinition Height="*"/><RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Style="{StaticResource SubWindowHeader}"
                  animations:WindowDragBehavior.IsEnabled="True">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource NoticeHeaderIcon}" design:StatusAppearance.Tone="{Binding Tone}">
                    <ui:SymbolIcon Symbol="{Binding PromptSymbol}" FontSize="20" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" design:StatusAppearance.Tone="{Binding Tone}"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding PromptTitle}" Style="{StaticResource NoticeHeaderTitle}"/>
                <Button Grid.Column="2" Style="{StaticResource NoticeHeaderCloseButton}" Click="OnCancelClick">
                    <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/>
                </Button>
            </Grid>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="300">
                <TextBlock Text="{Binding PromptBody}" Style="{StaticResource BodyText}"/>
            </ScrollViewer>
            <WrapPanel Grid.Row="4" Style="{StaticResource DialogActions}">
                <Button Margin="{StaticResource DialogActionMargin}" Content="{Binding CancelText}" Click="OnCancelClick"
                        IsDefault="{Binding CancelIsDefault}" MinWidth="92"
                        Visibility="{Binding CancelVisibility}"/>
                <Button Margin="{StaticResource DialogActionMargin}" Content="{Binding ConfirmText}" Click="OnConfirmClick"
                        IsDefault="{Binding ConfirmIsDefault}" MinWidth="118" Style="{Binding ConfirmStyle}"/>
            </WrapPanel>
        </Grid>
    </Border>
</chrome:RoundedWindow>
