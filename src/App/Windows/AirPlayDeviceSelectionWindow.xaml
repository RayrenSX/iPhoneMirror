<chrome:RoundedWindow x:Class="IPhoneMirror.App.Windows.AirPlayDeviceSelectionWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="{DynamicResource DeviceBindingAirPlaySelectTitle}" Width="482" Height="432" MinWidth="422" MinHeight="362" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Foreground="{DynamicResource TextBrush}"
        xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
 <Grid Style="{StaticResource SubWindowPageRoot}" animations:PageTransition.IsEnabled="True"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*" MinHeight="{StaticResource DialogContentMinHeight}"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Style="{StaticResource SubWindowHeader}" animations:WindowDragBehavior.IsEnabled="True"><TextBlock Text="{DynamicResource DeviceBindingAirPlaySelectTitle}" Style="{StaticResource SubWindowTitle}" Margin="0,0,48,0"/><Button Style="{StaticResource SubWindowCloseButton}" Click="CancelClick" ToolTip="{DynamicResource DeviceBindingCancel}"><ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/></Button></Grid>
  <StackPanel Grid.Row="2"><TextBlock Text="{DynamicResource DeviceBindingAirPlayAddTitle}" FontSize="{DynamicResource FontSize15}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Visibility="{DynamicResource InterfaceDescriptionsVisibility}" Text="{DynamicResource DeviceBindingAirPlaySelectDescription}" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
  <Grid Grid.Row="4"><ListBox ItemContainerStyle="{StaticResource SelectableListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding ModelDisplay}" TextWrapping="Wrap" FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ScrollViewer.Style><Style TargetType="ScrollViewer" BasedOn="{StaticResource ContentScrollViewerStyle}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding Devices.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style></ScrollViewer.Style>
            <TextBlock Text="{DynamicResource AirPlayEmptyState}">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding Devices.Count}" Value="0">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger></Style.Triggers>
                </Style></TextBlock.Style>
            </TextBlock>
            </ScrollViewer>
        </Grid>
  <WrapPanel Grid.Row="6" Style="{StaticResource DialogActions}"><Button Content="{DynamicResource DeviceBindingCancel}" Click="CancelClick" MinWidth="88" Margin="{StaticResource DialogActionMargin}"/><Button Content="{DynamicResource DeviceBindingCreateProfile}" IsDefault="True" Click="ConfirmClick" IsEnabled="{Binding CanConfirm}" Style="{StaticResource PrimaryButton}" Margin="{StaticResource DialogActionMargin}" MinWidth="108"/></WrapPanel>
 </Grid>
</chrome:RoundedWindow>
