<chrome:RoundedWindow x:Class="IPhoneMirror.App.Windows.CaptureRecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="642" Height="522" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False"
        xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Padding="26" Style="{StaticResource RoundedWindowContent}">
        <Grid animations:PageTransition.IsEnabled="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*" MinHeight="{StaticResource DialogContentMinHeight}"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Style="{StaticResource SubWindowHeader}"
                  animations:WindowDragBehavior.IsEnabled="True">
                <TextBlock Text="{DynamicResource CaptureNoPingTitle}"
                           Style="{StaticResource SubWindowTitle}" Margin="0,0,48,0"/>
                <Button Style="{StaticResource SubWindowCloseButton}"
                        ToolTip="{DynamicResource Close}"
                        Click="OnCloseClick">
                <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/>
                </Button>
            </Grid>

            <TextBlock Grid.Row="2" Text="{DynamicResource CaptureNoPingSummary}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="{DynamicResource SectionTitleFontSize}" TextWrapping="Wrap"/>

            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto"><StackPanel>
                <Border Background="{DynamicResource WarningSurfaceBrush}"
                        BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="18,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border MinWidth="34" MinHeight="34" Padding="5,2" VerticalAlignment="Top" CornerRadius="17"
                                Background="{DynamicResource WarningBrush}">
                            <TextBlock Text="1" Foreground="{DynamicResource OnAccentBrush}" FontSize="{DynamicResource FontSize18}"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="{DynamicResource CaptureNoPingRestartAction}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="{DynamicResource FontSize19}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource WarningSurfaceBrush}"
                        BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="18,16"
                        Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border MinWidth="34" MinHeight="34" Padding="5,2" VerticalAlignment="Top" CornerRadius="17"
                                Background="{DynamicResource WarningBrush}">
                            <TextBlock Text="2" Foreground="{DynamicResource OnAccentBrush}" FontSize="{DynamicResource FontSize18}"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="{DynamicResource CaptureNoPingCableAction}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="{DynamicResource FontSize19}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource ControlFillBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="14,11"
                        Margin="0,12,0,0">
                    <TextBlock Text="{DynamicResource CaptureNoPingUnlockHint}"
                               FontSize="{DynamicResource BodyFontSize}" FontWeight="SemiBold"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </Border>
            </StackPanel></ScrollViewer>

            <Button Grid.Row="6" Content="{DynamicResource Close}"
                    Style="{StaticResource PrimaryButton}" MinWidth="120"
                    HorizontalAlignment="Right" Click="OnCloseClick"/>
        </Grid>
    </Border>
</chrome:RoundedWindow>
