<Window x:Class="IPhoneMirror.App.Windows.CaptureRecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620" Height="500" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="#5A5A5A"
            BorderThickness="1" CornerRadius="8">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <TextBlock Text="{DynamicResource CaptureNoPingTitle}"
                           FontSize="23" FontWeight="SemiBold"/>
                <Button Content="X" HorizontalAlignment="Right" Width="32" Height="32"
                        MinHeight="32" Padding="0" FontSize="14" Click="OnCloseClick"/>
            </Grid>

            <TextBlock Grid.Row="2" Text="{DynamicResource CaptureNoPingSummary}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="14" LineHeight="22" TextWrapping="Wrap"/>

            <StackPanel Grid.Row="4">
                <Border Background="#33291A" BorderBrush="#9A7333"
                        BorderThickness="1" CornerRadius="7" Padding="18,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="17"
                                Background="{DynamicResource WarningBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="1" Foreground="#201800" FontSize="18"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="{DynamicResource CaptureNoPingRestartAction}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="19" FontWeight="SemiBold"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Background="#33291A" BorderBrush="#9A7333"
                        BorderThickness="1" CornerRadius="7" Padding="18,16"
                        Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="17"
                                Background="{DynamicResource WarningBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="2" Foreground="#201800" FontSize="18"
                                       FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="{DynamicResource CaptureNoPingCableAction}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="19" FontWeight="SemiBold"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14,11"
                        Margin="0,12,0,0">
                    <TextBlock Text="{DynamicResource CaptureNoPingUnlockHint}"
                               FontSize="13" FontWeight="SemiBold"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </Border>
            </StackPanel>

            <Button Grid.Row="6" Content="{DynamicResource Close}"
                    Style="{StaticResource PrimaryButton}" MinWidth="120"
                    HorizontalAlignment="Right" Click="OnCloseClick"/>
        </Grid>
    </Border>
</Window>
