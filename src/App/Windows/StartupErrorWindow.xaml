<Window x:Class="IPhoneMirror.App.Windows.StartupErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iPhoneMirror" Width="680" Height="440"
        MinWidth="620" MinHeight="400" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Foreground="{DynamicResource TextBrush}"
        AutomationProperties.AutomationId="StartupErrorWindow">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText" FontSize="25" FontWeight="SemiBold"/>
        <TextBlock x:Name="SummaryText" Grid.Row="2" FontSize="14"
                   Foreground="{DynamicResource MutedTextBrush}"
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="4">
            <TextBlock x:Name="LogLabelText" FontSize="12" Margin="0,0,0,7"/>
            <TextBox x:Name="LogPathTextBox" Style="{StaticResource RoundedTextBox}"
                     IsReadOnly="True" MinHeight="38" VerticalContentAlignment="Center"/>
        </StackPanel>

        <Expander x:Name="DetailsExpander" Grid.Row="6" IsExpanded="False"
                  Foreground="{DynamicResource TextBrush}">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Margin="0,8,0,0">
                <TextBox x:Name="DetailsTextBox" IsReadOnly="True"
                         Background="Transparent" Foreground="{DynamicResource MutedTextBrush}"
                         BorderThickness="0" FontFamily="Consolas" FontSize="11"
                         TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto" Padding="10"/>
            </Border>
        </Expander>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OpenLogButton" MinWidth="132" Margin="0,0,8,0"
                    Click="OnOpenLogClick"/>
            <Button x:Name="CloseButton" MinWidth="96"
                    Style="{StaticResource PrimaryButton}" IsDefault="True"
                    Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>
