<chrome:RoundedWindow x:Class="IPhoneMirror.App.Windows.StartupErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="iPhoneMirror" Width="560" SizeToContent="Height" MaxHeight="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Foreground="{DynamicResource TextBrush}"
        AutomationProperties.AutomationId="StartupErrorWindow"
        xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Padding="24" Style="{StaticResource RoundedWindowContent}">
    <Grid
          animations:PageTransition.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="NoticeHeader" Style="{StaticResource SubWindowHeader}"
              animations:WindowDragBehavior.IsEnabled="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="HeaderIcon" Style="{StaticResource NoticeHeaderIcon}"
                    Background="{DynamicResource ErrorSurfaceBrush}">
                <ui:SymbolIcon Symbol="ErrorCircle20" Foreground="{DynamicResource ErrorBrush}"
                               FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="HeadingText" Grid.Column="1" Style="{StaticResource NoticeHeaderTitle}"/>
            <Button x:Name="HeaderClose" Grid.Column="2" Style="{StaticResource NoticeHeaderCloseButton}" Click="OnCloseClick">
                <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/>
            </Button>
        </Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
        <TextBlock x:Name="SummaryText" Style="{StaticResource BodyText}"/>
        <TextBox x:Name="DetailsTextBox" Style="{StaticResource NoticeDiagnosticText}"
                 Margin="0,10,0,0"/>
        </StackPanel>
        </ScrollViewer>

        <WrapPanel Grid.Row="4" HorizontalAlignment="Right">
            <Button x:Name="OpenLogButton" MinWidth="132" Margin="0,0,8,0"
                    Click="OnOpenLogClick"/>
            <Button x:Name="CloseButton" MinWidth="96"
                    Style="{StaticResource PrimaryButton}" IsDefault="True" IsCancel="True"
                    Click="OnCloseClick"/>
        </WrapPanel>
    </Grid>
    </Border>
</chrome:RoundedWindow>
