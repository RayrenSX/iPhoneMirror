<chrome:RoundedWindow x:Class="IPhoneMirror.App.Windows.TrayPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:updater="clr-namespace:IPhoneMirror.App.Updater"
        Title="{DynamicResource ApplicationModeTray}" Width="420" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="Manual"
        Foreground="{DynamicResource TextBrush}" PreviewKeyDown="OnPreviewKeyDown">
    <chrome:RoundedWindow.Resources>
        <DataTemplate x:Key="TrayButtonText">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
        </DataTemplate>
    </chrome:RoundedWindow.Resources>
    <Grid Style="{StaticResource SubWindowPageRoot}" animations:PageTransition.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource SubWindowHeader}" animations:WindowDragBehavior.IsEnabled="True">
            <TextBlock Text="iPhoneMirror" Style="{StaticResource SubWindowTitle}" Margin="0,0,44,0"/>
            <Button Style="{StaticResource SubWindowCloseButton}" Click="OnHideClick"
                    ToolTip="{DynamicResource TrayHidePanel}" AutomationProperties.Name="{DynamicResource TrayHidePanel}">
                <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/>
            </Button>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
                <Button x:Name="RestorePreviewInteractionButton" Visibility="Collapsed" Margin="0,0,0,10"
                        Content="{DynamicResource IndependentWindowRestoreInteraction}" ContentTemplate="{StaticResource TrayButtonText}"
                        Style="{StaticResource PrimaryButton}" Click="OnRestorePreviewInteractionClick"/>
                <Border Grid.Row="1" Style="{StaticResource SettingsSection}" Padding="14,10,14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="{DynamicResource DevicesTitle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Click="OnRefreshClick" x:Name="RefreshButton"
                                    Style="{StaticResource ToolButton}" ToolTip="{DynamicResource RefreshDevices}"
                                    AutomationProperties.Name="{DynamicResource RefreshDevices}">
                                <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="ArrowClockwise20"/>
                            </Button>
                        </Grid>
                        <ListBox x:Name="DeviceList" Grid.Row="1" MaxHeight="134" Margin="0,6,0,0"
                                 BorderThickness="0" Background="Transparent"
                                 SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.AutomationId="TrayDeviceList">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Style.Triggers>
                                        <Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource SelectableListItem}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
                                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding ConnectionType, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding StatusDisplay, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="1" Text="{DynamicResource TrayNoDevices}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=DeviceList, Path=HasItems}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button x:Name="StartButton" Content="{DynamicResource TrayStartMirroring}" ContentTemplate="{StaticResource TrayButtonText}"
                                    Style="{StaticResource PrimaryButton}" Click="OnStartClick" AutomationProperties.AutomationId="TrayStartMirroring"/>
                            <Button x:Name="StopButton" Grid.Column="2" Content="{DynamicResource StopMirroring}" Command="{Binding StopCommand}"
                                    ContentTemplate="{StaticResource TrayButtonText}" Style="{StaticResource SecondaryButton}"/>
                        </Grid>
                        <TextBlock Grid.Row="3" Text="{Binding WirelessStatus}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource MutedTextBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WirelessStatusTone}" Value="Error"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        <DataTrigger Binding="{Binding WirelessStatusTone}" Value="Success"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        <DataTrigger Binding="{Binding IsWirelessReceiverStarting}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            <StackPanel Grid.Row="2">
                <TextBlock x:Name="FeedbackText" Visibility="Collapsed" TextWrapping="Wrap"
                           Margin="0,10,0,0" Foreground="{DynamicResource WarningBrush}"
                           AutomationProperties.LiveSetting="Polite"/>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="ModeLabel" Text="{DynamicResource ApplicationModeLabel}" Margin="0,0,8,0"
                               FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <ComboBox Grid.Column="1" x:Name="ModeSelector" AutomationProperties.LabeledBy="{Binding ElementName=ModeLabel}"
                              PreviewMouseWheel="OnModeSelectorPreviewMouseWheel"
                              SelectedValue="{Binding SelectedApplicationDisplayMode, Mode=TwoWay}" SelectedValuePath="Tag">
                    <ComboBoxItem Tag="{x:Static updater:ApplicationDisplayMode.Lightweight}" Content="{DynamicResource ApplicationModeLightweight}"/>
                    <ComboBoxItem Tag="{x:Static updater:ApplicationDisplayMode.Complete}" Content="{DynamicResource ApplicationModeComplete}"/>
                    <ComboBoxItem Tag="{x:Static updater:ApplicationDisplayMode.Tray}" Content="{DynamicResource ApplicationModeTray}"/>
                    </ComboBox>
                </Grid>
                <Button x:Name="RestoreMainWindowButton" Content="{DynamicResource TrayRestoreMainWindow}"
                        Click="OnRestoreClick" Margin="0,8,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanRestoreMainWindowFromTray}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
        <Border Grid.Row="3" Margin="0,12,0,0" Padding="0,10,0,0"
                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="SettingsButton" Content="{DynamicResource ProjectionSettingsTitle}" ContentTemplate="{StaticResource TrayButtonText}"
                    Click="OnSettingsClick" Style="{StaticResource ToolButton}"/>
            <Button x:Name="ExitButton" Grid.Column="2" Content="{DynamicResource TrayExit}" ContentTemplate="{StaticResource TrayButtonText}"
                    Click="OnExitClick" Style="{StaticResource ToolButton}"/>
        </Grid>
        </Border>
    </Grid>
</chrome:RoundedWindow>
