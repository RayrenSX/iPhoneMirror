<chrome:RoundedWindow x:Class="IPhoneMirror.App.Windows.ProjectionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        xmlns:updater="clr-namespace:IPhoneMirror.App.Updater"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource ProjectionSettingsTitle}"
        Width="522" Height="782" MinWidth="482" MinHeight="642"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Foreground="{DynamicResource TextBrush}"
        xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <chrome:RoundedWindow.Resources>
        <Style x:Key="ControlSectionCard" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="0,14,0,0"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
        </Style>
        <Style x:Key="ControlSectionTitle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize13}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </chrome:RoundedWindow.Resources>

    <Grid Style="{StaticResource SubWindowPageRoot}"
          animations:PageTransition.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*" MinHeight="{StaticResource DialogContentMinHeight}"/>
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource SubWindowHeader}"
              animations:WindowDragBehavior.IsEnabled="True">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,48,0">
                <TextBlock Text="{DynamicResource ProjectionSettingsTitle}"
                           Style="{StaticResource SubWindowTitle}"/>
                <TextBlock Text="{Binding SelectedName}"
                           Style="{StaticResource SubWindowSubtitle}"/>
                <TextBlock Text="{Binding SelectedConnection}" FontSize="{DynamicResource CaptionFontSize}"
                           Foreground="{DynamicResource MutedTextBrush}"/>
            </StackPanel>
            <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                <Button Content="{DynamicResource StartMirroring}" Click="OnStartClick"
                        Style="{StaticResource ToolButton}" MinWidth="72" Margin="0,0,8,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Content="{DynamicResource StopMirroring}" Command="{Binding StopCommand}"
                        Style="{StaticResource ToolButton}" MinWidth="72"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </WrapPanel>
            <Button Style="{StaticResource SubWindowCloseButton}"
                    Click="OnCloseClick">
                <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/>
            </Button>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="18,4,10,18">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
                    <Border Style="{StaticResource ControlSectionCard}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource ApplicationModeLabel}"
                                       Style="{StaticResource ControlSectionTitle}"/>
                            <Button Content="{DynamicResource SetupReopen}" Click="OnFirstRunSetupClick" Margin="0,10,0,8"/>
                            <ComboBox AutomationProperties.Name="{DynamicResource ApplicationModeLabel}" SelectedValue="{Binding SelectedApplicationDisplayMode, Mode=TwoWay}"
                                      SelectedValuePath="Tag" Margin="0,10,0,0">
                                <ComboBoxItem Tag="{x:Static updater:ApplicationDisplayMode.Lightweight}"
                                              Content="{DynamicResource ApplicationModeLightweight}"/>
                                <ComboBoxItem Tag="{x:Static updater:ApplicationDisplayMode.Complete}"
                                              Content="{DynamicResource ApplicationModeComplete}"/>
                                <ComboBoxItem Tag="{x:Static updater:ApplicationDisplayMode.Tray}"
                                              Content="{DynamicResource ApplicationModeTray}"/>
                            </ComboBox>
                            <Button Content="{DynamicResource ApplyLightweightMode}"
                                    Click="OnApplyLightweightModeClick"
                                    Style="{StaticResource ToolButton}" Margin="0,10,0,0"/>
                            <Button Content="{DynamicResource CreateCompactShortcut}"
                                    Click="OnCreateCompactShortcutClick"
                                    Style="{StaticResource ToolButton}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ControlSectionCard}"
                            Visibility="{Binding WirelessTopSettingsVisibility}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource WirelessReceiverTitle}"
                                       Style="{StaticResource ControlSectionTitle}"/>
                            <TextBlock Text="{DynamicResource WirelessBackendLabel}"
                                       Style="{StaticResource DetailLabel}"/>
                            <ComboBox AutomationProperties.Name="{DynamicResource WirelessBackendLabel}" ItemsSource="{Binding WirelessReceiverBackends}"
                                      DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedWirelessReceiverBackend, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="WirelessBackendComboBox"/>
                            <TextBlock Text="{Binding AppliedWirelessBackendDisplay}"
                                       FontSize="{DynamicResource CaptionFontSize}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,5,0,0"/>
                            <TextBlock Text="{DynamicResource WirelessResolutionLabel}"
                                       Style="{StaticResource DetailLabel}"/>
                            <ComboBox AutomationProperties.Name="{DynamicResource WirelessResolutionLabel}" ItemsSource="{Binding WirelessDisplayProfiles}"
                                      DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedWirelessDisplayProfile, Mode=TwoWay}"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox AutomationProperties.Name="{DynamicResource WirelessResolutionLabel}" Text="{Binding WirelessReceiverName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource RoundedTextBox}" MaxLength="63" MinHeight="40"/>
                                <Button Grid.Column="2" Content="{DynamicResource ApplyWirelessSettings}"
                                        Command="{Binding ApplyWirelessSettingsCommand}"
                                        Style="{StaticResource ToolButton}"/>
                            </Grid>
                            <TextBlock Text="{Binding WirelessStatus}" FontSize="{DynamicResource CaptionFontSize}" TextWrapping="Wrap" chrome:StatusAppearance.Tone="{Binding WirelessStatusTone}" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ControlSectionCard}"
                            Visibility="{Binding VideoSettingsVisibility}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource ImageAndSound}"
                                       Style="{StaticResource ControlSectionTitle}"/>
                            <StackPanel Visibility="{Binding WiredVideoLimitSettingsVisibility}">
                                <TextBlock Text="{DynamicResource RenderResolutionLimit}"
                                           Style="{StaticResource DetailLabel}"/>
                                <ComboBox AutomationProperties.Name="{DynamicResource RenderResolutionLimit}" ItemsSource="{Binding ResolutionPresets}" DisplayMemberPath="Label"
                                          IsEnabled="{Binding CanChangeVideoPipeline}"
                                          SelectedItem="{Binding SelectedResolutionPreset, Mode=TwoWay}"/>
                                <TextBlock Text="{DynamicResource TargetFrameRate}"
                                           Style="{StaticResource DetailLabel}"/>
                                <ComboBox AutomationProperties.Name="{DynamicResource TargetFrameRate}" ItemsSource="{Binding FrameRates}"
                                          IsEnabled="{Binding CanChangeVideoPipeline}"
                                          SelectedItem="{Binding SelectedFrameRate, Mode=TwoWay}"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource DecoderPreferenceLabel}"
                                       Style="{StaticResource DetailLabel}"/>
                            <ComboBox AutomationProperties.Name="{DynamicResource DecoderPreferenceLabel}" ItemsSource="{Binding DecoderPreferences}" DisplayMemberPath="Label"
                                      IsEnabled="{Binding CanChangeDecoderPipeline}"
                                      SelectedItem="{Binding SelectedDecoderPreference, Mode=TwoWay}"/>
                            <Grid Margin="0,11,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="{DynamicResource ApplyVideoSettings}"
                                        Command="{Binding ApplyVideoSettingsCommand}"
                                        Style="{StaticResource ToolButton}"/>
                                <Button Grid.Column="2" Content="{DynamicResource MoreImageSettingsButton}"
                                        Command="{Binding MoreImageSettingsCommand}"
                                        Style="{StaticResource ToolButton}"/>
                            </Grid>
                            <TextBlock Text="{Binding SettingsStatus}" FontSize="{DynamicResource CaptionFontSize}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,7,0,0"/>
                            <TextBlock Text="{Binding DecoderStatus}" FontSize="{DynamicResource CaptionFontSize}" TextWrapping="Wrap"
                                       Visibility="{Binding DecoderStatusVisibility}"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0"/>

                            <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="0,14,0,12"/>
                            <CheckBox Content="{DynamicResource PlayAudioWindows}"
                                      IsChecked="{Binding PlayAudio, Mode=TwoWay}"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource PlaybackVolume}"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding PlaybackVolume, StringFormat={}{0:F0}%}"/>
                            </Grid>
                            <Slider AutomationProperties.Name="{DynamicResource PlaybackVolume}" Minimum="0" Maximum="100"
                                    Value="{Binding PlaybackVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ControlSectionCard}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource MappingTitle}" Style="{StaticResource ControlSectionTitle}"/>
                            <TextBlock Text="{DynamicResource MappingDescription}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}"/>
                            <Button Content="{DynamicResource MappingManage}" Command="{Binding ManageKeyboardMappingCommand}"
                                    Style="{StaticResource ToolButton}" Margin="0,10,0,0"
                                    AutomationProperties.AutomationId="OpenKeyboardMappingButton"/>
                            <TextBlock Text="{Binding KeyboardMappingStatus}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}"/>
                            <TextBlock Text="{Binding KeyboardInputModeStatus}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}"/>
                        </StackPanel>
                    </Border>

                    <Border>
                        <Border.Style>
                            <Style TargetType="Border"
                                   BasedOn="{StaticResource ControlSectionCard}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCaptureSession}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMediaCasting}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource PreviewAndObs}"
                                       Style="{StaticResource ControlSectionTitle}"/>
                            <UniformGrid Columns="2" Margin="0,10,0,0">
                                <Button Content="{DynamicResource RefreshFrame}" Click="OnRefreshClick"
                                        Style="{StaticResource ToolButton}" Margin="0,0,4,4"/>
                                <Button Content="{DynamicResource FullScreenPreview}" Click="OnFullScreenClick"
                                        Style="{StaticResource ToolButton}" Margin="4,0,0,4"/>
                                <Button Content="{DynamicResource SeparateWindow}" Click="OnSeparateWindowClick"
                                        Style="{StaticResource ToolButton}" Margin="0,4,4,0"/>
                                <Button Content="{DynamicResource Screenshot}" Click="OnScreenshotClick"
                                        Style="{StaticResource ToolButton}" Margin="4,4,0,0"/>
                            </UniformGrid>
                            <Button Content="{DynamicResource MediaOutputButton}"
                                    Click="OnMediaOutputClick"
                                    Style="{StaticResource ToolButton}"
                                    HorizontalAlignment="Stretch"
                                    MinHeight="44" FontSize="{DynamicResource FontSize13}"
                                    Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</chrome:RoundedWindow>
