<chrome:RoundedWindow x:Class="IPhoneMirror.App.Windows.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource UpdateWindowTitle}" Width="782" Height="722"
        MinWidth="682" MinHeight="602" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False"
        AutomationProperties.AutomationId="UpdateWindow"
        xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Grid Style="{StaticResource SubWindowPageRoot}"
          animations:PageTransition.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*" MinHeight="{StaticResource DialogContentMinHeight}"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource SubWindowHeader}"
              animations:WindowDragBehavior.IsEnabled="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Text="{DynamicResource UpdateWindowTitle}"
                           Style="{StaticResource SubWindowTitle}"/>
                <TextBlock TextWrapping="Wrap" Text="{DynamicResource UpdateWindowSubtitle}"
                           Style="{StaticResource SubWindowSubtitle}"/>
            </StackPanel>
            <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="{DynamicResource AccentBrush}" CornerRadius="12" Padding="12,7">
                <TextBlock TextWrapping="Wrap" Text="{Binding LatestVersion}" Foreground="{DynamicResource OnAccentBrush}"
                           FontWeight="SemiBold"/>
            </Border>
            <Button Grid.Column="3" Style="{StaticResource SubWindowCloseButton}"
                    Click="OnLaterClick">
                <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/>
            </Button>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Text="{DynamicResource CurrentVersionLabel}"
                           Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}"/>
                <TextBlock TextWrapping="Wrap" Text="{Binding CurrentVersion}" FontSize="{DynamicResource FontSize16}" FontWeight="SemiBold"
                           Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock TextWrapping="Wrap" Text="{DynamicResource LatestVersionLabel}"
                           Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}"/>
                <TextBlock TextWrapping="Wrap" Text="{Binding LatestVersion}" FontSize="{DynamicResource FontSize16}" FontWeight="SemiBold"
                           Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock TextWrapping="Wrap" Text="{DynamicResource PublishedAtLabel}"
                           Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}"/>
                <TextBlock TextWrapping="Wrap" Text="{Binding PublishedAt}" FontSize="{DynamicResource FontSize16}" FontWeight="SemiBold"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="4" Style="{StaticResource SettingsSection}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ReleaseName}" FontSize="{DynamicResource FontSize18}"
                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <Button Grid.Column="1" Click="OnOpenReleaseClick"
                            ToolTip="{DynamicResource OpenReleasePage}" Margin="12,0,0,0">
                        <DockPanel LastChildFill="True"><ui:SymbolIcon DockPanel.Dock="Left" Style="{StaticResource ButtonSymbolIcon}" Symbol="Open20" Margin="0,0,6,0"/><TextBlock TextWrapping="Wrap" Text="{DynamicResource OpenReleasePage}"/></DockPanel>
                    </Button>
                </Grid>
                <FlowDocumentScrollViewer Grid.Row="2" x:Name="ReleaseNotesViewer"
                                           VerticalScrollBarVisibility="Auto"
                                           Background="Transparent" BorderThickness="0"
                                           IsToolBarVisible="False">
                    <FlowDocumentScrollViewer.Resources>
                        <Style TargetType="ScrollBar"
                               BasedOn="{StaticResource ContentEdgeScrollBarStyle}"/>
                    </FlowDocumentScrollViewer.Resources>
                </FlowDocumentScrollViewer>
            </Grid>
        </Border>
        <Grid Grid.Row="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Visibility="{Binding ProgressVisibility}">
                <ProgressBar Height="7" Minimum="0" Maximum="100"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             IsIndeterminate="{Binding IsIndeterminate}"/>
                <Grid Margin="0,8,0,0">
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
                    <TextBlock TextWrapping="Wrap" Text="{Binding SpeedText}" HorizontalAlignment="Right"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </Grid>
            </StackPanel>
            <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button Content="{DynamicResource RemindLater}" Click="OnLaterClick"
                        MinWidth="112" Margin="0,0,8,0"/>
                <Button x:Name="UpdateActionButton"
                        Content="{Binding UpdateButtonText}" Click="OnUpdateClick"
                        IsEnabled="{Binding CanUpdate}" Style="{StaticResource PrimaryButton}"
                        MinWidth="132"/>
            </WrapPanel>
        </Grid>
    </Grid>
</chrome:RoundedWindow>
