<ui:FluentWindow x:Class="IPhoneMirror.App.Windows.BluetoothControlNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="500" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None" WindowCornerPreference="Round"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False"
        ShowActivated="True" Topmost="True">
    <Border Style="{StaticResource ModernDialogSurface}" Margin="0"
            Effect="{x:Null}" CornerRadius="0" BorderThickness="0" Padding="20">
        <Grid animations:PageTransition.IsEnabled="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Style="{StaticResource SubWindowHeader}"
                  animations:WindowDragBehavior.IsEnabled="True">
                <TextBlock Text="{Binding TitleText}"
                           Style="{StaticResource SubWindowTitle}" Margin="0,0,48,0"/>
                <Button Style="{StaticResource SubWindowCloseButton}" Click="OnCloseClick">
                    <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}"
                                   Symbol="Dismiss20" FontSize="18"/>
                </Button>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource WarningSurfaceBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="15"
                            Background="{DynamicResource WarningBrush}"
                            VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="Cursor20" FontSize="17"
                                       Foreground="{DynamicResource OnAccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="{Binding BodyText}"
                                   FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding DetailText}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="12" Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                        <StackPanel x:Name="PairingStepsPanel"
                                    Visibility="{Binding WaitingStepsVisibility}"
                                    Margin="0,14,0,0">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource AccentBrush}">
                                    <TextBlock Text="1" Foreground="{DynamicResource OnAccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding PairStepOneText}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" Margin="7,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource ControlFillBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                    <TextBlock Text="2" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding PairStepTwoText}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" Margin="7,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource ControlFillBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                    <TextBlock Text="3" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding PairStepThreeText}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" Margin="7,0,0,0"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource ControlFillBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                    <TextBlock Text="4" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding PairStepFourText}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" Margin="7,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource ControlFillBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                    <TextBlock Text="5" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding PairStepFiveText}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" Margin="7,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center" ItemHeight="30">
                    <Border x:Name="ShortcutBadge"
                            Background="{DynamicResource ControlFillBrush}"
                            BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="1" CornerRadius="15"
                            Padding="10,5" Margin="0,0,6,0"
                            Visibility="{Binding ShortcutVisibility}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="KeyboardShift16"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding ShortcutText}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource ControlFillBrush}"
                            BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="1" CornerRadius="15"
                            Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowClockwise20"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{DynamicResource BluetoothControlReportMapChangedConfirm}"
                            Click="OnReportMapAcknowledgedClick" MinWidth="150" Height="36"
                            Margin="12,0,8,0" Style="{StaticResource PrimaryButton}"
                            Visibility="{Binding ReportMapAcknowledgementVisibility}"/>
                    <Button Content="{DynamicResource Close}"
                            Click="OnCloseClick" MinWidth="80" Height="36"
                            Background="{DynamicResource ControlFillBrush}"
                            BorderBrush="{DynamicResource BorderSoftBrush}"
                            Foreground="{DynamicResource TextBrush}"
                            BorderThickness="1"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</ui:FluentWindow>
