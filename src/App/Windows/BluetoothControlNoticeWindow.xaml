<chrome:RoundedWindow x:Class="IPhoneMirror.App.Windows.BluetoothControlNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False"
        ShowActivated="True" Topmost="True"
        xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border x:Name="WindowSurface" Padding="20" Style="{StaticResource RoundedWindowContent}">
        <Grid animations:PageTransition.IsEnabled="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*" MinHeight="{StaticResource DialogContentMinHeight}"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Style="{StaticResource SubWindowHeader}"
                  animations:WindowDragBehavior.IsEnabled="True">
                <TextBlock Text="{Binding TitleText}"
                           Style="{StaticResource SubWindowTitle}" Margin="0,0,48,0"/>
                <Button Style="{StaticResource SubWindowCloseButton}" Click="OnCloseClick">
                    <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}"
                                   Symbol="Dismiss20" FontSize="18"/>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Background="{DynamicResource WarningSurfaceBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="15"
                            Background="{DynamicResource WarningBrush}"
                            VerticalAlignment="Top">
                        <ui:SymbolIcon Symbol="Cursor20" FontSize="17"
                                       Foreground="{DynamicResource OnAccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="{Binding BodyText}"
                                   Style="{StaticResource BodyText}"/>
                        <TextBlock Text="{Binding DetailText}"
                                   Visibility="{Binding DetailVisibility}"
                                   Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
                        <StackPanel x:Name="PairingStepsPanel"
                                    Visibility="{Binding WaitingStepsVisibility}"
                                    Margin="0,14,0,0">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border MinWidth="20" MinHeight="20" Padding="5,2" VerticalAlignment="Top" CornerRadius="10" Background="{DynamicResource AccentBrush}">
                                    <TextBlock Text="1" Foreground="{DynamicResource OnAccentBrush}" FontSize="{DynamicResource CaptionFontSize}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding PairStepOneText}" TextWrapping="Wrap" FontSize="{DynamicResource SecondaryFontSize}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border MinWidth="20" MinHeight="20" Padding="5,2" VerticalAlignment="Top" CornerRadius="10" Background="{DynamicResource ControlFillBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                    <TextBlock Text="2" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding PairStepTwoText}" TextWrapping="Wrap" FontSize="{DynamicResource SecondaryFontSize}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border MinWidth="20" MinHeight="20" Padding="5,2" VerticalAlignment="Top" CornerRadius="10" Background="{DynamicResource ControlFillBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                    <TextBlock Text="3" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding PairStepThreeText}" TextWrapping="Wrap" FontSize="{DynamicResource SecondaryFontSize}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border MinWidth="20" MinHeight="20" Padding="5,2" VerticalAlignment="Top" CornerRadius="10" Background="{DynamicResource ControlFillBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                    <TextBlock Text="4" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding PairStepFourText}" TextWrapping="Wrap" FontSize="{DynamicResource SecondaryFontSize}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border MinWidth="20" MinHeight="20" Padding="5,2" VerticalAlignment="Top" CornerRadius="10" Background="{DynamicResource ControlFillBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                    <TextBlock Text="5" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding PairStepFiveText}" TextWrapping="Wrap" FontSize="{DynamicResource SecondaryFontSize}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            </ScrollViewer>
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center">
                    <Border x:Name="ShortcutBadge"
                            Background="{DynamicResource ControlFillBrush}"
                            BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="1" CornerRadius="15"
                            Padding="10,5" Margin="0,0,6,0"
                            Visibility="{Binding ShortcutVisibility}">
                        <DockPanel LastChildFill="True"><ui:SymbolIcon DockPanel.Dock="Left" Symbol="KeyboardShift16"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="14" Margin="0,0,5,0"/><TextBlock TextWrapping="Wrap" Text="{Binding ShortcutText}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="{DynamicResource CaptionFontSize}" VerticalAlignment="Center"/></DockPanel>
                    </Border>
                    <Border Background="{DynamicResource ControlFillBrush}"
                            BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="1" CornerRadius="15"
                            Padding="10,5">
                        <DockPanel LastChildFill="True"><ui:SymbolIcon DockPanel.Dock="Left" Symbol="ArrowClockwise20"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="14" Margin="0,0,5,0"/><TextBlock TextWrapping="Wrap" Text="{Binding StatusText}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="{DynamicResource CaptionFontSize}" VerticalAlignment="Center"/></DockPanel>
                    </Border>
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{Binding CloseButtonText}"
                            Click="OnCloseClick" MinWidth="80"
                            BorderThickness="1"/>
                    <Button Content="{DynamicResource BluetoothControlReportMapChangedConfirm}"
                            Click="OnReportMapAcknowledgedClick" MinWidth="150" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}"
                            Visibility="{Binding ReportMapAcknowledgementVisibility}"/>
                    <Button x:Name="PrerequisiteConfirmButton"
                            Content="{DynamicResource Continue}"
                            Click="OnPrerequisiteConfirmClick" MinWidth="100" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}"
                            Visibility="{Binding PrerequisiteActionsVisibility}"/>

                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</chrome:RoundedWindow>
