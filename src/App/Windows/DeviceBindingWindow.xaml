<chrome:RoundedWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls" x:Class="IPhoneMirror.App.Windows.DeviceBindingWindow" Title="{DynamicResource DeviceBindingTitle}" Width="1062" Height="800" MinWidth="850" MinHeight="620" WindowStartupLocation="CenterOwner" Foreground="{DynamicResource TextBrush}" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <chrome:RoundedWindow.Resources>
        <Style x:Key="BindingSectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="BindingNote" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource SecondaryFontSize}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="{DynamicResource BindingNoteLineHeight}"/>
        </Style>
        <Style x:Key="BindingRouteIcon" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="BindingSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SubWindowSectionTitle}"/>
        <Style x:Key="UnboundWiredSelector" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasWiredBinding}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="UnboundAirPlaySelector" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasAirPlayBinding}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BindingContextMenu" TargetType="ContextMenu" BasedOn="{StaticResource DeviceContextMenuStyle}"/>
        <Style x:Key="BindingMenuItem" TargetType="MenuItem" BasedOn="{StaticResource DeviceMenuItemStyle}"/>
        <ContextMenu x:Key="ProfileContextMenu" Style="{StaticResource BindingContextMenu}" Placement="MousePoint" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{DynamicResource DeviceBindingRenameProfile}" Style="{StaticResource BindingMenuItem}" Click="RenameProfileClick"/>
            <MenuItem Header="{DynamicResource DeviceBindingDeleteProfile}" Style="{StaticResource BindingMenuItem}" Click="DeleteProfileClick"/>
        </ContextMenu>
    </chrome:RoundedWindow.Resources>
    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}" Padding="{DynamicResource PagePadding}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Style="{StaticResource SubWindowPageRoot}" Margin="0" MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid animations:WindowDragBehavior.IsEnabled="True" animations:SurfaceMotion.Enabled="True">
            <StackPanel Margin="0,0,48,0">
                <TextBlock Text="iPhone Mirror  /  DEVICES" FontSize="{DynamicResource CaptionFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                <TextBlock Text="{DynamicResource DeviceBindingTitle}" Style="{StaticResource SubWindowTitle}" FontSize="{DynamicResource PageTitleFontSize}" FontWeight="SemiBold"/>
                <TextBlock Visibility="{DynamicResource InterfaceDescriptionsVisibility}" Text="{DynamicResource DeviceBindingWorkspaceHint}" Style="{StaticResource BindingNote}" Margin="0,8,0,0"/>
            </StackPanel>
            <Button Style="{StaticResource SubWindowCloseButton}" Click="CloseClick" AutomationProperties.Name="{DynamicResource Close}">
                <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/>
            </Button>
        </Grid>
        <Grid Grid.Row="2" MinHeight="440">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.34*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource ControlFillBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="18" Padding="14" animations:SurfaceMotion.Enabled="True" animations:SurfaceMotion.Delay="40">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="4,2,0,14">
                        <TextBlock Text="{DynamicResource DeviceBindingProfiles}" TextWrapping="Wrap" Margin="0,0,44,0" FontSize="{DynamicResource SectionTitleFontSize}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource IconButton}" Click="AddAirPlayProfileClick" IsEnabled="{Binding CanInteract}" HorizontalAlignment="Right" ToolTip="{DynamicResource DeviceBindingAddProfileToolTip}" AutomationProperties.Name="{DynamicResource DeviceBindingAddProfileToolTip}">
                            <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Add20" FontSize="18"/>
                        </Button>
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" IsEnabled="{Binding CanInteract}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="ContextMenu" Value="{StaticResource ProfileContextMenu}"/>
                                <Setter Property="Template"><Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Root" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="12" Padding="14">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBrush}"/></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource CardBrush}"/><Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value></Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate>
                            <StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ModelName}" Style="{StaticResource BindingNote}" Margin="0,5,0,0"/></StackPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="1" Text="{DynamicResource DeviceBindingEmptyList}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="8,20" HorizontalAlignment="Center">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasProfiles}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <StackPanel Grid.Row="2" Margin="4,16,4,4">
                        <TextBlock Visibility="{DynamicResource InterfaceDescriptionsVisibility}" Text="{DynamicResource DeviceBindingSidebarHint}" Style="{StaticResource BindingNote}" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding AirPlayReceiverText}" Style="{StaticResource BindingNote}" AutomationProperties.LiveSetting="Polite"/>
                        <Button Content="{DynamicResource SetupRetry}" Click="StartAirPlayClick" Padding="10,10" Margin="0,8,0,0">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CanRetryAirPlay}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Column="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel animations:SurfaceMotion.Enabled="True" animations:SurfaceMotion.Delay="80" animations:SurfaceMotion.RefreshKey="{Binding SelectedProfile.Id}">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasProfile}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock Text="{Binding ProfileTitle}" FontSize="{DynamicResource FontSize22}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Visibility="{DynamicResource InterfaceDescriptionsVisibility}" Text="{DynamicResource DeviceBindingProfileDescription}" Style="{StaticResource BindingNote}" Margin="0,6,0,20"/>
                        <Border Style="{StaticResource BindingSectionCard}">
                            <Grid IsEnabled="{Binding CanInteract}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource BindingRouteIcon}"><ui:SymbolIcon Symbol="UsbPlug20" FontSize="22" Foreground="{DynamicResource AccentBrush}"/></Border>
                                <StackPanel Grid.Column="2">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding WiredStatus}" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource SecondaryFontSize}" Margin="12,2,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{DynamicResource DeviceBindingWired}" FontSize="{DynamicResource FontSize16}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <TextBlock Text="{DynamicResource DeviceBindingWiredBrief}" Style="{StaticResource BindingNote}" Margin="0,8,0,0"/>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource ControlFillBrush}" CornerRadius="8" Padding="12,10" ToolTip="{Binding WiredIdentity}">
                                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasWiredBinding}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                            <TextBlock Text="{Binding WiredDisplayName}" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <ComboBox Style="{StaticResource UnboundWiredSelector}" ItemsSource="{Binding WiredDevices}" SelectedItem="{Binding SelectedWiredDevice, Mode=TwoWay}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanEditWired}" AutomationProperties.Name="{DynamicResource DeviceBindingWired}"/>
                                        <Button Grid.Column="1" Content="{DynamicResource DeviceBindingBind}" Click="BindWiredClick" IsEnabled="{Binding CanBindWired}" Padding="14,8" Margin="8,0,0,0">
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Style.Triggers><DataTrigger Binding="{Binding HasWiredBinding}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                        </Button>
                                        <Button Grid.Column="2" Content="{DynamicResource DeviceBindingUnbind}" Click="UnbindWiredClick" IsEnabled="{Binding HasWiredBinding}" Style="{StaticResource GhostButton}" Padding="12,8" Margin="8,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource BindingSectionCard}">
                            <Grid IsEnabled="{Binding CanInteract}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource BindingRouteIcon}"><ui:SymbolIcon Symbol="Wifi120" FontSize="22" Foreground="{DynamicResource AccentBrush}"/></Border>
                                <StackPanel Grid.Column="2">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding AirPlayStatus}" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource SecondaryFontSize}" Margin="12,2,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{DynamicResource DeviceBindingAirPlay}" FontSize="{DynamicResource FontSize16}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <TextBlock Text="{DynamicResource DeviceBindingAirPlayBrief}" Style="{StaticResource BindingNote}" Margin="0,8,0,0"/>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource ControlFillBrush}" CornerRadius="8" Padding="12,10" ToolTip="{Binding AirPlayIdentity}">
                                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasAirPlayBinding}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                            <TextBlock Text="{Binding AirPlayDisplayName}" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <ComboBox Style="{StaticResource UnboundAirPlaySelector}" ItemsSource="{Binding AirPlayDevices}" SelectedItem="{Binding SelectedAirPlayDevice, Mode=TwoWay}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanEditAirPlay}" AutomationProperties.Name="{DynamicResource DeviceBindingAirPlay}"/>
                                        <Button Grid.Column="1" Content="{DynamicResource DeviceBindingBind}" Click="BindAirPlayClick" IsEnabled="{Binding CanBindAirPlay}" Padding="14,8" Margin="8,0,0,0">
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Style.Triggers><DataTrigger Binding="{Binding HasAirPlayBinding}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                        </Button>
                                        <Button Grid.Column="2" Content="{DynamicResource DeviceBindingUnbind}" Click="UnbindAirPlayClick" IsEnabled="{Binding HasAirPlayBinding}" Style="{StaticResource GhostButton}" Padding="12,8" Margin="8,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource BindingSectionCard}">
                            <Grid IsEnabled="{Binding CanInteract}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource BindingRouteIcon}"><ui:SymbolIcon Symbol="Bluetooth20" FontSize="22" Foreground="{DynamicResource AccentBrush}"/></Border>
                                <StackPanel Grid.Column="2">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding BluetoothStatus}" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource SecondaryFontSize}" Margin="12,2,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{DynamicResource DeviceBindingBluetooth}" FontSize="{DynamicResource FontSize16}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <TextBlock Text="{DynamicResource DeviceBindingBluetoothBrief}" Style="{StaticResource BindingNote}" Margin="0,8,0,0"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="{DynamicResource DeviceBindingConnect}" Click="ConnectBluetoothClick" IsEnabled="{Binding CanConnectBluetooth}" Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="0,0,8,0"/>
                                        <Button Content="{DynamicResource DeviceBindingUnbind}" Click="UnbindBluetoothClick" IsEnabled="{Binding HasBluetoothBinding}" Style="{StaticResource GhostButton}" Padding="12,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Border VerticalAlignment="Stretch" Margin="0">
                    <Border.Style><Style TargetType="Border" BasedOn="{StaticResource BindingSectionCard}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasProfile}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480" Margin="24" animations:SurfaceMotion.Enabled="True">
                        <ui:SymbolIcon Symbol="Phone20" FontSize="48" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                        <TextBlock Text="{DynamicResource DeviceBindingEmptyTitle}" FontSize="{DynamicResource FontSize22}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Text="{DynamicResource DeviceBindingEmptyHint}" Style="{StaticResource BindingNote}" TextAlignment="Center" Margin="0,12,0,20"/>
                        <Button Content="{DynamicResource DeviceBindingAddProfileToolTip}" Click="AddAirPlayProfileClick" IsEnabled="{Binding CanInteract}" HorizontalAlignment="Center" Padding="18,10"/>
                    </StackPanel></ScrollViewer>
                </Border>
            </Grid>
        </Grid>
        <Grid Grid.Row="3" Margin="0,16,0,0" MinHeight="24">
            <ProgressBar Height="3" IsIndeterminate="True" VerticalAlignment="Top">
                <ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsWorking}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style>
            </ProgressBar>
            <TextBlock Text="{Binding ActivityText}" ToolTip="{Binding ActivityText}" MaxHeight="60" TextTrimming="CharacterEllipsis" Style="{StaticResource BindingNote}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
        </Grid>
    </Grid>
    </ScrollViewer>
</chrome:RoundedWindow>
