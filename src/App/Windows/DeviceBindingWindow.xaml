<chrome:RoundedWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls" x:Class="IPhoneMirror.App.Windows.DeviceBindingWindow" Title="{DynamicResource DeviceBindingTitle}" Width="1062" Height="742" MinWidth="922" MinHeight="622" WindowStartupLocation="CenterOwner" Foreground="{DynamicResource TextBrush}" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <chrome:RoundedWindow.Resources>
        <Style x:Key="BindingSectionCard" TargetType="Border" BasedOn="{StaticResource SettingsSection}"/>
        <Style x:Key="BindingSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SubWindowSectionTitle}"/>
        <Style x:Key="BoundIdentitySelector" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="IsEnabled" Value="False"/>
        </Style>
        <Style x:Key="BoundWiredSelector" TargetType="ComboBox" BasedOn="{StaticResource BoundIdentitySelector}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasWiredBinding}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="UnboundWiredSelector" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasWiredBinding}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BoundAirPlaySelector" TargetType="ComboBox" BasedOn="{StaticResource BoundIdentitySelector}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasAirPlayBinding}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="UnboundAirPlaySelector" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasAirPlayBinding}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BindingContextMenu" TargetType="ContextMenu" BasedOn="{StaticResource DeviceContextMenuStyle}"/>
        <Style x:Key="BindingMenuItem" TargetType="MenuItem" BasedOn="{StaticResource DeviceMenuItemStyle}"/>
        <ContextMenu x:Key="ProfileContextMenu" Style="{StaticResource BindingContextMenu}" Placement="MousePoint" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="{DynamicResource DeviceBindingRenameProfile}" Style="{StaticResource BindingMenuItem}" Click="RenameProfileClick"/>
            <MenuItem Header="{DynamicResource DeviceBindingDeleteProfile}" Style="{StaticResource BindingMenuItem}" Click="DeleteProfileClick"/>
        </ContextMenu>
    </chrome:RoundedWindow.Resources>
    <Grid Style="{StaticResource SubWindowPageRoot}" animations:PageTransition.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*" MinHeight="{StaticResource DialogContentMinHeight}"/>
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource SubWindowHeader}" animations:WindowDragBehavior.IsEnabled="True">
            <StackPanel Margin="0,0,48,0">
                <TextBlock TextWrapping="Wrap" Text="{DynamicResource DeviceBindingTitle}" Style="{StaticResource SubWindowTitle}"/>
                <TextBlock TextWrapping="Wrap" Text="{DynamicResource DeviceBindingSubtitle}" Style="{StaticResource SubWindowSubtitle}"/>
            </StackPanel>
            <Button Style="{StaticResource SubWindowCloseButton}" Click="CloseClick">
                <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/>
            </Button>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource ControlFillBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock TextWrapping="Wrap" Text="{DynamicResource DeviceBindingProfiles}" FontSize="{DynamicResource FontSize16}" FontWeight="SemiBold" Margin="4,2,44,12"/>
                        <Button Style="{StaticResource IconButton}" Click="AddAirPlayProfileClick" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="{DynamicResource DeviceBindingAddProfileToolTip}" AutomationProperties.Name="{DynamicResource DeviceBindingAddProfileToolTip}">
                            <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Add20" FontSize="18"/>
                        </Button>
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="ContextMenu" Value="{StaticResource ProfileContextMenu}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Root" Background="{DynamicResource ControlFillBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource ComboItemSelectedBrush}"/>
                                                    <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding ModelName}" FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource ControlFillBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="{Binding ProfileTitle}" FontSize="{DynamicResource FontSize21}" FontWeight="SemiBold"/>
                        <TextBlock TextWrapping="Wrap" Text="{DynamicResource DeviceBindingProfileDescription}" Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}" Margin="0,5,0,0"/>
                        <Grid Margin="0,16,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource BindingSectionCard}" Grid.Row="0" Grid.Column="0">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" Text="{DynamicResource DeviceBindingWired}" Style="{StaticResource BindingSectionTitle}"/>
                                    <TextBlock TextWrapping="Wrap" Text="{Binding WiredStatus}" Margin="0,7,0,0"/>
                                    <TextBlock Text="{Binding WiredIdentity}" TextWrapping="Wrap" FontFamily="{StaticResource CodeFontFamily}" FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"/>
                                    <TextBlock Text="{DynamicResource DeviceBindingWiredDescription}" TextWrapping="Wrap" FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,0"/>
                                    <ComboBox Style="{StaticResource BoundWiredSelector}" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="DisplayName" Margin="0,10,0,0"/>
                                    <ComboBox Style="{StaticResource UnboundWiredSelector}" ItemsSource="{Binding WiredDevices}" SelectedItem="{Binding SelectedWiredDevice, Mode=TwoWay}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanEditWired}" Margin="0,10,0,0"/>
                                    <WrapPanel Style="{StaticResource ControlActions}" Margin="-4,6,-4,-4">
                                        <Button Margin="{StaticResource DialogActionMargin}" Content="{DynamicResource DeviceBindingBind}" Click="BindWiredClick" IsEnabled="{Binding CanBindWired}" Padding="12,7"/>
                                        <Button Margin="{StaticResource DialogActionMargin}" Content="{DynamicResource DeviceBindingUnbind}" Click="UnbindWiredClick" Padding="12,7"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource BindingSectionCard}" Grid.Row="0" Grid.Column="2">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" Text="{DynamicResource DeviceBindingAirPlay}" Style="{StaticResource BindingSectionTitle}"/>
                                    <TextBlock TextWrapping="Wrap" Text="{Binding AirPlayStatus}" Margin="0,7,0,0"/>
                                    <TextBlock Text="{Binding AirPlayIdentity}" TextWrapping="Wrap" FontFamily="{StaticResource CodeFontFamily}" FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"/>
                                    <TextBlock Text="{DynamicResource DeviceBindingAirPlayDescription}" TextWrapping="Wrap" FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,0"/>
                                    <ComboBox Style="{StaticResource BoundAirPlaySelector}" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="DisplayName" Margin="0,10,0,0"/>
                                    <ComboBox Style="{StaticResource UnboundAirPlaySelector}" ItemsSource="{Binding AirPlayDevices}" SelectedItem="{Binding SelectedAirPlayDevice, Mode=TwoWay}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanEditAirPlay}" Margin="0,10,0,0"/>
                                    <WrapPanel Style="{StaticResource ControlActions}" Margin="-4,6,-4,-4">
                                        <Button Margin="{StaticResource DialogActionMargin}" Content="{DynamicResource DeviceBindingBind}" Click="BindAirPlayClick" IsEnabled="{Binding CanBindAirPlay}" Padding="12,7"/>
                                        <Button Margin="{StaticResource DialogActionMargin}" Content="{DynamicResource DeviceBindingUnbind}" Click="UnbindAirPlayClick" Padding="12,7"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource BindingSectionCard}" Grid.Row="2" Grid.ColumnSpan="3">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" Text="{DynamicResource DeviceBindingBluetooth}" Style="{StaticResource BindingSectionTitle}"/>
                                    <TextBlock TextWrapping="Wrap" Text="{Binding BluetoothStatus}" Margin="0,7,0,0"/>
                                    <TextBlock Text="{Binding BluetoothIdentity}" TextWrapping="Wrap" FontFamily="{StaticResource CodeFontFamily}" FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"/>
                                    <TextBlock Text="{DynamicResource DeviceBindingBluetoothDescription}" TextWrapping="Wrap" FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,0"/>
                                    <WrapPanel Style="{StaticResource ControlActions}" Margin="-4,8,-4,-4">
                                        <Button Margin="{StaticResource DialogActionMargin}" Content="{DynamicResource DeviceBindingConnect}" Click="ConnectBluetoothClick" Padding="12,7"/>
                                        <Button Margin="{StaticResource DialogActionMargin}" Content="{DynamicResource DeviceBindingUnbind}" Click="UnbindBluetoothClick" Padding="12,7"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</chrome:RoundedWindow>
