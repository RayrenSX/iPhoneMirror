<Window x:Class="IPhoneMirror.DriverInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource AppTitle}"
        Icon="pack://application:,,,/Assets/iPhoneMirror.ico"
        Width="1180" Height="760" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        Loaded="OnLoaded">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome x:Name="DriverWindowChrome" CaptionHeight="58" ResizeBorderThickness="7"
                            CornerRadius="20" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="DeviceItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="14,12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ComboBorderHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,18,24,20" animations:PageTransition.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="42" Height="42" CornerRadius="11"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Image Source="pack://application:,,,/Assets/iPhoneMirror.ico"
                           Width="32" Height="32"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource AppTitle}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource AppSubtitle}"
                               Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <ComboBox ItemsSource="{Binding ThemeChoices}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedValue="{Binding SelectedTheme}"
                          Width="154" Margin="0,0,10,0" ToolTip="{DynamicResource Appearance}"/>
                <Button Style="{StaticResource IconButton}"
                        Click="OnOpenLogsClick" IsEnabled="{Binding CanInteract}"
                        ToolTip="{DynamicResource OpenLogs}"
                        Visibility="{Binding AdvancedVisibility}" Margin="0,0,6,0">
                    <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Open20" FontSize="16"/>
                </Button>
                <Button Style="{StaticResource IconButton}"
                        Click="OnRefreshClick" IsEnabled="{Binding CanInteract}"
                        ToolTip="{DynamicResource Refresh}" Margin="0,0,10,0">
                    <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="ArrowClockwise20" FontSize="16"/>
                </Button>
                <Button Style="{StaticResource TitleBarButton}" Click="OnMinimizeClick"
                        AutomationProperties.Name="{DynamicResource Minimize}"
                        ToolTip="{DynamicResource Minimize}">
                    <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Subtract20" FontSize="16"/>
                </Button>
                <Button Style="{StaticResource TitleBarButton}" Click="OnMaximizeClick"
                        AutomationProperties.Name="{DynamicResource Maximize}"
                        ToolTip="{DynamicResource Maximize}">
                    <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Maximize20" FontSize="16"/>
                </Button>
                <Button Style="{StaticResource TitleBarCloseButton}" Click="OnCloseWindowClick"
                        AutomationProperties.Name="{DynamicResource Close}"
                        ToolTip="{DynamicResource Close}">
                    <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="17"/>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Section}" Padding="14">
            <Border.Visibility>
                <Binding Path="AdvancedVisibility"/>
            </Border.Visibility>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="2,0,18,0">
                    <TextBlock Text="{DynamicResource AppleUsbEnvironment}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Text="{Binding AppleStatusText}" Margin="0,5,0,0"
                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource BorderBrush}"/>
                <StackPanel Grid.Column="2" Margin="18,0">
                    <TextBlock Text="{DynamicResource CaptureFilterDriver}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Text="{Binding LibUsbStatusText}" Margin="0,5,0,0"
                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="3" Content="{DynamicResource InstallAppleDevices}"
                        Click="OnInstallAppleSupportClick"
                        IsEnabled="{Binding CanInstallAppleSupport}"
                        MinWidth="150" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.RowSpan="3" Style="{StaticResource Section}"
                Visibility="{Binding SimpleVisibility}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="620">
                <TextBlock Text="{DynamicResource PrepareTitle}" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{DynamicResource PrepareDescription}"
                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,10,0,18"/>
                <ComboBox ItemsSource="{Binding ConnectedDevices}"
                          SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                          DisplayMemberPath="SelectionText"
                          MinWidth="320" Height="38" Margin="0,0,0,12"
                          IsEnabled="{Binding CanInteract}"/>
                <Button Content="{DynamicResource InstallAll}" Style="{StaticResource PrimaryButton}"
                        Click="OnQuickInstallClick" IsEnabled="{Binding CanQuickInstall}"
                        Height="54" MinWidth="250" FontSize="16" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding SelectedDevice.DetailText}"
                           Foreground="{DynamicResource MutedTextBrush}" FontSize="10"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding OperationStatus}" Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,18,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4">
            <Grid.Visibility>
                <Binding Path="AdvancedVisibility"/>
            </Grid.Visibility>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Section}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource AppleDevices}" FontSize="15" FontWeight="SemiBold"/>
                    <ListBox Grid.Row="2" ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource DeviceItem}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ConnectionText}" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource MutedBrush}" FontSize="10"/>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding DriverText}" Margin="0,5,0,0"
                                               Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                                    <TextBlock Grid.Row="2" Text="{Binding DetailText}" Margin="0,5,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}" FontFamily="Consolas" FontSize="9"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Section}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource CurrentDevice}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="{Binding SelectedDevice.DisplayName}"
                                   FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource DeviceInstance}" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedDevice.InstanceId}"
                                   FontFamily="Consolas" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1" Text="{DynamicResource ConnectionStatus}" Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,11,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding SelectedDevice.ConnectionText}"
                                   Margin="0,11,0,0"/>
                        <TextBlock Grid.Row="2" Text="{DynamicResource DriverStatus}" Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,11,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding SelectedDevice.DriverText}"
                                   Margin="0,11,0,0"/>
                    </Grid>

                    <StackPanel Grid.Row="3" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding OperationStatus}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14"/>
                        <ProgressBar Height="4" IsIndeterminate="True"
                                     Visibility="{Binding BusyVisibility}"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource BorderSoftBrush}"/>
                    </StackPanel>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="{Binding InstallButtonText}" Style="{StaticResource PrimaryButton}"
                                Click="OnInstallClick" IsEnabled="{Binding CanInstallDriver}"/>
                        <Button Grid.Column="2" Content="{DynamicResource Repair}" Click="OnRepairClick"
                                IsEnabled="{Binding CanRepairDriver}"/>
                        <Button Grid.Column="4" Content="{DynamicResource Uninstall}" Style="{StaticResource DangerButton}"
                                Click="OnUninstallClick" IsEnabled="{Binding CanUninstallDriver}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="6">
            <TextBlock Text="{DynamicResource DriverChangeNotice}"
                       Foreground="{DynamicResource MutedBrush}" FontSize="10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding AdvancedButtonText}" Click="OnAdvancedClick"
                        MinHeight="28" Padding="12,4" FontSize="11"/>
                <TextBlock Text="libusb-win32 1.2.6.0" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="12,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
