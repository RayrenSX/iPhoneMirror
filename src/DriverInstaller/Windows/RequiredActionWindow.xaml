<chrome:RoundedWindow x:Class="IPhoneMirror.DriverInstaller.Windows.RequiredActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        Title="{DynamicResource RequiredActionTitle}" Width="520" Height="320" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False"
        xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Style="{StaticResource RoundedWindowContent}">
    <Grid animations:PageTransition.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource SubWindowHeader}"
              MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
            <TextBlock Text="{Binding ActionTitle}"
                       Style="{StaticResource SubWindowTitle}" Margin="0,0,48,0"/>
            <Button Style="{StaticResource SubWindowCloseButton}" Click="OnCancelClick">
                <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/>
            </Button>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource SettingsSection}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock Text="{Binding ActionBody}" Style="{StaticResource BodyText}"
                       VerticalAlignment="Center"/>
            </ScrollViewer>
        </Border>
        <WrapPanel Grid.Row="4" Style="{StaticResource DialogActions}">
            <Button Margin="{StaticResource DialogActionMargin}" Content="{DynamicResource Cancel}" Click="OnCancelClick" MinWidth="88"/>
            <Button Margin="{StaticResource DialogActionMargin}" Content="{Binding ConfirmText}" Style="{StaticResource PrimaryButton}"
                    Click="OnConfirmClick" MinWidth="132"/>
        </WrapPanel>
    </Grid>
    </Border>
</chrome:RoundedWindow>
