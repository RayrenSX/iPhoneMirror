<chrome:RoundedWindow x:Class="IPhoneMirror.DriverInstaller.Windows.DeviceTrustWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        Title="{DynamicResource DeviceTrustTitle}" Width="580" Height="470"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False"
        xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Style="{StaticResource RoundedWindowContent}">
        <Grid animations:PageTransition.IsEnabled="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="0"/>
                <RowDefinition Height="0"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Style="{StaticResource SubWindowHeader}"
                  MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <TextBlock Text="{DynamicResource DeviceTrustTitle}"
                           Style="{StaticResource SubWindowTitle}" Margin="0,0,48,0"/>
                <Button Style="{StaticResource SubWindowCloseButton}"
                        ToolTip="{DynamicResource Close}" Click="OnNotHandledClick">
                <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="2" Grid.RowSpan="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
            <Border Background="{DynamicResource WarningSurfaceBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource DeviceTrustAction}"
                               Foreground="{DynamicResource WarningBrush}"
                               FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource DeviceTrustExplanation}"
                               Style="{StaticResource BodyText}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Margin="0,14,0,0">
                <TextBlock Text="{DynamicResource DeviceTrustQuestion}" TextWrapping="Wrap"
                           FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <Button Content="{DynamicResource DeviceTrustConfirmed}"
                        Style="{StaticResource PrimaryButton}" MinHeight="48"
                        HorizontalContentAlignment="Center" Click="OnTrustedClick"/>
                <Button Content="{DynamicResource DeviceTrustNoPrompt}"
                        MinHeight="48" Margin="0,8,0,0"
                        HorizontalContentAlignment="Center" Click="OnNoPromptClick"/>
            </StackPanel>

            </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="6" Content="{DynamicResource DeviceTrustNotHandled}"
                    HorizontalAlignment="Right" MinWidth="132"
                    Style="{StaticResource SecondaryButton}" Click="OnNotHandledClick"/>
        </Grid>
    </Border>
</chrome:RoundedWindow>
