<chrome:RoundedWindow x:Class="IPhoneMirror.DriverInstaller.Windows.ParentDriverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
        Title="{DynamicResource ParentManagerTitle}" Width="640" Height="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{DynamicResource TextBrush}">
    <Border Style="{StaticResource RoundedWindowContent}">
        <Grid animations:PageTransition.IsEnabled="True">
            <Grid.Resources>
                <BooleanToVisibilityConverter x:Key="ShowIfTrue"/>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Style="{StaticResource SubWindowHeader}" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <TextBlock Text="{DynamicResource ParentManagerTitle}" Style="{StaticResource SubWindowTitle}" Margin="0,0,48,0"/>
                <Button Style="{StaticResource SubWindowCloseButton}" Click="OnCancelClick"
                        AutomationProperties.Name="{DynamicResource Cancel}">
                    <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/>
                </Button>
            </Grid>
            <ScrollViewer x:Name="DriverContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="0,15,0,4">
                <StackPanel>
                    <Border Background="{DynamicResource ControlFillBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="13,11">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Phone20" FontSize="22" Foreground="{DynamicResource AccentBrush}"
                                           Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="DeviceSummary" Text="{Binding Device.SelectionText}" ToolTip="{Binding Device.SelectionText}"
                                           Style="{StaticResource SubWindowSectionTitle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                <TextBlock Margin="0,4,0,0" Text="{Binding CurrentDriverText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Device.IsHealthy}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="{DynamicResource ParentDriverSelection}" Style="{StaticResource SubWindowSectionTitle}" Margin="0,17,0,8"/>
                    <ListBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedDriver, Mode=TwoWay}" MaxHeight="207"
                             Background="Transparent" BorderThickness="0"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="False"
                             Visibility="{Binding HasChoices, Converter={StaticResource ShowIfTrue}}"
                             AutomationProperties.Name="{DynamicResource ParentDriverSelection}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource SelectableListItem}">
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding Driver.DisplayText}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Driver.Description}" Style="{StaticResource BodyText}"
                                                   FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding PackageText}" Style="{StaticResource CaptionText}" Margin="0,3,0,0"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource ParentDriverRecommended}" Margin="10,0,0,0"
                                               Style="{StaticResource CaptionText}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                               MaxWidth="150" VerticalAlignment="Center"
                                               Visibility="{Binding IsRecommended, Converter={StaticResource ShowIfTrue}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding DriverListNotice}" Style="{StaticResource SecondaryText}" Foreground="{DynamicResource WarningBrush}"
                               Visibility="{Binding ShowDriverListNotice, Converter={StaticResource ShowIfTrue}}"/>
                    <StackPanel x:Name="TechnicalDetails" Visibility="Collapsed" Margin="0,3,0,0">
                        <TextBlock Text="{Binding Device.ParentStatusText}" Style="{StaticResource SecondaryText}"/>
                        <TextBlock Text="{Binding Device.InstanceId}" Style="{StaticResource CaptionText}" FontFamily="{StaticResource CodeFontFamily}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding Diagnostic}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"
                                   Visibility="{Binding HasDiagnostics, Converter={StaticResource ShowIfTrue}}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Button x:Name="DetailsButton" Grid.Row="2" Content="{DynamicResource ParentShowDetails}" Click="OnDetailsClick"
                    Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,0,0,4" Padding="12,5"/>
            <WrapPanel Grid.Row="3" Style="{StaticResource DialogActions}">
                <Button Margin="{StaticResource DialogActionMargin}" Content="{DynamicResource Cancel}" IsCancel="True" IsDefault="True" Click="OnCancelClick"/>
                <Button Margin="{StaticResource DialogActionMargin}" Content="{DynamicResource ParentReset}" Click="OnResetClick"
                        ToolTip="{DynamicResource ParentResetHelp}"/>
                <Button Margin="{StaticResource DialogActionMargin}" Content="{DynamicResource ParentBind}" Click="OnBindClick"
                        Style="{StaticResource PrimaryButton}" IsEnabled="{Binding HasChoices}"/>
            </WrapPanel>
        </Grid>
    </Border>
</chrome:RoundedWindow>
