<chrome:RoundedWindow x:Class="IPhoneMirror.DriverInstaller.Windows.ParentDriverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
        Title="{DynamicResource ParentManagerTitle}" Width="680" Height="580"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{DynamicResource TextBrush}">
    <Border Style="{StaticResource RoundedWindowContent}">
        <Grid animations:PageTransition.IsEnabled="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Style="{StaticResource SubWindowHeader}" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <TextBlock Text="{DynamicResource ParentManagerTitle}" Style="{StaticResource SubWindowTitle}" Margin="0,0,48,0"/>
                <Button Style="{StaticResource SubWindowCloseButton}" Click="OnCancelClick">
                    <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/>
                </Button>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding Device.SelectionText}" Style="{StaticResource SubWindowSectionTitle}"/>
                    <TextBlock Text="{Binding Device.InstanceId}" Style="{StaticResource CaptionText}" FontFamily="{StaticResource CodeFontFamily}" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding Device.ParentStatusText}" Style="{StaticResource BodyText}" Margin="0,8,0,0"/>
                    <TextBlock Text="{DynamicResource ParentManagerHelp}" Style="{StaticResource BodyText}" Margin="0,16,0,12"/>
                    <TextBlock Text="{DynamicResource ParentDriverSelection}" Style="{StaticResource SubWindowSectionTitle}"/>
                    <ListBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedDriver}" Height="150" Margin="0,8,0,0"
                             Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SelectableListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="{DynamicResource ParentDriverSelection}">
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding DisplayText}" FontSize="{DynamicResource BodyFontSize}" TextWrapping="Wrap"/></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding Diagnostic}" Style="{StaticResource SecondaryText}" Margin="0,12,0,0"/>
                    <TextBlock Text="{DynamicResource ParentResetHelp}" Style="{StaticResource BodyText}" Margin="0,12,0,0"/>
                </StackPanel>
            </ScrollViewer>
            <WrapPanel Grid.Row="2" Style="{StaticResource DialogActions}">
                <Button Margin="{StaticResource DialogActionMargin}" Content="{DynamicResource Cancel}" IsCancel="True" IsDefault="True" Click="OnCancelClick"/>
                <Button Margin="{StaticResource DialogActionMargin}" Content="{DynamicResource ParentReset}" Click="OnResetClick"/>
                <Button Margin="{StaticResource DialogActionMargin}" Content="{DynamicResource ParentBind}" Click="OnBindClick" Style="{StaticResource PrimaryButton}"/>
            </WrapPanel>
        </Grid>
    </Border>
</chrome:RoundedWindow>
