<chrome:RoundedWindow x:Class="IPhoneMirror.DriverInstaller.Windows.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        Title="{Binding PromptTitle}" Width="520" SizeToContent="Height"
        MaxHeight="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False"
        xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Padding="24" Style="{StaticResource RoundedWindowContent}">
        <Grid animations:PageTransition.IsEnabled="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid x:Name="NoticeHeader" Style="{StaticResource SubWindowHeader}"
                  MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="HeaderIcon">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource NoticeHeaderIcon}">
                            <Setter Property="Background" Value="{DynamicResource InfoSurfaceBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ErrorSurfaceBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ui:SymbolIcon FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="Info20"/>
                                <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                        <Setter Property="Symbol" Value="Warning20"/>
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Symbol" Value="ErrorCircle20"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                </Border>
                <TextBlock x:Name="HeaderTitle" Grid.Column="1" Text="{Binding PromptTitle}"
                           Style="{StaticResource NoticeHeaderTitle}"/>
                <Button x:Name="HeaderClose" Grid.Column="2" Style="{StaticResource NoticeHeaderCloseButton}" Click="OnCancelClick">
                    <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/>
                </Button>
            </Grid>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="280">
                <TextBlock Text="{Binding PromptBody}" Style="{StaticResource BodyText}"/>
            </ScrollViewer>
            <WrapPanel Grid.Row="4" Style="{StaticResource DialogActions}" Margin="-4,0,-4,-4">
                <Button Margin="{StaticResource DialogActionMargin}" Content="{Binding CancelText}" IsDefault="{Binding CancelIsDefault}" Click="OnCancelClick"
                        MinWidth="92"
                        Visibility="{Binding CancelVisibility}"/>
                <Button Margin="{StaticResource DialogActionMargin}" Content="{Binding ConfirmText}" IsDefault="{Binding ConfirmIsDefault}" Click="OnConfirmClick"
                        MinWidth="118" Style="{Binding ConfirmStyle}"/>
            </WrapPanel>
        </Grid>
    </Border>
</chrome:RoundedWindow>
