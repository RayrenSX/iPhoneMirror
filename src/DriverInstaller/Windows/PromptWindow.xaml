<Window x:Class="IPhoneMirror.DriverInstaller.Windows.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        Title="{Binding PromptTitle}" Width="520" SizeToContent="Height"
        MinHeight="260" MaxHeight="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
    <Border Style="{StaticResource ModernDialogSurface}" Margin="10">
        <Grid animations:PageTransition.IsEnabled="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Style="{StaticResource SubWindowHeader}"
                  MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <TextBlock Text="{Binding PromptTitle}"
                           Style="{StaticResource SubWindowTitle}" Margin="0,0,48,0"/>
                <Button Style="{StaticResource SubWindowCloseButton}" Click="OnCancelClick">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8BB;" FontSize="14"/>
                </Button>
            </Grid>
            <Border Grid.Row="2" Style="{StaticResource SettingsSection}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="280">
                    <TextBlock Text="{Binding PromptBody}" TextWrapping="Wrap"
                               FontSize="13" LineHeight="21"/>
                </ScrollViewer>
            </Border>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding CancelText}" Click="OnCancelClick"
                        MinWidth="92" Margin="0,0,8,0"
                        Visibility="{Binding CancelVisibility}"/>
                <Button Content="{Binding ConfirmText}" Click="OnConfirmClick"
                        MinWidth="118" Style="{Binding ConfirmStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
