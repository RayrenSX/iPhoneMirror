<chrome:RoundedWindow x:Class="IPhoneMirror.DriverInstaller.Windows.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        Title="{Binding PromptTitle}" Width="520" SizeToContent="Height"
        MinHeight="260" MaxHeight="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False"
        xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Style="{StaticResource RoundedWindowContent}">
        <Grid animations:PageTransition.IsEnabled="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Style="{StaticResource SubWindowHeader}"
                  MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <TextBlock Text="{Binding PromptTitle}"
                           Style="{StaticResource SubWindowTitle}" Margin="0,0,48,0"/>
                <Button Style="{StaticResource SubWindowCloseButton}" Click="OnCancelClick">
                    <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/>
                </Button>
            </Grid>
            <Border Grid.Row="2" Style="{StaticResource SettingsSection}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="280">
                    <TextBlock Text="{Binding PromptBody}" Style="{StaticResource BodyText}"/>
                </ScrollViewer>
            </Border>
            <WrapPanel Grid.Row="4" Style="{StaticResource DialogActions}">
                <Button Margin="{StaticResource DialogActionMargin}" Content="{Binding CancelText}" IsDefault="{Binding CancelIsDefault}" Click="OnCancelClick"
                        MinWidth="92"
                        Visibility="{Binding CancelVisibility}"/>
                <Button Margin="{StaticResource DialogActionMargin}" Content="{Binding ConfirmText}" IsDefault="{Binding ConfirmIsDefault}" Click="OnConfirmClick"
                        MinWidth="118" Style="{Binding ConfirmStyle}"/>
            </WrapPanel>
        </Grid>
    </Border>
</chrome:RoundedWindow>
