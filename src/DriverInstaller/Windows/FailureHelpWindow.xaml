<Window x:Class="IPhoneMirror.DriverInstaller.Windows.FailureHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        Title="{DynamicResource FailureTitle}" Width="620" Height="470"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
    <Border Style="{StaticResource ModernDialogSurface}" Margin="10">
    <Grid animations:PageTransition.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource SubWindowHeader}"
              MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
            <TextBlock Text="{DynamicResource FailureHeading}"
                       Style="{StaticResource SubWindowTitle}" Margin="0,0,48,0"/>
            <Button Style="{StaticResource SubWindowCloseButton}"
                    ToolTip="{DynamicResource Close}"
                    Click="OnCloseClick">
                <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/>
            </Button>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource ErrorSurfaceBrush}"
                BorderBrush="{DynamicResource ErrorBrush}"
                BorderThickness="1" CornerRadius="12" Padding="13">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}"
                       TextWrapping="Wrap" MaxHeight="90"/>
        </Border>
        <StackPanel Grid.Row="4">
            <TextBlock Text="{DynamicResource FailureMethods}" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <Border Style="{StaticResource SettingsSection}" Margin="0,0,0,8" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource HelpTitle}" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource HelpBody}"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{DynamicResource CopyGroup}" Click="OnCopyGroupClick"
                            MinWidth="104" Margin="12,0,0,0"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsSection}" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource AisiTitle}" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource AisiBody}"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{DynamicResource OpenWebsite}" Click="OnOpenAisiClick"
                            MinWidth="104" Margin="12,0,0,0"/>
                </Grid>
            </Border>
        </StackPanel>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource Close}" Click="OnCloseClick" MinWidth="88" Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Retry}" Style="{StaticResource PrimaryButton}"
                    Click="OnRetryClick" MinWidth="112"/>
        </StackPanel>
    </Grid>
    </Border>
</Window>
