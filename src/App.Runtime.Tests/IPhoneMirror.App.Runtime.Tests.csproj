<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>false</GenerateProgramFile>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AssemblyName>IPhoneMirror.App.Runtime.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\App\iPhoneMirror.App.csproj" />
    <Compile Include="..\App.Logic.Tests\ComponentDownloadNetworkTests.cs" Link="ComponentDownloadNetworkTests.cs" />
    <Compile Include="..\App.Logic.Tests\UxPlayComponentTests.cs" Link="UxPlayComponentTests.cs" />
    <EmbeddedResource Include="..\App\Localization\Strings.*.xaml" WithCulture="false"
                      LogicalName="TextSources.App.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\DriverInstaller\Localization\Strings.*.xaml" WithCulture="false"
                      LogicalName="TextSources.DriverInstaller.%(Filename)%(Extension)" />
    <Content Include="..\App\Assets\iPhoneMirror.ico" Link="Assets\iPhoneMirror.ico"
             CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="..\App\Assets\iPhoneMirror.png" Link="Assets\iPhoneMirror.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.8.2" />
    <PackageReference Include="MSTest.TestFramework" Version="3.8.2" />
  </ItemGroup>

  <Target Name="RunSmokeTests" BeforeTargets="VSTest" DependsOnTargets="Build">
    <Exec Command="dotnet run --no-restore --no-build --project &quot;$(MSBuildProjectFullPath)&quot; --configuration $(Configuration)" />
  </Target>
</Project>
