+/* IPHONE_MIRROR_AUDIO_PEER_AND_RESEND: keep UDP input within the
+ * negotiated control peer and drain both original and retransmitted packets. */
+static int raop_rtp_peer_matches(const raop_rtp_t *receiver,
+    const struct sockaddr_storage *peer) {
+    const struct sockaddr_storage *remote = &receiver->remote_saddr;
+    if (peer->ss_family != remote->ss_family) return 0;
+    if (peer->ss_family == AF_INET)
+        return ((const struct sockaddr_in *)peer)->sin_addr.s_addr ==
+            ((const struct sockaddr_in *)remote)->sin_addr.s_addr;
+    if (peer->ss_family == AF_INET6)
+        return memcmp(&((const struct sockaddr_in6 *)peer)->sin6_addr,
+            &((const struct sockaddr_in6 *)remote)->sin6_addr, 16) == 0;
+    return 0;
+}
+
+static void raop_rtp_drain_audio(raop_rtp_t *receiver) {
+    int no_resend = receiver->control_rport == 0;
+    int length;
+    unsigned int pts;
+    uint32_t rate;
+    uint16_t channels, bits;
+    const void *pcm;
+    while ((pcm = raop_buffer_dequeue(receiver->buffer, &length, &pts,
+        no_resend, &rate, &channels, &bits))) {
+        int running;
+        MUTEX_LOCK(receiver->run_mutex);
+        running = receiver->running;
+        MUTEX_UNLOCK(receiver->run_mutex);
+        if (!running) break;
+        if (length > 0 && rate > 0 && channels > 0 && bits > 0 &&
+            receiver->callbacks.audio_process) {
+            pcm_data_struct output;
+            output.data = pcm; output.data_len = length; output.pts = pts;
+            output.sample_rate = rate; output.channels = channels;
+            output.bits_per_sample = bits;
+            receiver->callbacks.audio_process(receiver->callbacks.cls, &output,
+                receiver->remoteName, receiver->remoteDeviceId);
+        }
+    }
+    if (!no_resend)
+        raop_buffer_handle_resends(receiver->buffer, raop_rtp_resend_callback, receiver);
+}
