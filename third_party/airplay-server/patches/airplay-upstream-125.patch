+int FgAirplayChannel::scaleH264Data(SFgVideoFrame* source) {
+    CAutoLock oLock(m_mutexVideo, "scaleH264Data");
+    if (!source || !source->data || !source->width || !source->height ||
+        source->width > 16384 || source->height > 16384) return AVERROR(EINVAL);
+    const uint64_t sourceChromaHeight = (source->height + 1) / 2;
+    if (source->pitch[0] < source->width ||
+        source->pitch[1] < (source->width + 1) / 2 ||
+        source->pitch[2] < (source->width + 1) / 2 ||
+        (uint64_t)source->pitch[0] * source->height > source->dataLen[0] ||
+        (uint64_t)source->pitch[1] * sourceChromaHeight > source->dataLen[1] ||
+        (uint64_t)source->pitch[2] * sourceChromaHeight > source->dataLen[2] ||
+        (uint64_t)source->dataLen[0] + source->dataLen[1] + source->dataLen[2] > source->dataTotalLen ||
+        source->dataTotalLen > 64 * 1024 * 1024) return AVERROR(EINVAL);
+    const double scaledWidth = source->width * (double)m_fScaleRatio;
+    const double scaledHeight = source->height * (double)m_fScaleRatio;
+    if (!std::isfinite(scaledWidth) || !std::isfinite(scaledHeight) ||
+        scaledWidth <= 0 || scaledHeight <= 0 ||
+        scaledWidth > 16384 || scaledHeight > 16384) return AVERROR(EINVAL);
+    const int width = scaledWidth < 1 ? 1 : (int)scaledWidth;
+    const int height = scaledHeight < 1 ? 1 : (int)scaledHeight;
+    const int yPitch = (width + 15) & ~15;
+    const int cPitch = ((width + 1) / 2 + 15) & ~15;
+    const int64_t yBytes = (int64_t)yPitch * height;
+    const int64_t cBytes = (int64_t)cPitch * ((height + 1) / 2);
+    const int64_t total = yBytes + 2 * cBytes;
+    if (total > 64 * 1024 * 1024) return AVERROR(EINVAL);
+    m_pSwsCtx = sws_getCachedContext(m_pSwsCtx, source->width, source->height,
+        AV_PIX_FMT_YUV420P, width, height, AV_PIX_FMT_YUV420P,
+        SWS_BILINEAR, NULL, NULL, NULL);
+    if (!m_pSwsCtx) return AVERROR(ENOMEM);
+    if (!m_sVideoFrameScale.data || m_sVideoFrameScale.dataTotalLen < total) {
+        uint8_t* replacement = new (std::nothrow) uint8_t[(size_t)total]();
+        if (!replacement) return AVERROR(ENOMEM);
+        delete[] m_sVideoFrameScale.data;
+        m_sVideoFrameScale.data = replacement;
+    }
+    m_sVideoFrameScale.width = width; m_sVideoFrameScale.height = height;
+    m_sVideoFrameScale.pts = source->pts; m_sVideoFrameScale.isKey = source->isKey;
+    m_sVideoFrameScale.pitch[0] = yPitch;
+    m_sVideoFrameScale.pitch[1] = m_sVideoFrameScale.pitch[2] = cPitch;
+    m_sVideoFrameScale.dataLen[0] = (unsigned int)yBytes;
+    m_sVideoFrameScale.dataLen[1] = m_sVideoFrameScale.dataLen[2] = (unsigned int)cBytes;
+    m_sVideoFrameScale.dataTotalLen = (unsigned int)total;
+    const uint8_t* input[3] = {source->data, source->data + source->dataLen[0],
+        source->data + source->dataLen[0] + source->dataLen[1]};
+    uint8_t* output[3] = {m_sVideoFrameScale.data,
+        m_sVideoFrameScale.data + m_sVideoFrameScale.dataLen[0],
+        m_sVideoFrameScale.data + m_sVideoFrameScale.dataLen[0] + m_sVideoFrameScale.dataLen[1]};
+    return sws_scale(m_pSwsCtx, input, (const int*)source->pitch, 0, source->height,
+        output, (const int*)m_sVideoFrameScale.pitch) == height ? 0 : AVERROR(EINVAL);
+}
